#!/usr/bin/env bash
# Compose launcher: route `claude` into the Vision sandbox WITHOUT devcontainers.
# The devcontainer-free equivalent of bin/claude — uses `docker compose` +
# .devcontainer/compose.yaml instead of `devcontainer up`/`exec`. bin/claude
# (devcontainer) stays as the fallback during the migration.
set -euo pipefail

find_project_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/.devcontainer/compose.yaml" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

if [[ -n "${VISION_PROJECT_ROOT:-}" && -f "${VISION_PROJECT_ROOT}/.devcontainer/compose.yaml" ]]; then
  PROJECT_ROOT="$VISION_PROJECT_ROOT"
else
  PROJECT_ROOT="$(find_project_root || true)"
fi
[[ -z "$PROJECT_ROOT" ]] && { echo "claude (vision-compose): no .devcontainer/compose.yaml above $PWD." >&2; exit 1; }

command -v docker >/dev/null 2>&1 || { echo "claude (vision-compose): docker not installed." >&2; exit 1; }
docker compose version >/dev/null 2>&1 || { echo "claude (vision-compose): docker compose v2 required." >&2; exit 1; }

COMPOSE=(docker compose -f "$PROJECT_ROOT/.devcontainer/compose.yaml")
SVC=app

# --- 1) Stage a sanitized ~/.claude for the read-only bind mount -------------
stage_claude_config() {
  local src dst item jf f
  src="$(cd "$HOME/.claude" 2>/dev/null && pwd -P || true)"
  dst="$HOME/.claude-vision-stage"
  rm -rf "$dst/dot-claude"; mkdir -p "$dst/dot-claude"
  if [[ -n "$src" && -d "$src" ]]; then
    for item in settings.json keybindings.json CLAUDE.md agents rules commands statusline status-line.sh plugins; do
      [[ -e "$src/$item" ]] && cp -a "$src/$item" "$dst/dot-claude/" 2>/dev/null || true
    done
    find "$dst/dot-claude/statusline" "$dst/dot-claude/plugins" -name .git -type d -prune -exec rm -rf {} + 2>/dev/null || true
    for jf in known_marketplaces.json installed_plugins.json; do
      f="$dst/dot-claude/plugins/$jf"
      [[ -f "$f" ]] && sed -i '' -e "s#$HOME/.claude#/home/dev/.claude#g" -e "s#$src#/home/dev/.claude#g" "$f" 2>/dev/null || true
    done
    find "$dst/dot-claude" -name '.DS_Store' -delete 2>/dev/null || true
  fi
  [[ -f "$HOME/.claude.json" ]] && cp "$HOME/.claude.json" "$dst/claude.json" 2>/dev/null || true
}
stage_claude_config

# --- 2) Build + start (idempotent) -------------------------------------------
"${COMPOSE[@]}" up -d --build >/dev/null
CID="$("${COMPOSE[@]}" ps -q "$SVC" 2>/dev/null | head -1 || true)"

# --- 3) Replay lifecycle as dev (post-create once, post-start every start) ----
"${COMPOSE[@]}" exec -u dev -T "$SVC" bash -lc '
  set -e
  cd /workspaces/Vision
  if [[ ! -f /home/dev/.postcreate-done ]]; then
    bash .devcontainer/post-create.sh && touch /home/dev/.postcreate-done
  fi
  bash .devcontainer/post-start.sh'

# --- 4) Forward the Claude OAuth token from the macOS Keychain at exec time ---
kc() { security find-generic-password -s "$1" -w 2>/dev/null || true; }
EXEC_ENV=()
if command -v security >/dev/null 2>&1; then
  tok="$(kc 'vision-claude-code-token')"
  [[ -n "$tok" ]] && EXEC_ENV+=(-e "CLAUDE_CODE_OAUTH_TOKEN=$tok")
fi
have_claude=0
for a in ${EXEC_ENV[@]+"${EXEC_ENV[@]}"}; do [[ "$a" == "CLAUDE_CODE_OAUTH_TOKEN="* ]] && have_claude=1; done
if (( ! have_claude )); then
  for var in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; do
    val="${!var:-}"; [[ -n "$val" ]] && EXEC_ENV+=(-e "${var}=${val}")
  done
fi

# --- 5) Auto config-sync: push container changes back on exit -----------------
AUTOSYNC="${VISION_AUTOSYNC:-1}"
_autosync_done=0
autosync_push() {
  if [[ "$_autosync_done" == 1 ]]; then return 0; fi
  _autosync_done=1
  if [[ "$AUTOSYNC" != 1 || -z "$CID" ]]; then return 0; fi
  command -v fish >/dev/null 2>&1 || return 0
  fish -c "vision-claude-sync push $CID" \
    || echo "claude (vision-compose): auto config-sync push failed — run 'vision-claude-sync push' to retry." >&2
}
trap autosync_push EXIT

set +e
"${COMPOSE[@]}" exec -u dev ${EXEC_ENV[@]+"${EXEC_ENV[@]}"} "$SVC" claude "$@"
_rc=$?
set -e
exit "$_rc"
