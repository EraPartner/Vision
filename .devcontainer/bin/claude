#!/usr/bin/env bash
# apple/container launcher: route `claude` into the Vision sandbox.
#
# Native `container build/run/exec` flow — Docker-free successor to the Compose
# launcher. Same hardened image, egress lock, mounts,
# in-container Postgres, lifecycle, credential forwarding.
#
# apple/container deltas: `--init` = compose init:true; `--tmpfs` bare path only;
# no `--security-opt` (setuid stripped + VM boundary). vision-claude AND
# vision-pgdata are NATIVE named volumes — root perms-fix can chown
# /var/lib/postgresql so Postgres initializes (a host bind mount cannot: #333).
set -euo pipefail

AGENT="${VISION_AGENT:-claude}"
case "$AGENT" in claude|codex) ;; *) echo "vision: unsupported agent '$AGENT'" >&2; exit 2 ;; esac

find_project_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/.devcontainer/Dockerfile" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
if [[ -n "${VISION_PROJECT_ROOT:-}" && -d "${VISION_PROJECT_ROOT}/.devcontainer" ]]; then
  PROJECT_ROOT="$VISION_PROJECT_ROOT"
else
  PROJECT_ROOT="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P || true)"
  [[ -d "$PROJECT_ROOT/.devcontainer" ]] || PROJECT_ROOT="$(find_project_root || true)"
fi
[[ -z "$PROJECT_ROOT" || ! -d "$PROJECT_ROOT/.devcontainer" ]] && {
  echo "claude (vision): cannot locate the Vision project root." >&2; exit 1; }
PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"
DC="$PROJECT_ROOT/.devcontainer"

command -v container >/dev/null 2>&1 || { echo "claude (vision): apple/container not installed." >&2; exit 1; }
container system status >/dev/null 2>&1 || { echo "claude (vision): container system not started — run: container system start" >&2; exit 1; }

if [[ "$AGENT" == claude ]]; then NAME=vision-dev; else NAME=vision-codex; fi
IMAGE=vision-dev:latest
SVC_USER=dev

# --- 1) Stage a sanitized ~/.claude for the read-only bind mount -------------
LIB="$DC/launcher-common.sh"
[[ -f "$LIB" ]] || { echo "claude (vision): missing $LIB (run LockBox/sync.sh)." >&2; exit 1; }
# shellcheck source=/dev/null
source "$LIB"
if [[ "$AGENT" == claude ]]; then sandbox_stage_claude_config vision; fi
# Lock host-executed git paths (.git + relocated core.hooksPath, e.g. .githooks)
# :ro over the RW workspace — an in-container agent must not plant a hook the HOST
# git runs on commit/push. Populates GIT_RO_MOUNTS; see launcher-common.sh.
sandbox_git_ro_mounts "$PROJECT_ROOT" /workspaces/Vision

# --- 2) Build (cached) -------------------------------------------------------
container build -t "$IMAGE" "$DC" >/dev/null
# Free the ~2GB build-shim RAM now the image is built; it auto-restarts on the next
# `container build`. Set SANDBOX_KEEP_BUILDER=1 to leave it up (rapid rebuilds).
[[ -n "${SANDBOX_KEEP_BUILDER:-}" ]] || container builder stop >/dev/null 2>&1 || true

# --- 2b) Container-local dependency trees ------------------------------------
# `node_modules/` and `./venv` hold PLATFORM-SPECIFIC artifacts: prebuilt native
# binaries (esbuild / rollup / lightningcss / tailwind-oxide `.node` files) and a
# venv whose bin/python is a symlink to the host's CPython. The workspace is
# bind-mounted read-write, so installing inside the container would overwrite the
# host's macOS trees with Linux ones — after which `bun run dev` / `bun run
# db:upgrade` on the HOST die until a full reinstall (and the next container boot
# undoes the repair). Shadow each tree with its own native named volume: the
# container gets private Linux trees at the SAME in-repo paths (so `node_modules/
# .bin`, `venv/bin/alembic` and $ALEMBIC_BIN below all stay correct inside), while
# the host's copies on disk are never touched by the container at all.
#
# Volumes are attached at CREATE time only and OUTLIVE `container rm`, so they
# persist across rebuilds — see "Dependency volumes" in .devcontainer/README.md
# for the reset commands. First boot mounts them EMPTY (apple/container does not
# seed a volume from the image) and post-create.sh populates them.
DEP_MOUNTS=()
dep_volume() { # <volume-name> <workspace-relative-dir>
  # Pre-create the mount target on the host so the runtime never has to
  # materialize a missing directory inside the bind mount. Empty node_modules
  # dirs are inert for host-side resolution (lookup just walks up) and gitignored.
  mkdir -p "$PROJECT_ROOT/$2" 2>/dev/null || true
  DEP_MOUNTS+=(-v "$1:/workspaces/Vision/$2")
}
dep_volume vision-venv        venv
dep_volume vision-nm-root     node_modules
dep_volume vision-nm-frontend apps/frontend/node_modules
dep_volume vision-nm-backend  apps/node-backend/node_modules
dep_volume vision-nm-shared   packages/shared-utils/node_modules
dep_volume vision-nm-types    packages/types/node_modules
dep_volume vision-nm-electron packaging/electron/node_modules

# --- 3) Idempotent run: reuse running / start stopped / else create ----------
if [[ "$AGENT" == claude ]]; then
  AGENT_MOUNTS=(
    -v vision-claude:/home/dev/.claude
    -v "$HOME/.claude-sandbox/stage/vision:/home/dev/.claude-stage:ro"
    -v "$HOME/.claude/hooks/guard.mjs:/usr/local/share/claude-guard/guard.mjs:ro"
    -v "$HOME/.claude/hooks/managed-settings.json:/etc/claude-code/managed-settings.json:ro"
    -v "$HOME/.claude/projects/-Users-computer-Code-Vision/memory:/home/dev/.claude-memory-seed:ro"
  )
else
  AGENT_MOUNTS=(-v vision-codex:/home/dev/.codex)
fi

if [[ "${VISION_REBUILD:-0}" == 1 ]]; then
  container rm -f "$NAME" >/dev/null 2>&1 || true
fi
if container ls -q 2>/dev/null | grep -qx "$NAME"; then
  :
elif container ls -aq 2>/dev/null | grep -qx "$NAME"; then
  container start "$NAME" >/dev/null
else
  container run -d --name "$NAME" \
    --init \
    --cap-drop ALL \
    --cap-add NET_ADMIN --cap-add CHOWN --cap-add DAC_OVERRIDE \
    --cap-add FOWNER --cap-add SETUID --cap-add SETGID \
    -m 4g -c 4 \
    --tmpfs /tmp --tmpfs /var/tmp \
    -p 127.0.0.1:8080:8080 -p 127.0.0.1:3002:3002 \
    -e DEVCONTAINER=true \
    -e SANDBOX_AGENT="$AGENT" \
    -e PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    -e DATABASE_URL=postgresql://ftm_user:localdev@127.0.0.1:5432/financial_transactions \
    -e DB_HOST=127.0.0.1 \
    -e DB_PORT=5432 \
    -e DB_USER=ftm_user \
    -e DB_NAME=financial_transactions \
    -e POSTGRES_PASSWORD=localdev \
    -e SERVER_HOST=0.0.0.0 \
    -e PORT=3002 \
    -e CORS_ORIGINS=http://localhost:8080,http://localhost:3002 \
    -e VITE_API_URL=http://localhost:3002 \
    -e ALEMBIC_BIN=/workspaces/Vision/venv/bin/alembic \
    -e DISABLE_TELEMETRY=1 \
    -e DISABLE_ERROR_REPORTING=1 \
    -e BASH_ENV=/home/dev/.safe-chain/scripts/init-posix.sh \
    -e NODE_USE_ENV_PROXY=1 \
    -e HTTP_PROXY=http://127.0.0.1:3128 \
    -e HTTPS_PROXY=http://127.0.0.1:3128 \
    -e http_proxy=http://127.0.0.1:3128 \
    -e https_proxy=http://127.0.0.1:3128 \
    -e NO_PROXY=localhost,127.0.0.1,::1 \
    -e no_proxy=localhost,127.0.0.1,::1 \
    -v "$PROJECT_ROOT:/workspaces/Vision" \
    ${DEP_MOUNTS[@]+"${DEP_MOUNTS[@]}"} \
    ${GIT_RO_MOUNTS[@]+"${GIT_RO_MOUNTS[@]}"} \
    -v "$DC:/workspaces/Vision/.devcontainer:ro" \
    ${AGENT_MOUNTS[@]+"${AGENT_MOUNTS[@]}"} \
    -v vision-pgdata:/var/lib/postgresql \
    "$IMAGE" >/dev/null
fi
CID="$NAME"

# Wait for the egress proxy (entrypoint: perms → firewall → Postgres → squid).
container exec "$NAME" bash -lc 'for i in $(seq 1 40); do (exec 3<>/dev/tcp/127.0.0.1/3128) 2>/dev/null && break; sleep 1; done' || true

# F14: the egress allowlist is baked into the image; on the reuse/start paths the
# running container can be enforcing a stale baked copy after a sync.sh change.
sandbox_warn_stale_allowlist "$NAME" "$DC/allowlist.txt" "VISION_REBUILD=1 $0"

# --- 4) Replay lifecycle as dev (post-create once, post-start every start) ----
container exec --user "$SVC_USER" "$NAME" bash -lc '
  set -e
  cd /workspaces/Vision
  if [[ ! -f /home/dev/.postcreate-done ]]; then
    bash .devcontainer/post-create.sh && touch /home/dev/.postcreate-done
  fi
  bash .devcontainer/post-start.sh'

# --- 5) Forward the Claude OAuth token from the macOS Keychain at exec time ---
EXEC_ENV=()
if [[ "$AGENT" == claude ]]; then sandbox_forward_llm_creds vision-claude-code-token; fi

# --- 6) Launch-integrity gate (mandatory; fail closed) -----------------------
# A missing checker is NOT a soft warning: the current Dockerfile always bakes
# vision-verify-pins, so its absence means a stale pre-pin image is running
# UNVERIFIED. Hard-abort and tell the operator to rebuild (matches bin/dev).
if ! container exec --user "$SVC_USER" "$NAME" bash -lc 'command -v vision-verify-pins >/dev/null 2>&1'; then
  echo "claude (vision): ABORT — vision-verify-pins is not baked into this image (stale pre-pin image)." >&2
  echo "  The launch-integrity gate is mandatory; rebuild to bake it in: VISION_REBUILD=1 $0" >&2
  exit 1
fi
if ! container exec --user "$SVC_USER" -e BASH_ENV= "$NAME" vision-verify-pins --quiet; then
  echo "claude (vision): ABORT — binary fingerprint drift (see above)." >&2
  echo "  If you intentionally upgraded a tool, rebuild to re-pin: VISION_REBUILD=1 $0" >&2
  exit 1
fi

# --- 7) On-exit hooks: config-sync push (OPT-IN) + power-down ------------------
# Pushing container config back to the host is a code-exec persistence channel (a
# prompt-injected agent could push hooks/plugins the host Claude later runs). The
# push path is sanitized AND this is opt-in: enable per session with VISION_AUTOSYNC=1.
# Power-down: stop the VM when your session ends so it stops pinning its 4 GB — a
# container you start cleans up after itself. Set VISION_STOP_ON_EXIT=0 to keep it
# WARM for instant reuse across sessions.
if [[ "$AGENT" == claude ]]; then AUTOSYNC="${VISION_AUTOSYNC:-0}"; else AUTOSYNC=0; fi
sandbox_install_autosync_trap vision "$CID" "$AUTOSYNC" "${VISION_STOP_ON_EXIT:-1}"

# --- 8) Open an interactive claude session -----------------------------------
TTY_FLAGS=()
[[ -t 0 && -t 1 ]] && TTY_FLAGS=(-i -t)
if [[ "$AGENT" == codex ]] && ! container exec --user "$SVC_USER" "$NAME" codex login status >/dev/null 2>&1; then
  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    container exec -i --user "$SVC_USER" -e OPENAI_API_KEY "$NAME" bash -c 'printenv OPENAI_API_KEY | codex login --with-api-key'
  elif [[ -n "${CODEX_ACCESS_TOKEN:-}" ]]; then
    container exec -i --user "$SVC_USER" -e CODEX_ACCESS_TOKEN "$NAME" bash -c 'printenv CODEX_ACCESS_TOKEN | codex login --with-access-token'
  elif (( ${#TTY_FLAGS[@]} > 0 )); then
    echo "codex (vision): no cached login; starting ChatGPT device-code login." >&2
    container exec -i -t --user "$SVC_USER" "$NAME" codex login --device-auth
  else
    echo "codex (vision): no cached login. Run interactively once, or set OPENAI_API_KEY/CODEX_ACCESS_TOKEN." >&2
    exit 1
  fi
fi
set +e
container exec --user "$SVC_USER" ${TTY_FLAGS[@]+"${TTY_FLAGS[@]}"} ${EXEC_ENV[@]+"${EXEC_ENV[@]}"} "$NAME" "$AGENT" "$@"
_rc=$?

# --- 9) Push project memory back to the host (interactive sessions only) ------
# Host memory is mounted RO and mirrored (--delete) into the container every start
# (post-start.sh), so a headless / prompt-injected run's memory writes are wiped.
# Only an interactive operator session's edits — layered on the clean host seed —
# are pushed back (additive tar, mirroring Brain's bin/agent). (F10/F27)
if [[ "$AGENT" == claude && ${#TTY_FLAGS[@]} -gt 0 ]]; then
  host_mem="$HOME/.claude/projects/-Users-computer-Code-Vision/memory"
  if mkdir -p "$host_mem" 2>/dev/null; then
    if container exec --user "$SVC_USER" "$NAME" \
         bash -lc 'd=/home/dev/.claude/projects/-workspaces-Vision/memory; [[ -d "$d" ]] && cd "$d" && tar -cf - . 2>/dev/null' 2>/dev/null \
       | tar -C "$host_mem" -xf - 2>/dev/null; then
      echo "claude (vision): project memory synced back to the host (interactive session)." >&2
    fi
  fi
fi
set -e
exit "$_rc"
