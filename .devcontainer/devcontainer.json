{
  "name": "Vision Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "init": true,
  "overrideCommand": false,
  "containerUser": "root",
  "remoteUser": "dev",
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=CHOWN",
    "--cap-add=DAC_OVERRIDE",
    "--cap-add=FOWNER",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=SETPCAP",
    "--security-opt=no-new-privileges",
    "--memory=4g",
    "--cpus=4",
    "--pids-limit=4096",
    "--tmpfs=/tmp:rw,noexec,nosuid,nodev,size=512m",
    "--tmpfs=/var/tmp:rw,noexec,nosuid,nodev,size=256m",
    "--publish=127.0.0.1:8080:8080",
    "--publish=127.0.0.1:3002:3002"
  ],
  "mounts": [
    // SECURITY: re-mount .devcontainer READ-ONLY on top of the read-write
    // workspace bind. The repo is mounted rw at /workspaces/Vision so the agent
    // can edit source, but that also exposes the sandbox's OWN definition (this
    // file's runArgs, Dockerfile) and the HOST-side launcher (bin/claude,
    // bin/doctor). Without this overlay an in-container agent could rewrite
    // runArgs (--privileged, -v /:/host, docker.sock) or the launcher, and the
    // next host `claude` / `devcontainer up` would run it on the Mac with
    // Keychain access -> trivial escape. The container can't undo this (no
    // CAP_SYS_ADMIN, no-new-privileges, .devcontainer is a busy mountpoint), so
    // edit .devcontainer on the HOST only, then rebuild.
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
    "source=vision-claude-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=${localEnv:HOME}/.claude-vision-stage,target=/home/dev/.claude-stage,type=bind,readonly",
    "source=vision-pgdata-${devcontainerId},target=/var/lib/postgresql,type=volume",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig-host,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/github.pub,target=/home/dev/.ssh/host-signing.pub,type=bind,readonly",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "DEVCONTAINER": "true",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "DATABASE_URL": "postgresql://ftm_user:localdev@127.0.0.1:5432/financial_transactions",
    "DB_HOST": "127.0.0.1",
    "DB_PORT": "5432",
    "DB_USER": "ftm_user",
    "DB_NAME": "financial_transactions",
    "POSTGRES_PASSWORD": "localdev",
    "SERVER_HOST": "0.0.0.0",
    "PORT": "3002",
    "CORS_ORIGINS": "http://localhost:8080,http://localhost:3002",
    "VITE_API_URL": "http://localhost:3002",
    "ALEMBIC_BIN": "/workspaces/Vision/venv/bin/alembic",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "BASH_ENV": "/home/dev/.safe-chain/scripts/init-posix.sh",
    "NODE_USE_ENV_PROXY": "1",
    "HTTP_PROXY": "http://127.0.0.1:3128",
    "HTTPS_PROXY": "http://127.0.0.1:3128",
    "http_proxy": "http://127.0.0.1:3128",
    "https_proxy": "http://127.0.0.1:3128",
    "NO_PROXY": "localhost,127.0.0.1,::1",
    "no_proxy": "localhost,127.0.0.1,::1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
