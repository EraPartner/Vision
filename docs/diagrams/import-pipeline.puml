@startuml import-pipeline
title CSV import: stage, review when needed, then commit

!theme plain
skinparam activityBackgroundColor #F5F7FA
skinparam activityBorderColor #49586A
skinparam activityDiamondBackgroundColor #E8EDF4

start
:Upload CSV and select bank or custom mapping;

partition "importPipeline: prepare" {
  :createBatch()\nRecord source file and adapter;
  :stageBatch()\nParse with bank or generic adapter,\nstore import_staging_rows;
  :validateBatch()\nValidate required fields, assign source hash\nand versioned occurrence fingerprint;
  note right
    Invalid rows retain error details.
    Repeated equal rows have distinct occurrences.
  end note
  :matchBatch()\nPatterns, then exact/fuzzy, then recipient upsert,\nrecord match source and similarity;
  if (Any pattern, fuzzy, new\nor unresolved recipient?) then (yes)
    :Set batch to awaiting_review;
  else (no)
    :Continue directly to commit;
  endif
}

if (Batch awaiting_review?) then (yes)
  partition "ImportReviewPage: user decision" {
    :Inspect grouped rows and match provenance;
    :POST row recipient or category override\nwhen a correction is needed;
    :POST /api/import/batches/:id/commit;
  }
else (no)
endif

partition "commitImport() / commitBatch()" {
  :Apply overrides and mark unresolved rows as errors;
  :Resolve canonical account IDs;
  :Commit at most 1,000 rows per transaction,\ncheck fingerprints and legacy field counts,\nwrite canonical transactions and provenance;
  note right
    Row savepoints isolate insert errors.
    Fingerprint uniqueness handles import races.
    Staging outcomes retain committed,
    duplicate and error rows for audit.
    Earlier committed chunks survive a later failure.
  end note
  :Checkpoint imported / duplicate / error counts;
  :autoLinkTransactions()\nMatch durable rows to planned payments;
  :Mark batch complete, reconcileTransfers()\nFind transfer pairs across the full ledger;
  :Invalidate forecast cache when rows were imported,\nscheduleMaterializedViewRefresh();
}

:Return import summary,\nderived views refresh asynchronously;
stop

legend bottom
  Sources: routes/importRoutes.js; services/importPipeline/index.js;
  stage.js; validate.js; match.js; commit.js; services/importIdentity.js.
  Recipient/category corrections use POST row override endpoints.
endlegend

@enduml
