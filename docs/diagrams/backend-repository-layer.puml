@startuml Repository Layer Architecture
title Repository Layer Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

package "Database" {
  class "db.ts (Kysely builder, ADR-226)" as DB {
    +db: Kysely<DB>
    +checkedRows(schema, builder): Promise
    +checkedRow(schema, builder): Promise
    +compileQuery(builder): CompiledQuery
  }
  class "connection.ts" as Conn {
    +query(sql, params): Promise
    +withTransaction(fn): Promise
    +checkConnection(): Promise<boolean>
    +closePool(): Promise
  }
  DB --> Conn : compiled SQL through query()
}

package "Repositories" {
  class TransactionRepository {
    +getAll(opts): Promise<Transaction[]>
    +getCount(opts): Promise<number>
    +getAllWithCount(opts): Promise<{rows, total}>
    +getUncategorised(opts): Promise<Transaction[]>
    +getById(id): Promise<Transaction | null>
    +create(data): Promise<Transaction>
    +update(id, fields): Promise<Transaction>
    +hardDelete(id): Promise<boolean>
  }

  class RecipientRepository {
    +getAll(opts): Promise<Recipient[]>
    +getCount(opts): Promise<number>
    +getById(id): Promise<Recipient | null>
    +getByName(name): Promise<Recipient | null>
    +createOrGet(data): Promise<{recipient, created}>
    +update(id, fields): Promise<Recipient>
    +hardDelete(id): Promise<boolean>
    +flagAliasesOf(primaryId, aliasIds): Promise<number[]>
    +repointGrandchildAliases(primaryId, aliasIds): Promise<number>
    +unmergeRecipient(id): Promise<boolean>
    +getAliases(primaryId): Promise<Recipient[]>
  }

  class CategoryRepository {
    +getAll(opts): Promise<Category[]>
    +getCount(opts): Promise<number>
    +getById(id): Promise<Category | null>
    +getByGeneralDetail(general, detail): Promise<Category | null>
    +createOrGet(data): Promise<{category, created}>
    +update(id, fields): Promise<Category>
    +hardDelete(id): Promise<boolean>
    +assignToRecipients(categoryId, recipientIds): Promise<number>
  }

  class CategoryHierarchyRepository {
    +listCategoryNodes(): Promise<CategoryNode[]>
    +getCategoryNode(id): Promise<CategoryNode | null>
    +createCategoryNode(input): Promise<CategoryNode>
    +updateCategoryNode(id, input): Promise<CategoryNode | null>
    +mergeCategoryNodes(sourceId, targetId): Promise<CategoryNode | null>
    +deleteCategoryNode(id): Promise<boolean>
  }

  class PlannedTransactionRepository {
    +getAll(opts): Promise<{items, total}>
    +getById(id): Promise<PlannedTransaction | null>
    +hardDelete(id): Promise<boolean>
    +addExecution(plannedTransactionId, txId, date): Promise<void>
    +insertPlannedTransactionInTransaction(client, data): Promise<number>
    +applyPlannedFieldUpdate(client, id, fields): Promise<boolean>
    +setPlannedTransactionTags(client, id, tags): Promise<void>
    +replaceLoanScheduleInTransaction(client, id, schedule): Promise<void>
    +insertExecutionInTransaction(client, plannedId, txId, date): Promise<boolean>
    +inheritTransactionTagsInTransaction(client, txId, tags): Promise<void>
  }

  class RecipientBankAccountRepository {
    +getById(id): Promise<RecipientBankAccount | null>
    +getByRecipientId(recipientId): Promise<RecipientBankAccount[]>
    +getByAccountNumber(accountNumber): Promise<RecipientBankAccount | null>
    +getPrimaryAccount(recipientId): Promise<RecipientBankAccount | null>
    +createOrGet(data): Promise<RecipientBankAccount>
    +update(id, fields): Promise<RecipientBankAccount>
    +setPrimary(id): Promise<RecipientBankAccount>
    +softDelete(id): Promise<boolean>
  }

  class InvestmentRepository {
    +getAll(opts): Promise<Investment[]>
    +getCount(opts): Promise<number>
    +getById(id): Promise<Investment | null>
    +create(data): Promise<Investment>
    +update(id, fields): Promise<Investment>
    +hardDelete(id): Promise<boolean>
  }

  class PortfolioTransactionRepository {
    +getAll(opts): Promise<PortfolioTransaction[]>
    +getById(id): Promise<PortfolioTransaction | null>
    +getAllByInvestmentIds(opts): Promise<PortfolioTransaction[]>
    +insert(data): Promise<PortfolioTransaction>
    +updateFields(id, fields): Promise<PortfolioTransaction>
    +hardDelete(id): Promise<boolean>
    note bottom: Kysely-built, bound parameters only;\ntransaction policy lives in services/portfolio/.
  }

  class PortfolioImportReconciliationRepository <<ADR-177>> {
    +readReconciliationSources(batchIds)
    +readReconciliationHistory(investmentIds)
    +lockReconciliationAccountsAndHistory(accountIds)
    +compareAndSetReconciledTransaction(id, before, after)
    +insertReconciliationReceipt(receipt)
    +getActiveAdoptionReceipts(batchId)
  }

  class PortfolioImportCashRepository <<ADR-189>> {
    +readKinesisCashContext()
    +lockKinesisCashLedger()
    +insertKinesisCash(component)
    +readCashImagesForUpdate(ids)
  }
  class PortfolioIncomeRecognitionRepository <<ADR-188>> {
    +readKinesisIncomeUnitContext(history)
    +readIncomeRecognitionContext(history)
    +recordPairedPortfolioIncome(pair)
    +restorePairedPortfolioIncomeForBatch(batchId)
    +readPairedIncomeRollbackBatchIds(batchId)
  }
  class PortfolioImportDuplicateRepairRepository <<ADR-177>> {
    +readDuplicateRepairContext(history)
    +readFullRepairTransaction(id)
    +replaceRepairStaging(before, after)
    +replaceRepairBatch(before, after)
    +deleteExactImportedCopy(snapshot)
    +restoreExactImportedCopy(snapshot)
    +insertDuplicateRepairReceipt(receipt)
  }

  class PortfolioAssetTransferRepository <<ADR-177>> {
    +findAssetTransferFingerprint(fingerprint, version)
    +insertAssetTransfer(event)
    +getAssetTransfersForBatch(batchId)
    +deleteAssetTransfersForBatch(batchId)
  }

  class PortfolioAssetAdjustmentRepository <<ADR-177>> {
    +getEligibleYieldSources(investmentId, accountId)
    +retainAssetAdjustmentSources(adjustmentId, sources)
    +findAssetAdjustmentFingerprint(fingerprint, version)
    +insertAssetAdjustment(event)
    +deleteAssetAdjustmentsForBatch(batchId)
  }


  class WatchlistRepository {
    +getAll(opts): Promise<Watchlist[]>
    +getById(id): Promise<Watchlist | null>
    +create(data): Promise<Watchlist>
    +update(id, fields): Promise<Watchlist>
    +delete(id): Promise<boolean>
  }

  class SplitRepository {
    +getTransactionSplitTotals(transactionId): Promise<{ transaction_total, current_split_total } | null>
    +getSplitsByTransaction(transactionId): Promise<Split[]>
    +getOwedSummaryRows(): Promise<Row[]>
    +getOwedByRecipientRows(recipientId): Promise<Row[]>
    +getOwedExportRowsByRecipient(recipientId): Promise<OwedExportRow[]>
    +getPayments(splitId): Promise<Payment[]>
    +settleSplit(splitId): Promise<Split>
    +settleAllByRecipient(recipientId): Promise<{ settled_count: number }>
    +deleteSplit(splitId): Promise<boolean>
    +insertSplitInTransaction(client, input): Promise<Split>
    +insertPaymentInTransaction(client, input): Promise<Payment>
    +writeAudit(input): Promise<AuditRow>
  }

  class AuditChainRepository <<ADR-156>> {
    +appendAuditEvent(payload, client?): Promise<Entry>
    +readAuditSegment(options?): Promise<Entry[]>
    +readAuditHead(): Promise<Head>
    +recordAuditCheckpoint(receipt): Promise<Checkpoint>
  }

  class SettingsRepository {
    +get(key): Promise<any>
    +setMany(settings): Promise<void>
    +replaceMany(settings): Promise<void>
    +getAll(): Promise<object>
    +delete(key): Promise<boolean>
  }

  class SavedChartsRepository {
    +getAll(): Promise<SavedChart[]>
    +getById(id): Promise<SavedChart | null>
    +create(data): Promise<SavedChart>
    +update(id, fields): Promise<SavedChart>
    +delete(id): Promise<boolean>
  }

  class InfoRepository {
    +getStatistics(): Promise<Statistics>
    +getBanks(): Promise<Bank[]>
    +getTransactionSummary(): Promise<TransactionSummary>
    +getMonthlySummary(): Promise<MonthlySummary>
    +getCategoryBreakdown(): Promise<CategoryBreakdown>
    +getBankBalances(): Promise<BankBalance[]>
    +getNetWorth(): Promise<NetWorth>
    +getRecipientInsights(): Promise<RecipientInsight[]>
    +getExchangeRates(): Promise<ExchangeRate[]>
    note bottom: Composite (Phase 3.1) — split into\n11 sub-modules: Statistics, Monthly,\nAverageVsCurrent, Banks, NetWorth, Planned,\nRecipients, Forecast, Sankey, Tags, Helpers\n(+ getNetWorthFromSnapshots).
  }

  class TagRepository {
    +getAll({ isActive? }): Promise<Tag[]>
    +findOrCreateBySlug(name, color): Promise<Tag>
    +update(id, fields): Promise<Tag>
    +softDelete(id): Promise<boolean>
    +getManyBySlugs(slugs): Promise<Tag[]>
    +countTransactionReferences(id): Promise<number>
  }

  class AttachmentRepository {
    +create(metadata): Promise<Attachment>
    +findById(id): Promise<Attachment | null>
    +listByTransaction(txId): Promise<Attachment[]>
    +deleteById(id): Promise<boolean>
  }

  class ImportBatchRepository {
    +listBatches(opts): Promise<Batch[]>
    +getBatch(batchId): Promise<Batch | null>
    +getPreviewRows(batchId): Promise<Row[]>
    +overrideRecipient(batchId, rowId, recipientId)
    +overrideCategory(batchId, rowId, categoryId)
    +markStagingRowDuplicate / Committed / Error(rowId)
    +rollbackBatch(batchId): Promise<boolean>
  }

  class AiChatRepository {
    +listConversations(limit): Promise<Conversation[]>
    +getConversation(id): Promise<Conversation | null>
    +createConversation(input): Promise<Conversation>
    +renameConversation(id, title)
    +deleteConversation(id): Promise<boolean>
    +getMessages(id): Promise<Message[]>
    +appendMessage(id, message): Promise<void>
  }

  class AiInvestigationRepository {
    +createJob(request): Promise<Job>
    +setProviderResult(id, result): Promise<Id>
    +finishJob(id, state, result, error): Promise<Job>
    +deleteJob(id): Promise<boolean>
  }

  class ProviderHealthRepository {
    +listAll(): Promise<ProviderHealth[]>
    +findByProvider(provider): Promise<ProviderHealth | null>
    +recordSuccess(provider)
    +recordError(provider, kind, errorMessage)
  }

  class CashflowForecastMcRepository {
    +get(params): Promise<Snapshot | null>
    +isFresh(snapshot): boolean
    +upsert(params, paths): Promise<Snapshot>
    +getActiveUserIds(): Promise<string[]>
    +clearAll(): Promise<void>
  }

  class CashflowForecastMcRollingRepository {
    +get(params): Promise<Snapshot | null>
    +isFresh(snapshot): boolean
    +upsert(params, paths): Promise<Snapshot>
    +clearAll(): Promise<void>
  }

  class CashflowForecastAccuracyRepository {
    +upsert({ userId, methodId, asOfMonth, mae, rmse, mape, sampleDays })
    +getHistory(opts): Promise<AccuracyRow[]>
    +getLatestByMethod(opts): Promise<AccuracyRow[]>
    +getAllHistory(opts): Promise<AccuracyRow[]>
  }

  class AccountRepository {
    +getAll(opts): Promise<Account[]>
    +getById(id): Promise<Account | null>
    +getByName(name): Promise<Account | null>
    +create(data): Promise<Account>
    +update(id, fields): Promise<Account>
    +remove(id): Promise<boolean>
    +upsertStatementBalance(id, currency, balance)
    +resolveOrCreateByName(name): Promise<Account>
  }

  class PortfolioExposureRepository {
    +listExposureSources()
    +listExposureTargets()
    +upsertExposureBundle(bundle)
  }

  class PortfolioImportBatchRepository {
    +listBatches(opts) / getBatch(batchId)
    +getPreviewRows(batchId)
    +overrideInvestment(s)(batchId, rows)
    +getCommittedRows(batchId)
    +markBatchAborted(batchId)
  }

  class PortfolioBrokerRetagRepository {
    +lockTransactions(ids)
    +compareAndSetAccount(id, before, after)
    +insertAudit(entry)
  }

  class ImportCommitRepository {
    +commitFingerprintRows(rows)
  }

  class AiResearchDocumentRepository {
    +listDocuments / getDocument
    +createDocument / deleteDocument
    +keywordSearch / semanticCandidates
  }

  class ProviderApiKeyRepository {
    +listAll / upsert / remove
  }

  class ProviderQuotaRepository {
    +getDayCount / addDayCount / tryReserveDay
  }

  class InstrumentProviderMapRepository {
    +listByInstrument / upsert / deleteById / markVerified
  }

  class InsightCashProjectionRepository {
    +getProjection / saveProjection
  }

  class InsightDismissalRepository {
    +listDismissals / upsertSubscription / upsertOutlier
    +getCountState / saveCountIfVersion
  }

  class CustomParserConfigRepository {
    +getAll(): Promise<Config[]>
    +getById(id): Promise<Config | null>
    +getByName(name): Promise<Config | null>
    +create({ name, config }): Promise<Config>
    +update(id, { name?, config? }): Promise<Config | null>
    +delete(id): Promise<boolean>
  }
}

package "Services" {
  class "ImportPipeline <<services/importPipeline>>" as ImportPipeline {
    +runImportPipeline(opts): Promise<ImportResult>
    +commitImport(opts): Promise<ImportResult>
  }

  class DataImportService {
    +importRecipientsCSV(path, opts): Promise<ImportResult>
    +importCategoriesCSV(path, opts): Promise<ImportResult>
  }

  class RecurringDetectionService {
    +detectRecurring(): Promise<RecurringPattern[]>
    +detectRecurringPatterns(): Promise<RecurringPattern[]>
  }

  class RecurrenceService {
    +generateOccurrences(startDate, pattern, endDate): Date[]
    +getNextOccurrence(date, pattern): Date
    +parseRecurrencePattern(patternStr): RecurrenceConfig
    +formatRecurrence(config): string
    +calculateNextDate(date, pattern): Date
  }

  class LoanRepaymentService {
    +generateLoanRepaymentSchedule(config): LoanSchedule
    +validateLoanConfig(config): ValidationResult
    +calculateMonthlyPayment(principal, rate, months): number
    +calculateTotalInterest(principal, rate, months): number
    +calculateEarlyRepayment(remaining, prepaymentAmount): RepaymentResult
  }

  class DeduplicationService {
    +isDuplicateByFields(date, amount, recipient, memo): Promise<boolean>
    +findDuplicates(criteria): Promise<Transaction[]>
    +markAsDuplicate(id, originalId): Promise<void>
  }

  class CurrencyConversionService {
    +convert(amount, fromCurrency, toCurrency): Promise<number>
    +getExchangeRate(fromCurrency, toCurrency): Promise<number>
    +warmCache(): Promise<void>
    +clearMemoryCache(): void
  }

  class PriceProviderService {
    +fetchPrice(provider, symbol): Promise<PriceData>
    +updateInvestmentPrices(): Promise<UpdateResult>
    +fetchLivePrices(investments): Promise<PriceMap>
  }

  class MaterializedViewService {
    +refreshMaterializedViews(): Promise<void>
    +createMaterializedViews(): Promise<void>
    +ensureMaterializedViewIndexes(): Promise<void>
    +scheduleRefresh(): void
  }

  class TextNormalization {
    +normalizeForMatching(text): string
    +normalizeAmount(amount): number
    +parseDate(dateStr): Date
    +cleanRecipientName(name): string
    +cleanKbcRecipientName(name): string
  }

  class BankAdapters {
    +createAdapter(bankName, config): BankParser
    +getSupportedBanks(): string[]
  }
}

' Relationships
DB <.. TransactionRepository
DB <.. RecipientRepository
DB <.. CategoryRepository
DB <.. CategoryHierarchyRepository
DB <.. PlannedTransactionRepository
DB <.. RecipientBankAccountRepository
DB <.. InvestmentRepository
DB <.. PortfolioTransactionRepository
DB <.. PortfolioImportReconciliationRepository
DB <.. PortfolioIncomeRecognitionRepository
DB <.. PortfolioImportCashRepository
DB <.. PortfolioAssetTransferRepository
DB <.. PortfolioAssetAdjustmentRepository
DB <.. PortfolioImportDuplicateRepairRepository
DB <.. WatchlistRepository
DB <.. SplitRepository
DB <.. AuditChainRepository
DB <.. SettingsRepository
DB <.. SavedChartsRepository
DB <.. InfoRepository
DB <.. TagRepository
DB <.. AttachmentRepository
DB <.. ImportBatchRepository
DB <.. AiChatRepository
DB <.. AiInvestigationRepository
DB <.. ProviderHealthRepository
DB <.. CashflowForecastMcRepository
DB <.. CashflowForecastMcRollingRepository
DB <.. CashflowForecastAccuracyRepository
DB <.. CustomParserConfigRepository
DB <.. AccountRepository
DB <.. PortfolioExposureRepository
DB <.. PortfolioImportBatchRepository
DB <.. PortfolioBrokerRetagRepository
DB <.. ImportCommitRepository
DB <.. AiResearchDocumentRepository
DB <.. ProviderApiKeyRepository
DB <.. ProviderQuotaRepository
DB <.. InstrumentProviderMapRepository
DB <.. InsightCashProjectionRepository
DB <.. InsightDismissalRepository

PortfolioImportReconciliationService --> PortfolioImportReconciliationRepository : snapshots + receipts
PortfolioImportReconciliationService --> PortfolioIncomeRecognitionRepository : paired income + guarded restore
PortfolioImportReconciliationService --> PortfolioImportCashService : bounded cash orchestration
PortfolioImportCashService --> PortfolioImportCashRepository : signed main/fee images
PortfolioImportCashService --> PortfolioImportReconciliationRepository : immutable source settlement

PortfolioImportDuplicateRepairService --> PortfolioImportDuplicateRepairRepository : dual images + guarded copy restore
PortfolioImportReconciliationService --> PortfolioImportDuplicateRepairService : explicit reviewed repair
PortfolioAssetTransferService --> PortfolioAssetTransferRepository : canonical custody events
PortfolioAssetAdjustmentService --> PortfolioAssetAdjustmentRepository : unit removals + pinned yield evidence
PortfolioImportReconciliationService --> PortfolioAssetAdjustmentService : projected adjustment validation
PortfolioImportCommitService --> PortfolioImportReconciliationService : locked plan + adoption
PortfolioImportReconciliationService --> PortfolioAssetTransferService : projected custody validation

' Import service dependencies
ImportPipeline --> BankAdapters
ImportPipeline --> DeduplicationService
ImportPipeline --> TransactionRepository
ImportPipeline --> ImportBatchRepository : staging
ImportPipeline --> ImportCommitRepository : commit
ImportPipeline --> AccountRepository

DataImportService --> TextNormalization

' Business logic dependencies
RecurringDetectionService --> TransactionRepository
RecurringDetectionService --> PlannedTransactionRepository

RecurrenceService --> PlannedTransactionRepository

LoanRepaymentService --> PlannedTransactionRepository
LoanRepaymentService --> TransactionRepository

DeduplicationService --> TransactionRepository

CurrencyConversionService --> TransactionRepository

PriceProviderService --> InvestmentRepository

AiInvestigationService --> AiInvestigationRepository

@enduml
