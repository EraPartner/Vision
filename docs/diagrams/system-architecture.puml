@startuml System Architecture Overview
title System Architecture Overview

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70

actor "User" as User

package "Client" {
  node "Native data session\nshared HTTP / SSE transport\nmutation drain / retired-delivery guard" as NativeDataSession
  node "Native Settings (seven panes)\nraw CAS / 500 ms sticky lanes\nshared AI receipts + existing desktop bridges" as NativeSettings
  node "Native Settings mirror\nsupported three-key deltas\ndraft then acknowledged receipt" as NativeSettingsMirror
  node "Native app-lifetime notices\nsix 8-second Undo owners\nsource non-Undo actions" as NativeNotices
  node "Vision Native (synthetic Demo)\nSwiftUI Tax, Portfolio + wealth tools\nDecimal display / native drafts" as NativeTax
  node "Native Portfolio Import\nprobe · parser · staged session\nreview · history · fingerprint commit" as NativeImport
  node "Native AI Chat\nconversation streams + partial retries\nTS tool-message presentation" as NativeAIChat
  node "Native Investigation\nexact preview + consent grants\njobs / documents / disclosure history" as NativeInvestigation
  node "Native Research Dossiers\nexplicit drafts + version CAS\nevidence / immutable history / JSON export" as NativeDossiers
  node "Native Research charts / forecast\nlocal layout storage + clipboard sharing\nexisting projections + paired Life scenarios" as NativeResearchTools
  node "Native Research (five routes)\nHome · Markets · Lookup\nWatchlist · Compare / lossless reads" as NativeResearch
  node "Native Analysis workspace\nquery / SQL · results · workbench\nversioned definitions + interchange" as NativeAnalysis
  node "Native Analysis Monitors\nrules · observations · inbox\nexact drafts / guarded reads" as NativeMonitors
  node "Native Portfolio Tax\nDecimal widgets + live-year drafts\nexisting atomic settings CAS" as NativePortfolioTax

  rectangle "Browser  /  Electron Renderer" {
    node "React 19 + TypeScript" as ReactApp
    node "Vite (Build Tool)" as Vite
    node "Tailwind CSS v4 + Radix UI" as UI
    node "React Router v6" as Router
    node "TanStack Query" as ReactQuery
    node "Zustand (client state)" as Zustand
    node "API Inspector (dev-only)\nCmd+Shift+A" as DevTools
  }
}

cloud "Load Balancer / Reverse Proxy\n(production hosts only)" as Proxy

package "Server" {
  rectangle "Node.js Backend (Bun runtime)" {
    node "Express.js" as Express
    node "Middleware Stack\nrequestId · Host guard · metrics\nCORS · CSRF · adminAuth · rate limit\nenvelope · errors" as Middleware
    node "Routes\ntransactions · planning · portfolio · imports\nreports · AI · settings · admin · private audit" as Routes
    node "Services\nimports + XML evidence + reconciliation + custody/adjustments · prices · FX · tax · snapshots\nbackup · AI orchestration + references + Desktop setup · reports · attachments" as Services
    node "Shared TypeScript helpers\ncomplete-source detection + bounded CSV preview\nPortfolio Tax estimators + cost buckets\nAnalysis CSV / stored-ZIP workbook interchange\nResearch stats / indicators / exact source previews" as SharedNativeHelpers
    node "Research presentation bridge\nsubmitted-data only / 64 MiB multipart\nno provider / DB / FX lookup" as ResearchPresentation
    node "Repositories\ntransaction · recipient · planning · portfolio\nimports + history receipts · AI jobs + reference maps · attachments · settings · info" as Repos
    node "Background Jobs\nrefreshCashflowForecastMc · local analysis monitor scheduler" as Jobs
  }
}

database "PostgreSQL 18" as DB {
  node "Schema (Alembic migrations)" as SchemaInit
  node "User-data tables\ntransactions · recipients · planning · portfolio + exposure sources\nimports + reconciliation receipts + custody/adjustment evidence · attachments · AI jobs + encrypted reference maps · monitor history · settings" as Tables
  node "Materialized Views\nmonthly summary · category totals\ncashflow daily · bank balances" as MatViews
  node "Aggregation tables (trigger-maintained)\nrecipient totals · split outstanding" as AggTables
  node "Indexes (incl. covering partial)" as Indexes
}

cloud "External Services" as External {
  node "ECB  /  open.er-api (FX)" as ECB
  node "Binance (crypto)" as Binance
  node "Yahoo Finance (stocks)" as Yahoo
  node "Kinesis (metals)" as Kinesis
  node "Statbel (inflation)" as Statbel
  node "Eurostat HICP (inflation fallback + macro, ADR-082)" as Eurostat
  node "FRED / St. Louis Fed (macro series, ADR-082)" as FRED
  node "DBnomics (ECB/OECD/IMF macro, keyless, ADR-082)" as DBnomics
  node "Local Ollama (LLM, 127.0.0.1:11434)" as Ollama
  node "AgentCloak\nDesktop /detect or MCP /mcp, optional" as AgentCloak
  node "OpenAI Responses API\nopt-in planning or selected-evidence synthesis" as OpenAI
  node "Codex App Server provider\nexperimental synthetic-only" as CodexProvider
}

cloud "Build & Distribution" as DevToolsCloud {
  node "Native runtime provider\n(PostgreSQL 18 + Bun lifecycle)" as NativeRuntime
  node "Bun (runtime + workspaces)" as Bun
  node "Electron (packaging/electron)" as Electron
  node "electron-builder\n(ad hoc signing)" as Builder
  node "GitHub Releases\n(trusted publisher)" as GitHubReleases
  node "Vitest 4 + property tests" as Vitest
  node "Trivy filesystem scan" as Trivy
  node "ESLint / openapi-typescript" as Lint
}

package "Client to Server" {
  User --> ReactApp : HTTPS
  ReactApp --> Proxy : REST API
  NativeSettings --> NativeDataSession : shared APIClient requests
  NativeAIChat --> NativeDataSession : HTTP / SSE transport
  NativeDataSession --> Express : existing wire operations unchanged
  NativeSettings --> Express : existing settings CAS / AI-provider operations
  NativeSettings --> NativeSettingsMirror : immediate draft / acknowledged receipt
  NativeSettingsMirror --> ReactApp : suppress duplicate hydration writers
  ReactApp --> NativeSettingsMirror : native-only shell:settings-change\napp / dashboard / theme field deltas
  NativeSettings .. NativeAIChat : successful status / model receipts
  NativeSettings .. NativeInvestigation : successful research-status receipts
  NativeTax --> NativeNotices : source notices / captured actions
  NativeNotices --> ReactApp : preserve editor-owned Undo\nexisting route callbacks
  NativeTax --> Express : loopback OpenAPI financial reads + writes
  NativeImport --> Express : readonly probe + existing import/review operations
  NativePortfolioTax --> Express : portfolio-dashboard + settings CAS
  NativeAIChat --> Express : existing conversation CRUD / JSON SSE\nordered toolPresentation sibling
  NativeInvestigation --> Express : existing status / jobs / documents\npreview / digest-bound grants / history
  NativeDossiers --> Express : existing paged reads / expected-version writes\nimmutable restore / JSON export
  NativeAIChat .. NativeInvestigation : same mounted /ai-chat coordinator
  NativeResearchTools --> Express : chart / Life presentation + existing forecasts\nsettings CAS
  NativeResearchTools --> ReactApp : same WK localStorage layout key
  NativeResearch --> Express : existing scoped reads / guarded writes\nstateless submitted presentation
  NativeAnalysis --> Express : existing restricted execution + versions\nreadonly multipart interchange
  NativeMonitors --> Express : existing monitor reads + explicit writes
  NativeTax --> NativeReports : native PDF form overlay
  Proxy --> Express : Forward
}

package "Desktop Runtime" {
  node "Local audit receipt\nHMAC + safeStorage key\noutside PostgreSQL and backup" as AuditReceipt
  Electron --> NativeRuntime : packaged default
  NativeRuntime --> Express : loopback backend
  NativeRuntime --> DB : admin provisions executor login\nowner/app role connections
  Electron --> AuditReceipt : authenticate and update
  Electron --> Routes : loopback + per-launch token\nverify and checkpoint metadata
}

package "Experimental Codex Boundary" {
  node "Disposable App Server\nmacOS Seatbelt + ephemeral auth" as CodexChild
  node "CONNECT proxy\nallowed hosts + byte caps" as CodexProxy
  Routes --> CodexChild : admin opt-in + fixed fictional turn
  CodexChild --> CodexProxy : loopback only
  CodexProxy --> CodexProvider : TLS tunnel
}

package "Server Components" {
  Express --> Middleware
  Middleware --> Routes
  Routes --> ResearchPresentation
  ResearchPresentation --> SharedNativeHelpers : same pure web algorithms
  Routes --> Services
  Services --> SharedNativeHelpers : reuse pure parsing / fiscal calculations
  Services --> Repos
  Jobs --> Services
}

package "Database Access" {
  Repos --> DB : parameterised SQL
  DB --> Repos : rows
  Services --> MatViews : REFRESH CONCURRENTLY
  Services --> DB : local monitor rules, observations, inbox
}

package "External Services" {
  Services --> External : HTTPS / local HTTP (Ollama)
  External --> Services : JSON
  Services --> AgentCloak : optional Desktop detection before protection\nfinal preview check + each OpenAI attempt
  Services --> AgentCloak : Desktop setup availability probe\nbefore saving enabled preference
}

note right of External
  - Exchange rates refreshed every 12h
  - Price providers run in parallel (Promise.allSettled)
    with AbortSignal.timeout(8s)
  - Inflation: Statbel primary, Eurostat HICP fallback
  - Macro (ADR-082): FRED (keyed), Eurostat (keyless),
    DBnomics (keyless) — provider-pinned, in-memory cache,
    never persisted to asset_price_history
  - Ollama is local-only (privacy non-negotiable)
  - OpenAI egress is explicit and digest-bound. Planning receives
    public catalog identifiers only; private analysis results stay local (ADR-149)
  - Explicit selected-text markers may become one-job typed tokens.
    AES-256-GCM mappings and answer restoration stay local (ADR-151).
  - Optional AgentCloak Desktop detects selected-text spans before preview;
    Vision encrypts their scoped token mapping and restores locally (ADR-170).
    The MCP mode checks token-safe text without applying its rewrite (ADR-169).
    Remaining findings, changed text, or check failure block egress.
end note

note right of Tables
  Raw-transaction tables: per-bank for replay / audit;
  manual_raw_transactions handles manual-entry dedup.
  Reversible-reference rows contain ciphertext, nonce, tag, and typed token.
  Their installation key is outside PostgreSQL and backup (ADR-151).
end note

note right of Middleware
  Rate limit: 200 req/min global
  Admin auth: crypto.timingSafeEqual against ADMIN_AUTH_TOKEN
  Envelope: { data, error, meta }  (ADR-026)
end note

note right of ReactQuery
  staleTime: 30s   ·   gcTime: 5min
  Window-focus refetch disabled
end note

note right of DevTools
  Dev builds only — React.lazy + Suspense behind
  import.meta.env.DEV; tree-shaken in production
  (dist/ has zero devtools references).
end note

note right of NativeRuntime
  Vision ships PostgreSQL 18.6, a migration executable,
  and Chrome Headless Shell. Electron manages the private,
  loopback-only PostgreSQL cluster and Bun backend lifecycle,
  logs, readiness, updates, and durable runtime marker.
  Cluster admin provisions Analysis executor credentials and defaults.
  After migrations, the NOCREATEROLE owner resets approved view grants.
  A saved legacy runtime marker fails closed and directs
  the user to the last migration-capable release (ADR-133).
  Vision Demo reuses this provider with an isolated runtime,
  port, and deterministic seed activated atomically (ADR-114).
end note

note right of NativeImport
  Probe creates no batches or financial records.
  Multi-statement staging retains review-required batches.
  Scope/policy edits invalidate the reviewed fingerprint;
  commit and rollback reuse existing TypeScript writers.
  Checkpoints exclude file bytes; uncertain results block blind repeats.
end note

note right of NativePortfolioTax
  Historical recorded costs use the selected year;
  gains/current values retain existing all-time web semantics.
  Active canonical and archived/current-FX display stay distinct.
  Decimal decode/rendering and drafts stay native;
  fiscal formulas, cost buckets and badge rates stay TypeScript.
  Both setting maps retain unknown fields and original CAS tokens.
  macOS package and Demo parity review remain pending.
end note

note right of NativeAnalysis
  TypeScript owns financial datasets and refinement calculations.
  Decimal strings, JSON cells, scope and provenance stay lossless.
  CSV / XLSX imports never execute workbook formula cells.
  Captured exports retain partial / paged window annotations.
  Leaving resets reads / previews; pending writes retain acknowledgements.
end note

note right of NativeMonitors
  Server owns exact comparisons, episodes and persisted observations.
  Native thresholds remain strings and target/read generations are guarded.
  Writes retire prior reads before and after their acknowledgement.
  macOS package and Demo parity review remain pending.
end note

note right of NativeResearch
  Provider numbers decode as Decimal; metadata retains provenance.
  Current-scope cache, late-read guards and visible polling stay native.
  Financial transformations and two-of-three previews stay TypeScript.
  Source currency conventions remain unchanged.
  Chart Builder / Forecast have a separate native client node.
  Dossiers and AI clients have separate native nodes.
  macOS package and Demo parity review remain pending.
end note

note right of NativeResearchTools
  Chart indicators / rebasing and Life preparation / comparison stay TypeScript.
  Native forwards two existing Life forecasts with one paired seed.
  Unknown / overflowed available bands fail the canonical numeric guard.
  Layout writes share the original WK localStorage library and schema.
  Scenario writes retain serialized raw settings CAS baselines.
  macOS package and Demo parity review remain pending.
end note

note right of NativeAIChat
  Stream lifetime is distinct from page-read lifetime.
  Shared TypeScript derives ordered axes / pie composition before wire encoding.
  Raw stored tool results and model prompts stay unchanged.
  Native only draws and formats returned data.
  macOS package and Demo parity review remain pending.
end note

note right of NativeInvestigation
  Form changes retire obsolete previews.
  Consented sends use the frozen preview request and its digest-bound grant.
  Status mount / reconnect freshness and explicit invalidation
  are separate from manual job polling; ordinary focus refetch is disabled.
  Documents remain mount-only reads; original upload bytes reach the backend.
  Real route exit resets local job state without deleting the remote job.
  macOS package and Demo parity review remain pending.
end note

note right of NativeDossiers
  Explicit expected-version saves and immutable restore remain server-owned.
  Current selection / visit guards protect drafts and source anchors.
  Existing JSON exports are captured server snapshots, not an import format.
  macOS package and Demo parity review remain pending.
end note

note right of NativeSettings
  App/dashboard migrations preserve unknown fields and optional absence.
  Theme writes contain mode, schedule, variant, systemAccent only.
  No new backend endpoint or native financial engine.
  Main holds debounced drafts and drains accepted queues before restore.
  Failure resumes the same baselines; success retires old writers.
  UUID-owned restore serves Settings and retained onboarding.
  Generation-checked reload creates a fresh graph once.
  SDK/macOS verification remains pending.
  Automated branch macOS verification exists but is not yet green.
end note

note right of NativeDataSession
  Pause mutation admission and wait for transport completions.
  Refuse paused reads; invalidate pre-attempt read epochs even on failure.
  Failed restore resumes the same session; success retires it.
  Old shared-client admissions and late HTTP/SSE delivery are rejected.
  Cancellation does not prove a server write was rolled back.
  Portable transport cases pass; SDK/macOS verification remains pending.
end note


package "Native phase 3p ownership" {
  node "Palette + shortcuts\nFX / upcoming / backup banners" as NativeShellOverlays
  node "Seven-step setup assistant\nsource draft / shared completion writer" as NativeOnboarding
  node "Native PDF form\noriginal source fiscal context\n900s binary response / native save" as NativeReports
  node "Tax / Statistics / Net worth print\nimmutable loaded figures + local state\nprinter rendering not yet verified" as NativeVisiblePrint
}
NativeShellOverlays --> NativeSettings : app-lifetime preference state
NativeOnboarding --> NativeSettings : completion / restore owner
NativeReports --> NativeDataSession : shared restore fence
NativeReports --> Routes : existing POST /api/reports/{type}
NativeReports --> ReactApp : fixed TS projection / original context
NativeTax --> NativeVisiblePrint : loaded snapshot / no new computation

node "Renderer document readiness\nawait commit / reject outgoing ready" as NativeDocumentReadiness
NativeTax --> NativeDocumentReadiness : SDK startup / restore graph boundary

@enduml
