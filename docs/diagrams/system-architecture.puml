@startuml System Architecture Overview
title System Architecture Overview

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70

actor "User" as User

package "Client" {
  rectangle "Browser  /  Electron Renderer" {
    node "React 18 + TypeScript" as ReactApp
    node "Vite (Build Tool)" as Vite
    node "Tailwind CSS v4 + Radix UI" as UI
    node "React Router v6" as Router
    node "TanStack Query" as ReactQuery
    node "Zustand (client state)" as Zustand
    node "API Inspector (dev-only)\nCmd+Shift+A" as DevTools
  }
}

cloud "Load Balancer / Reverse Proxy\n(production hosts only)" as Proxy

package "Server" {
  rectangle "Node.js Backend (Bun runtime)" {
    node "Express.js" as Express
    node "Middleware Stack" as Middleware {
      - adminAuth (timing-safe)
      - requestId / requestMetrics
      - CORS / Security Headers
      - Rate Limiter (200 req/min)
      - Envelope normaliser
      - Error Handler
    }
    node "Routes (20 files, ~148 endpoints)" as Routes {
      - transactions / splits / tags
      - planned-transactions
      - categories / recipients
      - recipientBankAccounts
      - investments / portfolio
      - import / attachments
      - watchlist / market-lookup
      - aggregations / info
      - settings / saved-charts
      - reports (PDF)
      - ai (Ollama chat)
      - admin (db, providers, endpoints, metrics)
    }
    node "Services" as Services {
      - importPipeline (validate / stage / match / commit)
      - bankAdapters (Belfius, ING, KBC, Revolut, SABB, Wise, ...)
      - priceProviderService
      - currencyConversion / belgianInflationService
      - portfolioPerformanceSnapshotService
      - quoteBackfillService
      - recurringDetectionService
      - recipientMerge / recipientPattern / recipientCluster
      - materializedViewService
      - aggregationRefresh
      - backup (AES-256-GCM v2)
      - aiChat (Ollama tool-loop)
      - providerHealthService
      - routeManifest
      - reports (pdfkit)
      - attachmentService
    }
    node "Repositories (30 files)" as Repos {
      - transactionRepository
      - rawTransactionRepository
      - categoryRepository
      - recipientRepository + recipientBankAccountRepository
      - plannedTransactionRepository
      - investmentRepository + portfolioTransactionRepository
      - importBatchRepository
      - aiChatRepository
      - attachmentRepository
      - providerHealthRepository
      - savedChartsRepository
      - splitRepository / tagRepository / watchlistRepository
      - cashflowForecast (3 repos)
      - settingsRepository
      - infoRepository* (7 sub-modules)
    }
    node "Background Jobs" as Jobs {
      - refreshCashflowForecastMc
    }
  }
}

database "PostgreSQL 18" as DB {
  node "Schema (Alembic migrations)" as SchemaInit
  node "User-data tables" as Tables {
    - transactions / transaction_splits / split_payments
    - tags / transaction_tags
    - categories / recipients / recipient_bank_accounts
    - planned_transactions / .._executions / .._loan_schedule
    - investments_base (+ inheritance children)
    - portfolio_transactions_base (+ inheritance children)
    - exchange_rates / exchange_rate_cache
    - asset_price_history / belgian_inflation_rates
    - portfolio_performance_snapshots
    - cashflow_forecast_* (mc, rolling, accuracy)
    - attachments
    - ai_conversations
    - provider_health
    - import_batches / import_rows
    - watchlist / saved_charts
    - user_settings
    - bank-raw tables (belfius / revolut / ing / kbc / sabb / wise / vision / manual)
    - transaction_raw_references
  }
  node "Materialized Views" as MatViews {
    - mv_monthly_summary
    - mv_category_totals
    - mv_cashflow_daily
    - mv_bank_balances
    - mv_recipient_monthly
  }
  node "Aggregation tables  (trigger-maintained)" as AggTables {
    - agg_recipient_totals
    - agg_split_outstanding
  }
  node "Indexes (incl. covering partial)" as Indexes
}

cloud "External Services" as External {
  node "ECB  /  open.er-api (FX)" as ECB
  node "Binance (crypto)" as Binance
  node "Yahoo Finance (stocks)" as Yahoo
  node "Kinesis (metals)" as Kinesis
  node "Statbel (inflation)" as Statbel
  node "Eurostat HICP (inflation fallback + macro, ADR-082)" as Eurostat
  node "FRED / St. Louis Fed (macro series, ADR-082)" as FRED
  node "DBnomics (ECB/OECD/IMF macro, keyless, ADR-082)" as DBnomics
  node "Local Ollama (LLM, 127.0.0.1:11434)" as Ollama
}

cloud "Build & Distribution" as DevToolsCloud {
  node "Docker (postgres + app)" as Docker
  node "Bun (runtime + workspaces)" as Bun
  node "Electron (packaging/electron)" as Electron
  node "electron-builder + notarisation" as Builder
  node "ToDesktop CDN" as ToDesktop
  node "Vitest 4 + property tests" as Vitest
  node "Trivy CI image scan" as Trivy
  node "ESLint / openapi-typescript" as Lint
}

package "Client to Server" {
  User --> ReactApp : HTTPS
  ReactApp --> Proxy : REST API
  Proxy --> Express : Forward
}

package "Server Components" {
  Express --> Middleware
  Middleware --> Routes
  Routes --> Services
  Services --> Repos
  Jobs --> Services
}

package "Database Access" {
  Repos --> DB : parameterised SQL
  DB --> Repos : rows
  Services --> MatViews : REFRESH CONCURRENTLY
}

package "External Services" {
  Services --> External : HTTPS / local HTTP (Ollama)
  External --> Services : JSON
}

note right of External
  - Exchange rates refreshed every 12h
  - Price providers run in parallel (Promise.allSettled)
    with AbortSignal.timeout(8s)
  - Inflation: Statbel primary, Eurostat HICP fallback
  - Macro (ADR-082): FRED (keyed), Eurostat (keyless),
    DBnomics (keyless) — provider-pinned, in-memory cache,
    never persisted to asset_price_history
  - Ollama is local-only (privacy non-negotiable)
end note

note right of Tables
  Raw-transaction tables: per-bank for replay / audit;
  manual_raw_transactions handles manual-entry dedup.
end note

note right of Middleware
  Rate limit: 200 req/min global
  Admin auth: crypto.timingSafeEqual against ADMIN_AUTH_TOKEN
  Envelope: { data, error, meta }  (ADR-026)
end note

note right of ReactQuery
  staleTime: 30s   ·   gcTime: 5min
  Window-focus refetch disabled
end note

note right of DevTools
  Dev builds only — React.lazy + Suspense behind
  import.meta.env.DEV; tree-shaken in production
  (dist/ has zero devtools references).
end note

note right of Docker
  Hardened (ADR-039): non-root, cap_drop ALL,
  read-only rootfs, no-new-privileges,
  mem_limit 4g / cpus 4.0, Trivy on every push.
end note

@enduml
