@startuml Frontend Page & Route Structure
title Frontend Page & Route Structure

!theme plain
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50

package "Routing (React Router)" {
  class BrowserRouter
  class Routes
}

package "Budgeting Pages" {
  class DashboardPage {
    +Stats Overview
    +Recent Transactions
    +Category Breakdown
    +Upcoming Payments
  }

  class TransactionsPage {
    +Transaction List
    +Filters
    +Pagination
    +Transaction Form
  }

  class CategoriesPage {
    +Category List
    +Category Form
  }

  class RecipientsPage {
    +Recipient List
    +Recipient Form
    +Merge Dialog
  }

  class PlannedPaymentsPage {
    +Planned Transactions List
    +Planned Transaction Form
    +Loan Calculator
    +Execution History
  }

  class StatisticsPage {
    +Monthly Trend
    +Category Breakdown
    +Recipient Insights
    +Custom Charts
  }

  class ImportPage {
    +Bank Selector
    +CSV Preview
    +Import Progress
    +Import Results
  }

  class OwesPage {
    +Owed Amounts
  }

  class ImportReviewPage {
    +Per-row recipient overrides
    +Commit / cancel batch
  }

  class RecipientInsightsPage {
    +Per-recipient charts
    +Owes detail
    +Tag breakdown
  }
}

package "Portfolio Pages" {
  class PortfolioOverviewPage {
    +Asset Allocation
    +Total Value
    +Performance Summary
  }

  class StocksPage {
    +Stock Holdings
    +Stock Transactions
  }

  class CryptoPage {
    +Crypto Holdings
    +Crypto Transactions
  }

  class MetalsPage {
    +Metals Holdings
    +Metals Transactions
  }

  class RealEstatePage {
    +Properties
    +Property Details
    +Rental Income
  }

  class SavingsPage {
    +Savings Accounts
    +Interest Rates
  }

  class PerformancePage {
    +Performance Charts
    +Historical Returns
    +Benchmark Comparison
  }

  class NetWorthPage {
    +Net Worth Chart
    +Assets vs Liabilities
    +Time Series
  }

  class PortfolioTaxPage {
    +Tax Lots
    +Capital Gains
    +Withholding Tax
  }

  class PortfolioImportPage <<ADR-078>> {
    +Column Mapper (PortfolioCsvColumnMapper)
    +File Upload + Saved Parser Picker
    +SSE Progress
    +FileHeadersPanel preview
  }

  class PortfolioImportReviewPage <<ADR-078>> {
    +Groups by investment (unresolved/resolved)
    +InvestmentCombobox per unresolved group
    +Commit / abort batch
  }
}

package "Research Pages (ADR-079)" {
  class ResearchHomePage {
    +Aggregated Provider Data
    +Quick Symbol Search
  }

  class MarketLookupPage {
    +Search
    +Price Display
  }

  class WatchlistPage {
    +Watchlist Items
    +Price Alerts
  }

  class ResearchComparePage {
    +Multi-symbol Compare
    +Metric Table
  }

  class ResearchSymbolPage {
    +Symbol Detail
    +Provider Breakdown
  }
}

package "Tax Pages" {
  class TaxOverviewPage {
    +Tax Summary
    +Deductions List
    +Tax Profile
  }
}

package "Admin Pages (Workspace-Agnostic)" {
  class AdminOverviewPage {
    +Summary Tiles
    +Links to Details
  }

  class DbMaintenancePage {
    +Table Stats
    +VACUUM Operations
  }

  class ProviderHealthPage {
    +Provider Health
    +Active Probes
  }

  class EndpointLivenessPage {
    +Route Liveness Matrix
    +Rolling Metrics
  }

  class ExchangeRatesPage {
    +Current Rates
    +Historical Chart
  }
}

package "Workspace-Agnostic Pages" {
  class AIChatPage <<ADR-024>> {
    +Local Ollama chat
    +Tool-augmented result cards
    +Conversation history
  }
}

package "Error Pages" {
  class NotFound {
    +404 Page
  }
}

package "Shared Components" {
  class AppLayout {
    +Sidebar
    +Header
    +Footer
  }
}

' Route Hierarchy
BrowserRouter --> Routes
Routes --> AppLayout

AppLayout --> DashboardPage : "/"
AppLayout --> TransactionsPage : "/transactions"
AppLayout --> CategoriesPage : "/categories"
AppLayout --> RecipientsPage : "/recipients"
AppLayout --> PlannedPaymentsPage : "/planned"
AppLayout --> StatisticsPage : "/statistics"
AppLayout --> ImportPage : "/import"
ImportPage --> ImportReviewPage : "/import/:batchId/review"
AppLayout --> OwesPage : "/owes"
AppLayout --> TaxOverviewPage : "/tax"
AppLayout --> AIChatPage : "/ai-chat"
RecipientsPage --> RecipientInsightsPage : "/recipients/:id/insights"

AppLayout --> PortfolioOverviewPage : "/portfolio"
PortfolioOverviewPage --> StocksPage : "/portfolio/stocks"
PortfolioOverviewPage --> CryptoPage : "/portfolio/crypto"
PortfolioOverviewPage --> MetalsPage : "/portfolio/metals"
PortfolioOverviewPage --> RealEstatePage : "/portfolio/real-estate"
PortfolioOverviewPage --> SavingsPage : "/portfolio/savings"
PortfolioOverviewPage --> PerformancePage : "/portfolio/performance"
PortfolioOverviewPage --> NetWorthPage : "/portfolio/net-worth"
PortfolioOverviewPage --> PortfolioTaxPage : "/portfolio/tax"
PortfolioOverviewPage --> PortfolioImportPage : "/portfolio/import"
PortfolioImportPage --> PortfolioImportReviewPage : "/portfolio/import/:batchId/review"

AppLayout --> ResearchHomePage : "/research"
ResearchHomePage --> MarketLookupPage : "/research/market"
ResearchHomePage --> WatchlistPage : "/research/watchlist"
ResearchHomePage --> ResearchComparePage : "/research/compare"
ResearchHomePage --> ResearchSymbolPage : "/research/symbol/:symbol"

AppLayout --> AdminOverviewPage : "/admin"
AdminOverviewPage --> DbMaintenancePage : "/admin/db"
AdminOverviewPage --> ProviderHealthPage : "/admin/providers"
AdminOverviewPage --> EndpointLivenessPage : "/admin/endpoints"
AdminOverviewPage --> ExchangeRatesPage : "/admin/exchange-rates"

AppLayout --> NotFound : "*"

note right of AdminOverviewPage
  Workspace-agnostic routes
  Preserve last active workspace
end note

note bottom of ResearchHomePage
  Market Lookup & Watchlist moved here from
  Portfolio (ADR-079). Legacy /portfolio/market
  and /portfolio/watchlist redirect here;
  /portfolio/exchange-rates redirects to
  /admin/exchange-rates
end note

@enduml
