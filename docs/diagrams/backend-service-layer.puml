@startuml Service Layer Architecture
title Service Layer Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

package "Belgian Tax" {
  class TaxOverviewService {
    +getTaxOverview(year?): live/historical overview
  }
  class TaxDashboardService {
    +getTaxDashboard(options): chart and widget data
  }
  class "shared-utils/belgianTax" as SharedBelgianTaxEngine {
    +computeHouseholdTax(household)
    +recordedIncomeAttribution / portfolioTax
  }
  TaxOverviewService --> SettingsService : one settings/baseline read
  TaxOverviewService --> SharedBelgianTaxEngine : frozen first
  TaxDashboardService --> TaxOverviewService
  TaxDashboardService --> SharedBelgianTaxEngine : server-owned fiscal derivation
  TaxDashboardService --> PortfolioTransactionRepository : recorded costs, active + inactive
  TaxDashboardService --> InfoRepository : through monthly/category aggregation services
  TaxDashboardService --> CurrencyConversionService : latest stored rates; missing rate reported
}

package "Import Pipeline" {
  class ImportPipeline {
    +createBatch(stream, adapter): Promise<Batch>
    +stageBatch(batchId): Promise<void>
    +validateBatch(batchId): Promise<ValidationResult>
    +matchBatch(batchId): Promise<MatchResult>
    +commitBatch(batchId, overrides): Promise<CommitResult>
  }

  class ImportIdentity <<ADR-134>> {
    +assignImportIdentities(rows, baseFor): Identity[]
    +budgetingIdentityBase(row, adapter): IdentityBase
    +portfolioIdentityBase(row, context): IdentityBase
    +computeSourceRecordHash(rawData): string
  }

  class DataImportService {
    +importRecipientsCSV(path, opts): Promise<ImportResult>
    +importCategoriesCSV(path, opts): Promise<ImportResult>
  }
}

package "Business Logic Services" {
  class RecurringDetectionService {
    +detectRecurring(): Promise<RecurringPattern[]>
    +detectRecurringPatterns(): Promise<RecurringPattern[]>
  }

  class "calculations/recurrence" as RecurrenceCalc {
    +generateOccurrences(startDate, pattern, endDate): Date[]
    +getNextOccurrence(date, pattern): Date
    +parseRecurrencePattern(patternStr): RecurrenceConfig
    note bottom: formerly recurrenceService.js
  }

  class "calculations/loanSchedule" as LoanScheduleCalc {
    +generateLoanRepaymentSchedule(config): LoanSchedule
    +validateLoanConfig(config): ValidationResult
    +calculateMonthlyPayment(principal, rate, months): number
    note bottom: formerly loanRepaymentService.js
  }

  class "calculations/forecast/*" as ForecastCalc {
    +holtWinters(series, opts): Series
    +prophetLite(series, opts): Series
    +weightedAverage(series, opts): Series
    +monteCarloEnsemble(opts): Paths
  }

  class "portfolio/rebalanceTargets" as RebalanceTargets {
    +resolveRebalanceTargetWeights(body): TargetWeights
    note bottom: Validates explicit weights or model presets,\nfolds aliases, then normalizes.
  }

  class CommitmentAwareCashService {
    +computeCommitmentAwareCash({currency, reserveFloor}): Promise<CashCap>
  }

  class "research/projection/portfolioProjection" as PortfolioProjection {
    +runPortfolioForecast({monthlyContributionSchedule?, goalMonth?}): Projection
  }

  class CrossWorkspaceDataService {
    +assembleRebalanceInputs({currency, rates?}): Promise<Inputs>
  }

  class DeduplicationService {
    +lockManualTransactionIdentity(input): Promise<Identity>
    +isManualDuplicate(input): Promise<boolean>
    +recordManualTransactionDedupClaim(hash, transactionId): Promise<void>
  }

  class RecipientMergeService {
    +mergeRecipients(primaryId, duplicateIds): Promise<MergeResult>
  }

  class RecipientClusterService {
    +findRecipientClusters(opts): ClusterList
  }

  class RecipientPatternService {
    +loadActivePatterns(): Promise<Pattern[]>
    +applyPatterns(rows): Promise<Match[]>
    +createPattern / updatePattern / deletePattern
  }

  class "lib/filterBuilder" as FilterBuilder {
    +buildTransactionWhere(filters): { sql, params }
  }

  class BulkSelection {
    +resolveBulkSelection({ ids?, filter? }): IdSet
  }
}

package "External / Data" {
  class "currency/CurrencyConversionService" as CurrencyConversionService {
    +convertToCurrency(amount, from, to): Promise<Converted>
    +convertRowsToEur(rows): Promise<Rows>
    +loadCurrentRates(): Promise<RateTable>
    +warmCache(): Promise<void>
    +backfillPortfolioHistoricalRates(): Promise<void>
    note bottom: Stored exchange_rates only;\na historical miss uses the latest stored rate.
  }

  class PriceProviderService {
    +fetchLivePricesDetailed(investments): Promise<PriceMap>
    +fetchHistoricalPrices(investment, range): Promise<Series>
  }

  class BelgianInflationService {
    +getInflationRates(opts): Promise<InflationRate[]>
    +warmInflationCache(): Promise<void>
  }

  class PortfolioPerformanceSnapshotService {
    +computeAndStoreSnapshots(currency): Promise<void>
    +getSnapshots(start, end, currency): Promise<Snapshot[]>
    +storeCurrentBrokerSnapshot(currency, summary): Promise<Result>
    +getBrokerSnapshots(start, end, currency): Promise<BrokerSnapshot[]>
  }

  class AnalysisCatalog <<ADR-144>> {
    +getAnalysisCatalog(): Catalog
    +compileVisualAnalysis(plan): CompiledQuery
  }

  class AnalysisExecutor <<ADR-144>> {
    +executeAnalysisSql(request): Promise<Result>
    +cancelAnalysisQuery(requestId): Promise<CancelResult>
  }

  class AnalysisFinancialDatasets <<ADR-175>> {
    +executeFinancialAnalysis(plan): Result
  }
  class AnalysisPivotService <<ADR-175>> {
    +executeAnalysisPivot(plan, config): Pivot
  }
  class AnalysisWorkbenchService <<ADR-175>> {
    +applyAnalysisWorkbench(result, settings): Result
    +evaluateAnalysisExtension(input): Result
  }
  class SavedAnalysisService <<ADR-144>> {
    +createSavedAnalysis(input): Promise<SavedAnalysis>
    +updateSavedAnalysis(id, input): Promise<SavedAnalysis>
    +runSavedAnalysis(id): Promise<SavedAnalysis>
  }

  class ResearchDossierService <<ADR-153>> {
    +createResearchDossier(input): Promise<Dossier>
    +updateResearchDossier(id, expectedVersion, content): Promise<Dossier>
    +restoreResearchDossier(id, version, expectedVersion): Promise<Dossier>
    +exportResearchDossiers(): Promise<Export>
  }

  class AnalysisMonitorService <<ADR-154>> {
    +checkAnalysisMonitor(id): Promise<Observation>
    +checkDueAnalysisMonitors(): Promise<number>
    +listMonitorNotifications(page): Promise<Inbox>
  }

  class AnalysisMonitorScheduler <<ADR-154>> {
    +startAnalysisMonitorScheduler(): void
    +one startup catch-up and 60-second ticks
  }

  class QuoteBackfillService {
    +backfillHistoricalAssetQuotes(): Promise<void>
    +refreshActiveHoldingQuotes(): Promise<void>
    +backfillHoldingGaps(): Promise<void>
    +refreshQuotesForInvestment(id): Promise<void>
  }

  class BankAdapters {
    +createAdapter(bankName, config): BankParser
    +getSupportedBanks(): string[]
  }
}

package "Storage & Performance" {
  class MaterializedViewService {
    +refreshMaterializedViews(): Promise<void>
    +scheduleRefresh(): void
  }

  class AggregationRefreshService {
    +refreshAggregations(): Promise<void>
    +scheduleAggregationRefresh(): void
    +scheduleMaterializedViewRefresh(): void
    +cancelPendingAggregationRefresh(): void
  }

  class AttachmentService {
    +storeAttachment(txId, file): Metadata
    +resolveAbsolutePath(id): Promise<string>
    +removeAttachmentFile(path): Promise<void>
  }

  class TransactionExport {
    +streamCsvExport(res, filters): void
    +streamNdjsonExport(res, filters): void
  }
}

package "AI & Observability" {
  class AiChatService {
    +runChatTurn(conversationId, message, {streaming}): Promise<Turn>
    +listConversations() / getConversationWithMessages(id)
  }

  class AiInvestigationService <<ADR-145, ADR-229>> {
    +createInvestigation(input): Promise<Job>
    +runInvestigationJob(id): Promise<Job>
    +resumeRecoverableInvestigations(): Promise<number>
  }

  class AiProviderAdapters {
    +generateLocal(input): Promise<ProviderGeneration>
  }

  class ProviderHealthService {
    +recordSuccess(provider, latency): void
    +recordError(provider, err): void
    +probeProvider(provider): ProbeResult
    +listProviderHealth(): Summary
  }

  class RouteManifest {
    +buildRouteManifest(app): Route[]
  }

  class "aiResearchDocuments" as AiResearchDocuments
  class "research/*" as ResearchProviders
}

package "Supporting" {
  class "lib/textNormalization" as TextNormalization {
    +normalizeForMatching(text): string
    +cleanRecipientName(name): string
    +cleanKbcRecipientName(name): string
  }
}

package "Thin Route Seams (ADR-067, June 2026)" {
  note as SeamNote
    Thin seam services enforce the route-to-service boundary.
    Each provides a stable orchestration point above repositories.
  end note
  class CategoryService
  class TransactionService
  class RecipientService
  class RecipientBankAccountService
  class SavedChartsService
  class InfoService
  class PlannedTransactionService {
    +create(input): Promise<PlannedTransaction>
    +update(id, fields): Promise<PlannedTransaction>
    +updateWithLoanSchedule(id, fields, schedule): Promise<PlannedTransaction>
    +replaceLoanSchedule(id, schedule): Promise<void>
    +executeAndAdvance(plannedId, transactionId, date, fields, tags): Promise<Result>
  }
  class SettingsService
  class SplitService {
    +createSplitAtomic(input): Promise<Split>
    +createSplitsBatchAtomic(input): Promise<Split[]>
    +getOwedSummary(): Promise<OwedSummary[]>
    +getOwedByRecipient(id, page): Promise<OwedData>
    +addPayment(input): Promise<Payment>
    +settleSplit(id): Promise<Split>
    +settleAllByRecipient(id): Promise<Count>
    +deleteSplit(id): Promise<boolean>
  }
  class WatchlistService
  class AttachmentRecordService
  class ImportBatchService
  class CustomParserConfigService
  class "portfolio/portfolioTransactionService" as PortfolioTransactionService {
    +create(input)
    +update(id, fields)
  }
  class "portfolio/portfolioTransactionRules" as PortfolioTransactionRules {
    +normalizeTransactionPayload(input, assetClass)
    +validateSellUnitsAvailability(input)
  }
  class PortfolioImportPipelineService <<ADR-078>>
  class PortfolioImportBatchService <<ADR-078>>
  class PortfolioImportCommitService {
    +commitReviewedPortfolioImport(batchId, accountId?)
    +commitReviewedPortfolioImports({batchIds, adoptPolicy?, batchPolicies?, expectedPlanFingerprint})
  }
  class PortfolioImportReadinessService {
    +assertPortfolioImportReadiness(batchId, batch, accountId?)
    +isMaintainedPortfolioImport(batch)
  }
  class PortfolioImportReconciliationService <<ADR-177>> {
    +previewPortfolioImportReconciliation(scope)
    +applyPortfolioImportReconciliation(scope)
    +validatePortfolioImportAdoptionRollback(batchId, history)
    +restorePortfolioImportAdoptions(receipts)
    +bounded paired-income proof + record/restore
  }
  class PortfolioIbkrCashReconciliation {
    +proveIbkrCashCorrections(rows, batches, context)
    +applyIbkrCashCorrection(action)
    +validateIbkrCashCorrectionRollback(receipts)
    +guarded original-fingerprint repeat aliases
  }
  class PortfolioKinesisCashScope <<ADR-189>> {
    +proveKinesisCashSources(rows, batches, fundingPolicy)
    +classifyKinesisCash(context)
    +complete source + account-ledger closure + component images
  }
  class PortfolioImportCashService <<ADR-189>> {
    +recordKinesisCash(member)
    +validateKinesisCashRollback(batchId)
    +one/two-component source receipt orchestration
  }
  class PortfolioAssetAdjustmentService <<ADR-177>> {
    +previewPortfolioAssetAdjustment(row, batch)
    +commitPortfolioAssetAdjustment(row, batch)
    +rollbackPortfolioAssetAdjustmentsForBatch(batchId)
  }
  class PortfolioImportDuplicateRepairService <<ADR-177>> {
    +applyDuplicatePortfolioRepair(input)
    +validateDuplicatePortfolioRepairRollback(receipts)
    +restoreDuplicatePortfolioRepairs(receipts)
  }
  class "portfolio/portfolioAssetTransferService" as PortfolioAssetTransferService <<ADR-177>> {
    +previewPortfolioAssetTransfer(row)
    +commitPortfolioAssetTransfer(row)
    +validatePortfolioAssetTransferHistory(history)
  }
  class "portfolio/portfolioCustodyImportScope" as PortfolioCustodyImportScope {
    +withPortfolioCustodyImportScope(input, work)
    +portfolioCustodyWriteHistory(history, event, client)
    +approved source/client binding + final full replay
  }
  class "shared-utils/portfolioCustody" as PortfolioCustody {
    +projectAssetTransferPartitions(events, opts)
    +original acquisition lots + purchase FX
  }
  class "portfolio/portfolioHistoryWriteService" as PortfolioHistoryWriteService {
    +withPortfolioHistoryWrite(accountIds, work)
  }
  class FxResolveService <<ADR-074, ADR-078>>
  class PortfolioSummaryService <<ADR-044, ADR-091, ADR-100>> {
    +getPortfolioSummary(currency, options?): Promise<Summary>
    ' Returns totals + summaries[] + byAccount[] (per-account holdings, parity-locked)
  }
  class PortfolioExposureService <<ADR-150>> {
    +upsertPortfolioExposureBundle(input): Promise<Sources>
    +getPortfolioExposure(currency): Promise<Exposure>
  }
  class "importPipeline/brokerageRouting" as BrokerageRouting
  class AccountMergeService <<ADR-088>>
  class AccountService
  class TagService
  class ReconcileService
  class TransferReconciliationService
  class PlannedMatchService
  class PlannedExecutionService
  class OpeningBalanceService
  class InsightsDigestService
}

' Relationships
ImportPipeline --> BankAdapters
ImportPipeline --> ImportIdentity
ImportPipeline --> RecipientPatternService
ImportPipeline --> RecipientRepository
ImportPipeline --> TransactionRepository
ImportPipeline --> ImportBatchRepository
ImportPipeline --> AggregationRefreshService

DataImportService --> TextNormalization

RecurringDetectionService --> TransactionRepository
RecurringDetectionService --> PlannedTransactionRepository

RecipientMergeService --> RecipientRepository
RecipientMergeService --> TransactionRepository
RecipientMergeService --> AggregationRefreshService

RecipientClusterService --> RecipientRepository
RecipientPatternService --> "recipient_match_patterns"

CurrencyConversionService --> "exchange_rates (rateFetcher)" : stored rates only
CommitmentAwareCashService --> PlannedTransactionRepository : pending dated bills
CommitmentAwareCashService --> CrossWorkspaceDataService : spendable computed balances
CommitmentAwareCashService --> CurrencyConversionService : stored recent FX
CommitmentAwareCashService --> RecurrenceCalc : expand bounded occurrences
PortfolioProjection --> PortfolioPerformanceSnapshotService : NAV history

PriceProviderService --> InvestmentRepository
PriceProviderService --> ProviderHealthService

QuoteBackfillService --> InvestmentRepository
QuoteBackfillService --> PriceProviderService

PortfolioPerformanceSnapshotService --> InvestmentRepository
PortfolioPerformanceSnapshotService --> PriceProviderService
PortfolioPerformanceSnapshotService --> CurrencyConversionService
PortfolioPerformanceSnapshotService --> PortfolioSummaryService

AnalysisCatalog --> AnalysisFinancialDatasets : enumerated service descriptors
AnalysisPivotService --> AnalysisCatalog : complete-source level plans
AnalysisPivotService --> AnalysisExecutor : one SQL snapshot
AnalysisPivotService --> AnalysisFinancialDatasets : one canonical source snapshot
SavedAnalysisService --> AnalysisFinancialDatasets : canonical source refresh
SavedAnalysisService --> AnalysisWorkbenchService : repeatable local pipeline
AnalysisFinancialDatasets --> PortfolioSummaryService : shared canonical replay
AnalysisExecutor --> AnalysisCatalog : validates approved relations
SavedAnalysisService --> AnalysisCatalog : compiles visual definitions
SavedAnalysisService --> AnalysisExecutor : refreshes saved runs
AnalysisMonitorScheduler --> AnalysisMonitorService : bounded due checks
AnalysisMonitorService --> SavedAnalysisService : one exact local run per check
note right of AnalysisMonitorService
  Reads current dossier evidence from PostgreSQL;
  it does not invoke document or provider fetches.
end note
note right of ResearchDossierService
  Uses the normal PostgreSQL connection and transaction.
  Validates live category, investment, saved-analysis,
  and document references directly before each write.
end note

AggregationRefreshService --> MaterializedViewService

AttachmentService --> AttachmentRepository

TransactionExport --> TransactionRepository
TransactionExport --> FilterBuilder

BulkSelection --> TransactionRepository
BulkSelection --> FilterBuilder

PortfolioTransactionService --> PortfolioTransactionRules
PortfolioTransactionService --> PortfolioTransactionRepository
PortfolioImportPipelineService --> PortfolioTransactionService
PortfolioImportPipelineService --> ImportIdentity
PortfolioImportCommitService --> PortfolioImportPipelineService : atomic chronological selected-row drain
PortfolioImportCommitService --> PortfolioImportReadinessService : maintained source preflight
PortfolioImportCommitService --> PortfolioCustodyImportScope : locked reviewed chronology
PortfolioCustodyImportScope --> PortfolioAssetTransferService : final full-history validation
PortfolioAssetTransferService --> PortfolioCustodyImportScope : approved dated prefix
PortfolioAssetAdjustmentService --> PortfolioCustodyImportScope : approved dated prefix
PortfolioImportCommitService --> PortfolioImportBatchRepository : batch lock + account
PortfolioImportReadinessService --> PortfolioImportBatchRepository : complete staging
PortfolioImportCommitService --> PortfolioImportReconciliationService : current reviewed plan
PortfolioImportReconciliationService --> PortfolioImportReconciliationRepository : CAS + immutable receipts
PortfolioImportReconciliationService --> PortfolioIbkrCashReconciliation : native funding correction + cash restore
PortfolioIbkrCashReconciliation --> PortfolioImportCashRepository : financial images + typed journal
PortfolioImportReconciliationService --> PortfolioKinesisCashScope : closed cash-only source proof
PortfolioImportReconciliationService --> PortfolioImportCashService : selected cash writer + guarded rollback
PortfolioImportCashService --> PortfolioKinesisCashScope : typed proof + component image comparison
PortfolioImportCashService --> PortfolioImportCashRepository : canonical main/fee persistence
PortfolioImportCashService --> PortfolioImportReconciliationRepository : source settlement + retained envelopes

PortfolioImportReconciliationService --> PortfolioImportDuplicateRepairService : explicit-policy repair of prior copy
PortfolioImportDuplicateRepairService --> PortfolioImportDuplicateRepairRepository : all-image CAS + inverse receipt
PortfolioImportReconciliationService --> PortfolioAssetTransferService : full projected history
PortfolioImportPipelineService --> PortfolioAssetTransferService : transfer route
PortfolioAssetTransferService --> PortfolioAssetTransferRepository : canonical event
PortfolioAssetTransferService --> PortfolioCustody : FIFO / LIFO / weighted-average lots
PortfolioImportReconciliationService --> PortfolioAssetAdjustmentService : source-proven removals
PortfolioImportPipelineService --> PortfolioAssetAdjustmentService : adjustment route
PortfolioAssetAdjustmentService --> PortfolioAssetAdjustmentRepository : ledger + restrictive evidence links
PortfolioAssetAdjustmentService --> PortfolioCustody : eligible zero-yield / carried-basis lots
PortfolioSummaryService --> PortfolioCustody : account partition replay
PortfolioPerformanceSnapshotService --> PortfolioCustody : historical replay
PortfolioTransactionService --> PortfolioHistoryWriteService : shared account/history locks
PortfolioTransactionService --> PortfolioAssetTransferService : validate edits against custody
PortfolioExposureService --> PortfolioSummaryService : current position values
PortfolioExposureService --> PortfolioExposureRepository : explicit sources

AiChatService --> AiChatRepository
AiChatService --> "Ollama client"
AiChatService --> TransactionRepository
AiChatService --> InfoRepository : canonical cash flow
AiChatService --> PortfolioSummaryService : canonical portfolio metrics

AiInvestigationService --> AiProviderAdapters : local Ollama generation
AiProviderAdapters --> "Ollama client"
AiInvestigationService --> AiInvestigationRepository : answer checkpoint

ProviderHealthService --> ProviderHealthRepository

@enduml
