@startuml Service Layer Architecture
title Service Layer Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

package "Import Pipeline" {
  class ImportPipeline {
    +createBatch(stream, adapter): Promise<Batch>
    +stageBatch(batchId): Promise<void>
    +validateBatch(batchId): Promise<ValidationResult>
    +matchBatch(batchId): Promise<MatchResult>
    +commitBatch(batchId, overrides): Promise<CommitResult>
  }

  class DataImportService {
    +importRecipientsCSV(path, opts): Promise<ImportResult>
    +importCategoriesCSV(path, opts): Promise<ImportResult>
  }

  class StreamingImportService {
    +streamImport(stream, handler): Promise<void>
    note bottom: Deprecated (Phase C) —\nfolded into ImportPipeline.
  }

  class RawTransactionImportService {
    +importCSVWithRawStorage(filePath, bankName, config): Promise<ImportResult>
    note bottom: Deprecated (Phase C) —\nfolded into ImportPipeline.
  }
}

package "Business Logic Services" {
  class RecurringDetectionService {
    +detectRecurring(): Promise<RecurringPattern[]>
    +detectRecurringPatterns(): Promise<RecurringPattern[]>
  }

  class "calculations/recurrence" as RecurrenceCalc {
    +generateOccurrences(startDate, pattern, endDate): Date[]
    +getNextOccurrence(date, pattern): Date
    +parseRecurrencePattern(patternStr): RecurrenceConfig
    note bottom: formerly recurrenceService.js
  }

  class "calculations/loanSchedule" as LoanScheduleCalc {
    +generateLoanRepaymentSchedule(config): LoanSchedule
    +validateLoanConfig(config): ValidationResult
    +calculateMonthlyPayment(principal, rate, months): number
    note bottom: formerly loanRepaymentService.js
  }

  class "calculations/forecast/*" as ForecastCalc {
    +holtWinters(series, opts): Series
    +prophetLite(series, opts): Series
    +weightedAverage(series, opts): Series
    +monteCarloEnsemble(opts): Paths
  }

  class "portfolio/rebalanceTargets" as RebalanceTargets {
    +resolveRebalanceTargetWeights(body): TargetWeights
    note bottom: Validates explicit weights or model presets,\nfolds aliases, then normalizes.
  }

  class DeduplicationService {
    +isDuplicateByFields(date, amount, recipient, memo): Promise<boolean>
    +findDuplicates(criteria): Promise<Transaction[]>
  }

  class RecipientMergeService {
    +mergeRecipients(primaryId, duplicateIds): Promise<MergeResult>
    +unmergeRecipient(id): Promise<boolean>
  }

  class RecipientClusterService {
    +findClusters(opts): ClusterList
  }

  class RecipientPatternService {
    +inferRecipientFromRow(row): RecipientHint
  }

  class FilterBuilder {
    +buildTransactionWhere(filters): { sql, params }
  }

  class BulkSelection {
    +resolveSelection({ ids?, filter? }): IdSet
  }
}

package "External / Data" {
  class "currency/CurrencyConversionService" as CurrencyConversionService {
    +convert(amount, from, to): Promise<number>
    +getExchangeRate(from, to): Promise<number>
    +warmCache(): Promise<void>
  }

  class PriceProviderService {
    +fetchLivePricesDetailed(investments): Promise<PriceMap>
    +updateInvestmentPrices(): Promise<UpdateResult>
  }

  class BelgianInflationService {
    +getInflationRates(opts): Promise<InflationRate[]>
    +warmInflationCache(): Promise<void>
  }

  class PortfolioPerformanceSnapshotService {
    +computeAndStoreSnapshots(currency): Promise<void>
    +getSnapshots(start, end, currency): Promise<Snapshot[]>
  }

  class QuoteBackfillService {
    +backfillPortfolioHistoricalRates(): Promise<void>
    +backfillQuotes(symbols, range): Promise<void>
  }

  class BankAdapters {
    +createAdapter(bankName, config): BankParser
    +getSupportedBanks(): string[]
  }
}

package "Storage & Performance" {
  class MaterializedViewService {
    +refreshMaterializedViews(): Promise<void>
    +scheduleRefresh(): void
  }

  class AggregationRefreshService {
    +scheduleAggregationRefresh(): void
    +refreshPhase1Views(): Promise<void>
    +cancelPendingAggregationRefresh(): void
  }

  class AttachmentService {
    +storeAttachment(txId, file): Metadata
    +streamAttachment(id): Stream
    +removeAttachment(id): void
  }

  class TransactionExport {
    +streamCsv(res, filters): void
    +streamNdjson(res, filters): void
  }
}

package "AI & Observability" {
  class AiChatService {
    +respond(messages, tools): Stream
    +dispatchTool(name, args): ToolResult
  }

  class ProviderHealthService {
    +recordSuccess(provider, latency): void
    +recordError(provider, err): void
    +probe(provider): ProbeResult
    +getSummary(): Summary
  }

  class RouteManifest {
    +buildManifest(app): Route[]
  }
}

package "Supporting" {
  class TextNormalization {
    +normalizeForMatching(text): string
    +cleanRecipientName(name): string
    +cleanKbcRecipientName(name): string
  }

  class IBANService {
    +normalizeIban(iban): string
    +isValidIban(iban): boolean
  }
}

package "Thin Route Seams (ADR-067, June 2026)" {
  note "14 new thin seam services created to enforce\nroute→service boundary (no-repo-direct-from-route ERROR).\nEach delegates to the matching repository; exists to\nprovide a stable extension point." as SeamNote
  class CategoryService { +list() +create() +update() +delete() }
  class TransactionService { +list() +create() +update() +delete() }
  class RecipientService { +list() +create() +update() +merge() }
  class RecipientBankAccountService { +list() +create() +delete() }
  class SavedChartsService { +list() +create() +update() +delete() }
  class InfoService { +getSummary() +getNetWorth() +getMonthly() }
  class PlannedTransactionService { +list() +create() +update() +execute() }
  class SettingsService { +get() +set() }
  class SplitService { +list() +create() +settle() }
  class WatchlistService { +list() +create() +update() +delete() }
  class AttachmentRecordService { +list() +delete() }
  class ImportBatchService { +listBatches() +getBatch() +getImportBatchPreview() +rollbackBatch() }
  class ImportBatchRoutes { +registerImportBatchRoutes(router, options) }
  class CustomParserConfigService { +list(kind) +create(kind) +update() +delete() }
  class PortfolioTxService { +create() +update() +delete() }
  class PortfolioImportPipelineService <<ADR-078>> { +runPortfolioImportPipeline(opts) +commitPortfolioImport(batchId, accountId?) }
  class PortfolioImportBatchService <<ADR-078>> { +listBatches() +getBatch() +getPortfolioImportBatchPreview() +overrideInvestment() +resolveInvestmentRows() +rollbackBatch() }
  class FxResolveService <<ADR-074, ADR-078>> { +resolveRate(currency, date): Promise<number> }
  class PortfolioSummaryService <<ADR-044, ADR-091, ADR-100>> {
    +getPortfolioSummary(currency): Promise<Summary>
    ' Returns totals + summaries[] + byAccount[] (per-account holdings, parity-locked)
  }
  class MoveHoldingService <<ADR-091>> {
    +move(investmentId, fromAccountId, toAccountId, units?, strategy?): Promise<MoveResult>
    ' strategy: 'fifo' (default) | 'proportional'
  }
  class BrokerageFanoutService <<ADR-095>> {
    +planBrokerageFanout(rows, accountId): FanoutPlan
    +commitBrokerageFanout(plan, db): Promise<CommitResult>
    ' Core built; parser/staging/review UI not yet wired
  }
  class AccountMergeService <<ADR-088>> { +merge(survivorId, sourceIds): Promise<MergeResult> }
}

' Relationships
ImportPipeline --> BankAdapters
ImportPipeline --> DeduplicationService
ImportPipeline --> RecipientPatternService
ImportPipeline --> RecipientRepository
ImportPipeline --> TransactionRepository
ImportPipeline --> ImportBatchRepository
ImportPipeline --> MaterializedViewService

DataImportService --> TextNormalization

RecurringDetectionService --> TransactionRepository
RecurringDetectionService --> PlannedTransactionRepository

RecipientMergeService --> RecipientRepository
RecipientMergeService --> TransactionRepository
RecipientMergeService --> AggregationRefreshService

RecipientClusterService --> RecipientRepository
RecipientPatternService --> RecipientRepository
RecipientPatternService --> IBANService
RecipientPatternService --> TextNormalization

CurrencyConversionService --> TransactionRepository

PriceProviderService --> InvestmentRepository
PriceProviderService --> ProviderHealthService

QuoteBackfillService --> InvestmentRepository
QuoteBackfillService --> PriceProviderService

PortfolioPerformanceSnapshotService --> InvestmentRepository
PortfolioPerformanceSnapshotService --> PriceProviderService
PortfolioPerformanceSnapshotService --> CurrencyConversionService

AggregationRefreshService --> MaterializedViewService

AttachmentService --> AttachmentRepository

TransactionExport --> TransactionRepository
TransactionExport --> FilterBuilder

BulkSelection --> TransactionRepository
BulkSelection --> FilterBuilder

AiChatService --> AiChatRepository
AiChatService --> "Ollama client"
AiChatService --> TransactionRepository

ProviderHealthService --> ProviderHealthRepository

@enduml
