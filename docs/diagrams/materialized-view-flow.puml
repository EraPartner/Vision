@startuml Materialized View Refresh Flow
title Materialized View Refresh Flow

!theme plain
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50

package "Backend" {
  class MaterializedViewService {
    +refreshMaterializedViews(): Promise<void>
    +createMaterializedViews(): Promise<void>
    +ensureMaterializedViewIndexes(): Promise<void>
  }

  class SchemaInit {
    +initializeSchema(): Promise<void>
    +checkVersion(): Promise<boolean>
  }
}

database "PostgreSQL" as DB {
  node "Materialized Views" as MatViews {
    view "mv_monthly_summary"
    view "mv_category_totals"
    view "mv_cashflow_daily"
    view "mv_bank_balances"
  }

  node "Indexes" as Indexes {
    idx_mv_monthly_summary
    idx_mv_category_totals
    idx_mv_cashflow_daily
    idx_mv_bank_balances
  }
}

package "External" as External {
  class StartupHook
  class ScheduledRefresh
  class ImportCompletion
}

' Startup refresh
External --> SchemaInit : App startup
SchemaInit --> MaterializedViewService : check version
alt Schema version match
  MaterializedViewService --> MatViews : REFRESH MATERIALIZED VIEW
else Schema changed
  MaterializedViewService --> MatViews : CREATE MATERIALIZED VIEW
  MaterializedViewService --> Indexes : CREATE INDEX
end

MatViews --> DB : refreshed

' Scheduled refresh (optional)
ScheduledRefresh --> MaterializedViewService : 12h cron
MaterializedViewService --> MatViews : CONCURRENTLY refresh

' Import-triggered refresh
ImportCompletion --> MaterializedViewService : After CSV import
MaterializedViewService --> MatViews : CONCURRENTLY refresh

note right of MaterializedViewService
  Views:
  - mv_monthly_summary
  - mv_category_totals
  - mv_cashflow_daily
  - mv_bank_balances
   
  CONCURRENTLY option for
  non-locking refresh
   
  Refreshed on:
  - App startup (after schema init)
  - After import (scheduleRefresh - debounced 1s)
  - 12h exchange rate refresh
  
  Coalesces rapid calls
  (refreshInFlight flag)
end note

@enduml