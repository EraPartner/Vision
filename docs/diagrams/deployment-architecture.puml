@startuml Deployment Architecture
title Deployment Architecture — Native macOS, Native Demo, and Optional Docker

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

actor "User" as User

package "Native macOS (default)" as NativeMac {
  node "Vision.app / Electron" as ElectronNative {
    component "Electron main + renderer" as ElectronUI
    component "Native runtime provider" as NativeProvider
    component "Compiled Bun backend" as NativeBackend
    component "Production frontend (dist)" as NativeFrontend
    component "PostgreSQL 18.6 binaries" as NativePostgresBinaries
    component "Migration executable" as NativeMigrations
    component "Chrome Headless Shell" as NativeChrome
  }
  database "Vision-managed PostgreSQL 18.6\n127.0.0.1:54329" as NativePostgres
  folder "Application Support/Vision/native/vision" as NativeData {
    folder "postgres/data" as NativePostgresData
    folder "attachments" as NativeAttachments
    folder "logs + runtime marker" as NativeState
  }
  node "Local Ollama\n127.0.0.1:11434" as NativeOllama
}

package "Native Vision Demo (synthetic)" as NativeDemo {
  node "Vision Demo.app" as DemoElectron {
    component "Electron + shared native payload" as DemoRuntime
    artifact "demo-seed.dump\n+ validation manifest" as DemoSeed
  }
  database "Isolated Demo PostgreSQL 18.6\n127.0.0.1:54330" as DemoPostgres
  folder "Application Support/Vision Demo/native/vision_demo" as DemoData {
    folder "postgres/data" as DemoPostgresData
    folder "attachments + logs + seed marker" as DemoState
  }
}

package "Source Development" as SourceDev {
  component "Vite frontend" as FrontendDev
  component "Bun backend" as BackendDev
  component "Electron shell" as ElectronDev
  database "Managed development PostgreSQL 18.6\nVision Development data" as DevelopmentPostgres
}

package "Optional Docker Compose" as DockerDeployment {
  node "Docker host" as DockerHost {
    rectangle "app" as AppContainer {
      component "Bun backend + production frontend" as DockerApp
    }
    rectangle "db" as DBContainer {
      database "PostgreSQL 18" as DockerPostgres
      folder "postgres_data volume" as DockerData
    }
    folder "attachments volume" as DockerAttachments
  }
}

package "Browser Production" as BrowserProduction {
  node "TLS reverse proxy" as Proxy
  component "Vision backend + frontend" as HostedApp
  database "PostgreSQL 18" as HostedPostgres
}

cloud "External data providers" as External

User --> ElectronUI : Desktop UI
ElectronUI --> NativeProvider : lifecycle / IPC
NativeProvider --> NativeBackend : spawn / stop / logs
NativeProvider --> NativePostgresBinaries : verify / spawn / stop
NativeProvider --> NativeMigrations : schema runner
NativeBackend --> NativeFrontend : static files
NativeBackend --> NativePostgres : owner migration / app role
NativePostgres --> NativePostgresData : durable cluster
NativeBackend --> NativeAttachments : absolute durable path
NativeBackend --> NativeChrome : PDF rendering
NativeBackend --> NativeOllama : local AI
NativeBackend --> External : HTTPS

User --> DemoRuntime : synthetic desktop UI
DemoRuntime --> DemoSeed : verify checksum / schema / counts
DemoRuntime --> DemoPostgres : staged restore + backend lifecycle
DemoPostgres --> DemoPostgresData : isolated durable cluster
DemoRuntime --> DemoState : attachments / logs / activation state

User --> ElectronDev : development UI
ElectronDev --> BackendDev : native provider
FrontendDev --> BackendDev : loopback HTTP
BackendDev --> DevelopmentPostgres : isolated development database

User --> AppContainer : explicit Docker provider
DockerApp --> DockerPostgres
DockerPostgres --> DockerData
DockerApp --> DockerAttachments
DockerApp --> External : HTTPS

User --> Proxy : HTTPS
Proxy --> HostedApp
HostedApp --> HostedPostgres
HostedApp --> External : HTTPS

NativeProvider ..> AppContainer : opt-in cutover source
AppContainer ..> NativeProvider : custom dump + attachment export

note right of NativeProvider
  Runtime marker prevents split-brain.
  Existing Docker data requires a verified,
  explicit import before native activation.
end note

note right of NativePostgres
  Private data is outside Vision.app.
  Separate admin, owner/migration, and app roles.
  Required extensions and Alembic schema.
end note

note right of NativeDemo
  Demo always selects native and never reads Vision data.
  First launch, reset, or seed change activates a
  deterministic custom dump with rollback until detailed
  readiness succeeds (ADR-114).
end note

note right of DockerDeployment
  Compose remains supported and shares
  application, migration, and backup logic.
  Cutover stops but never removes this source.
end note

@enduml
