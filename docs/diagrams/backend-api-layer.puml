Main --> TransactionsRouter
Main --> CategoriesRouter
Main --> RecipientsRouter
Main --> RecipientBankAccountsRouter
Main --> PlannedTransactionsRouter
Main --> InvestmentsRouter
Main --> ImportRouter
Main --> PortfolioImportRouter
PortfolioImportRouter --> PortfolioUpload : CSV / XLSX upload
Main --> SettingsRouter
Main --> WatchlistRouter
Main --> SavedChartsRouter
Main --> AnalysisRouter
Main --> AnalysisMonitorsRouter : /api/analysis/monitors before /api/analysis
Main --> ResearchDossiersRouter
Main --> SplitsRouter
Main --> MarketLookupRouter
Main --> InfoRouter
Main --> AdminRouter
Main --> InternalAuditRouter : /api/internal/audit
Main --> AggregationsRouter
Main --> BelgianTaxRouter : /api/belgian-tax\nglobal + aggregation limiter
Main --> ReportsRouter
Main --> AiRouter
Main --> AiResearchRouter : /api/ai-research
Main --> AttachmentsRouter
Main --> TagsRouter
Main --> AccountsRouter : /api/accounts
Main --> CrossWorkspaceRouter : /api/cross-workspace
Main --> ResearchRouter : /api/research\nmarket limiter
Main --> AiResearchDocumentsRouter : /api/ai-research/documents\nattachment limiter
