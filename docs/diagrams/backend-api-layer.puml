@startuml API Route Layer Architecture
title API Route Layer Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70

package "Express Application" {
  class Main {
    -app: Express
    +start(): Promise<void>
  }
}

package "Middleware" {
  class RateLimiter {
    +globalRateLimiter: mounted on /api before all routers\n  (RATE_LIMIT_GLOBAL_MAX=1000/min, RATE_LIMIT_GLOBAL_WINDOW_MS=60000)\n  per-route limiters stack on top — June 2026
    +resolveClientIp(req): trusts XFF only from TRUSTED_PROXIES — June 2026
    +adminRateLimiter: 500/min observability reads
    +adminMutateLimiter: 30/min destructive ops
    +importRateLimiter: 20/min
    +reportRateLimiter: 30/min (Puppeteer)
    +marketRateLimiter: 90/min (Yahoo Finance proxy)
    +investmentRateLimiter: 300/min
    +aggregationRateLimiter: 600/min
    +attachmentRateLimiter: 60/min
    +spaRateLimiter: 600/min (SPA fallback)
    +ipMatchesRule(ip, rule): CIDR/IP matching for TRUSTED_PROXIES
    note: dev bypasses gated on VISION_DEV=true (fail-safe) — June 2026
  }

  class ValidationMiddleware {
    +assertIdParam(req, name): number
    +validateIdParam(req, res, next): void
    +validateIntParam(name): Middleware
    note: remaining users: categories /tree/:id, plannedTransactions,\n  research, savedCharts, parserConfigRoutes (ADR-193)
  }

  class PortfolioUpload {
    +portfolioUpload: CSV / XLSX, 50 MiB
    +readPortfolioWorkbook: bounded ZIP + typed provenance
  }


  class Security {
    +hostGuard: exact destination authority before CORS, body parsing, health and routes; SERVER_ALLOWED_HOSTS adds explicit hosts
    +cors: middleware/cors.ts (strict allowlist, replaces cors package)
    +compression: middleware/compression.ts (node:zlib, replaces compression package)
    +securityHeaders: middleware (inline in main.ts)
    +requestLogger: middleware (inline in main.ts)
    +adminAuth middleware (token-or-open: timing-safe Bearer when ADMIN_AUTH_TOKEN set, open otherwise — ADR-063)
    +csrfGuard middleware (Sec-Fetch-Site / Origin allowlist; blocks cross-site state-changing requests to /api)
  }
}

package "Validation library" {
  class PureValidation {
    +sanitizeUpdateFields(table, fields): SanitizedFields
    +validateId(id): ValidationResult
    +validateNumber(value): ValidationResult
    +validateDateString(value): ValidationResult
    +validateIntArray(value): number[]
  }

  class RequestInput {
    +parseInput(schema, value, {prefix, separator, omitPaths}): output
    +formatZodIssues(error, separator, omitPaths): string
    +guardField(guard) / bareMessages(schema): zod field
    +routes/_requestSchemas.ts: idParams, idSchema, booleanQuery, clampedIntQuery, pageFields
    +routes/_inputBridges.ts, routes/_importInput.ts: legacy-text bridges
    note: lib/zodInput.ts; handlers parse params/query/body -> 400 VALIDATION_ERROR (ADR-193)
  }
}

package "Routes" {
  class TransactionsRouter {
    +GET / : list transactions
    +GET /export/csv : export transactions
    +GET /export/json : export transactions as JSON
    +GET /transfer-suggestions : candidate transfer pairs
    +POST /transfers : mark transfer pair
    +DELETE /transfers/:id : unmark transfer pair
    +POST /bulk-tag : add/remove tags on up to 500 transactions
    +POST /bulk-delete : up to 500 ids OR 5000 filter matches
    +POST /bulk-update : category / recipient / active update
    +POST /bulk-export : CSV / NDJSON streamed export
    +GET /:id : get transaction
    +POST / : create transaction
    +PATCH /:id : update transaction
    +DELETE /:id : delete transaction
  }

  class CategoriesRouter {
    +GET / : list categories
    +GET /tree : list ordered category paths
    +POST /tree : create category node
    +GET /tree/:id : get category node
    +PATCH /tree/:id : rename or move node
    +POST /tree/:id/merge : merge category nodes
    +DELETE /tree/:id : delete leaf node
    +GET /:id : get category
    +POST / : create category
    +PATCH /:id : update category
    +DELETE /:id : delete category
    +POST /:id/assign : assign recipients to category
  }

  class RecipientsRouter {
    +GET / : list recipients
    +GET /:id : get recipient
    +POST / : create recipient
    +PATCH /:id : update recipient
    +DELETE /:id : delete recipient
    +POST /:id/merge : merge recipients
    +POST /:id/unmerge : unmerge recipient
    +GET /:id/aliases : get aliases
    +GET /clusters : recipient clusters
    +GET,POST /:id/patterns : list/create match patterns
    +POST /:id/patterns/preview : preview pattern matches
    +PATCH,DELETE /:id/patterns/:patternId : edit/delete pattern
  }

  class RecipientBankAccountsRouter <<nested under /api/recipients>> {
    +GET /:id/bank-accounts : list bank accounts
    +POST /:id/bank-accounts : create bank account
    +PATCH /:id/bank-accounts/:accountId : update
    +DELETE /:id/bank-accounts/:accountId : soft delete
    +POST /:id/bank-accounts/:accountId/set-primary : set primary
  }

  class PlannedTransactionsRouter {
    +GET / : list planned transactions
    +GET /due-soon : upcoming planned transactions
    +GET /totals : planned totals
    +GET /match-suggestions : candidate transaction matches
    +GET /:id : get planned transaction
    +POST / : create planned transaction
    +PATCH /:id : update planned transaction
    +DELETE /:id : delete planned transaction
    +POST /:id/execute : execute planned transaction
  }

  class InvestmentsRouter {
    +GET / : list investments
    +GET /providers : list price providers
    +POST /refresh-prices : bulk refresh prices
    +GET /transactions : list all portfolio transactions
    +PUT /transactions/broker : retag broker
    +GET /exposure : aggregate explicit look-through exposure
    +PUT /exposure/sources : upsert classifications and fund documents
    +GET /:id/price-history : provider-backed historical prices
    +GET /:id : get investment
    +POST / : create investment
    +PATCH /:id : update investment
    +DELETE /:id : delete investment
    +GET /:id/transactions : list portfolio transactions
    +POST /:id/transactions : create portfolio transaction
    +PATCH /transactions/:txnId : update portfolio transaction
    +GET /:id/summary : get investment summary
    +DELETE /transactions/:txnId : delete portfolio transaction
  }

  class ImportRouter {
    +POST /csv : import CSV
    +POST /csv/custom : import with custom config
    +POST /csv/stream : SSE streaming import
    +POST /recipients : bulk import recipients
    +POST /categories : bulk import categories
    +GET /batches : list transaction import batches
    +GET /batches/:id : get transaction import batch
    +DELETE /batches/:id : rollback transaction import batch
    +GET /batches/:id/preview : preview rows grouped by recipient
    +POST /batches/:id/rows/:rowId/override : override recipient
    +POST /batches/:id/rows/:rowId/category-override : override category
    +POST /batches/:id/commit : commit reviewed batch
    +GET,POST /parsers; PATCH,DELETE /parsers/:id : custom parser configs
  }

  class ImportBatchRoutes {
    +registerImportBatchRoutes(router, options)
  }

  class PortfolioImportRouter <<ADR-078>> {
    +POST /csv/custom : one-shot CSV / Saxo XLSX import (201|202)
    +POST /csv/stream : CSV / Saxo XLSX preflight before SSE
    +POST /probe : detect portfolio file format
    +GET /parsers : list portfolio parser configs
    +POST /parsers : create portfolio parser config
    +PATCH /parsers/:id : update portfolio parser config
    +DELETE /parsers/:id : delete portfolio parser config
    +GET /batches : list portfolio import batches
    +GET /batches/:id : get portfolio import batch
    +DELETE /batches/:id : rollback portfolio import batch
    +GET /batches/:id/preview : preview rows grouped by investment
    +POST /batches/:id/rows/investment-override : resolve review group atomically
    +POST /batches/:id/rows/:rowId/investment-override : resolve unmatched row
    +POST /batches/:id/commit : atomic maintained reviewed commit
    +POST /reconciliation/preview : reviewed multi-batch plan
    +POST /reconciliation/commit : fingerprint-pinned atomic scope
  }

  class SettingsRouter {
    +GET / : get all settings
    +GET /:key : get single setting
    +PUT /:key : upsert single setting
    +PUT / : bulk upsert
    +DELETE /:key : delete setting
  }

  class WatchlistRouter {
    +GET / : list watchlist
    +GET /:id : get item
    +POST / : add item
    +PATCH /:id : update item
    +DELETE /:id : remove item
  }

  class SavedChartsRouter {
    +GET / : list charts
    +POST / : create chart
    +PATCH /:id : update chart
    +DELETE /:id : delete chart
  }

  class AnalysisRouter <<ADR-144>> {
    +GET /catalog : approved fields, measures, joins
    +POST /compile : visual plan to SQL
    +POST /execute : bounded read-only query
    +POST /pivot : pivot query
    +POST /extensions/evaluate, /formulas/evaluate : evaluate expressions
    +POST /ai-proposals/preview, /ai-proposals/apply : AI plan proposals
    +POST /interchange/import, /interchange/export : workbook interchange
    +POST /cancel/:requestId : cancel query
    +POST /drill : contributing records
    +GET,POST /saved : list/create analyses
    +GET,PUT,DELETE /saved/:id : read/version/delete
    +GET /saved/:id/versions, POST /saved/:id/restore : history
    +POST /saved/:id/run : refresh and record state
  }

  class ResearchDossiersRouter <<ADR-153>> {
    +GET,POST / : summaries/create
    +GET,PUT,DELETE /:id : read/version/delete
    +GET /:id/versions : immutable history
    +POST /:id/restore : append restoration
    +GET /export,/:id/export : JSON snapshots
  }

  class AnalysisMonitorsRouter <<ADR-154>> {
    +GET,POST / : list/create rules
    +PATCH,DELETE /:id : edit/delete rule
    +POST /:id/check : persist manual observation
    +GET /:id/observations : paged history
    +GET /notifications : paged inbox
    +POST /notifications/:id/read : read inbox entry
  }

  class SplitsRouter {
    +GET /owed : get owed summary
    +GET /owed/:id : get owed by recipient
    +GET /owed/:id/export/csv : export owed CSV by recipient
    +POST /owed/:id/settle-all : settle all splits by recipient
    +GET /transaction/:id : get splits for transaction
    +POST / : create split
    +POST /batch : create batch splits
    +POST /bulk : bulk split creation
    +POST /:id/pay : record payment
    +POST /:id/settle : settle split
    +GET /:id/payments : get payments for split
    +DELETE /:id : delete split
  }

  class MarketLookupRouter {
    +GET /search : search tickers
    +GET /quote : get quotes
    +GET /chart : historical chart data
    +GET /news : market news
  }

  class InfoRouter {
    +GET / : get statistics
    +GET /banks : list transaction bank-account labels
    +GET /supported-adapters : list supported adapters
    +GET /transaction-count : get transaction count
    +GET /transaction-summary : get transaction summary
    +GET /monthly-summary : get monthly summary
    +GET /planned-expenses-next-month : get planned expenses
    +GET /average-vs-current-spending : compare spending
    +GET /cashflow-comparison : compare cashflow
    +GET /category-breakdown : breakdown, optional ancestor_category_id
    +GET /bank-balances : get bank balances
    +GET /recurring-patterns : get recurring patterns
    +GET /net-worth : get net worth
    +GET /recipient-insights : get recipient insights
    +GET /exchange-rates : get exchange rates
    +POST /exchange-rates/refresh : refresh exchange rates
    +GET /inflation-rates : get inflation rates
    +POST /inflation-rates/refresh : refresh inflation rates
    +POST /refresh-views : refresh materialized views (admin limiter)
    +GET /portfolio-performance : get performance snapshots
  }

  class AdminRouter {
    +GET / : admin status
    +POST /database/init : init check
    +POST /database/reset : reset DB
    +GET /update/check : check for updates
    +POST /update/apply : apply update
    +POST /update/apply-and-restart : apply and restart
    +POST /investments/kinesis/sanitize-history : sanitize Kinesis spikes
    +GET /database/stats : database table statistics
    +POST /database/vacuum : run VACUUM ANALYZE
    +GET /database/tables/:table/schema : column schema + PK discovery (ADR-101)
    +GET /database/tables/:table/rows : paginated/filtered/sorted read; READ ONLY txn (ADR-101)
    +POST /database/tables/:table/mutate : batch insert/update/delete; dryRun; xmin OCC (ADR-101)
    +GET /providers/health : provider health summary (Phase F, ADR-034)
    +POST /providers/:provider/probe : synthetic probe
    +GET /metrics/requests : in-memory rolling p50/p95 (Phase F)
    +GET /endpoints : live route manifest (Phase F)
    +GET /endpoint-liveness : route manifest with liveness
    +/api/admin/* : timing-safe bearer auth (ADR-037)
  }

  class InternalAuditRouter <<Electron main only>> {
    +POST /verify : full chain and domain-link check
    +POST /read : verified bounded page
    +POST /checkpoint : persist local-receipt metadata
    +POST /retention-plan : eligible one-year prefix
    +POST /retention-prune : signed atomic prefix removal
    +POST /update-decision : append updater decision
    +socket peer must be loopback
    +per-launch VISION_AUDIT_BRIDGE_TOKEN Bearer
  }

  class AggregationsRouter {
    +GET /monthly-summary : monthly aggregations
    +GET /category-breakdown : category totals
    +GET /recipient-insights : top merchants
    +GET /cashflow-comparison : cash flow comparison
    +GET /average-vs-current : avg vs current spending
    +GET /bank-balances : account balances
    +GET /cashflow-forecast : N-month forecast (Phase 6)
    +GET /cashflow-forecast-methods, /cashflow-forecast-rolling, /cashflow-forecast-accuracy
    +GET /sankey : income flow diagram (Phase 7)
    +GET /category-pivot, /recipient-by-year, /recipient-pivot, /tag-pivot
  }

  class BelgianTaxRouter {
    +GET /overview : live/historical frozen figures + CAS baselines
    +GET /dashboard : server-computed charts + recorded taxes/shares
    +POST /compute : stateless household preview
    +GET /portfolio-dashboard : portfolio tax dashboard
  }

  class ReportsRouter <<Phase 3-8>> {
    +POST /financial : PDF financial report (7 sections, Puppeteer)
    +POST /portfolio : PDF portfolio report (6 sections, Phase 8)
    +POST /tax : PDF tax report (7 sections, Phase 8)
  }

  class AiRouter <<ADR-024>> {
    +POST /chat : Ollama tool-loop chat (rate-limited via AI_CHAT_RATE_LIMIT)
    +POST /chat/stream : SSE chat
    +GET /status : Ollama reachability + config
    +GET /models : list models
    +GET,POST /conversations : list/create conversations
    +GET,PATCH,DELETE /conversations/:id : read/rename/delete conversation
  }

  class AiResearchRouter <<ADR-145, ADR-229>> {
    +GET /status : local research status
    +GET,POST /investigations; GET,DELETE /investigations/:id
    +POST /investigations/:id/resume, /investigations/:id/cancel
  }

  class AiResearchDocumentsRouter {
    +GET,POST / : list/upload documents
    +GET,DELETE /:id : read/delete document
    +POST /search/passages : passage search
  }

  class AccountsRouter {
    +GET / , /totals, /:id : list/totals/get accounts
    +POST / : create account
    +PATCH,DELETE /:id : update/delete account
    +GET /:id/portfolio-lot-retag-preview, /:id/merge-preview
    +POST /:id/close, /:id/merge, /:id/opening-balance, /:id/reconcile
    +PUT,DELETE /:id/statement-balances/:currency
  }

  class CrossWorkspaceRouter {
    +POST /commitment-aware-cash : commitment-aware cash view
    +POST /rebalance : rebalance plan
  }

  class ResearchRouter {
    +GET /search, /quote, /chart, /fundamentals, /analyst, /news
    +GET /macro/search, /macro/series, /scorecard
    +POST /portfolio-forecast, /presentation
    +GET,POST /mappings; POST /mappings/resolve, /mappings/audit; DELETE /mappings/:id
    +GET /provider-keys; PUT,DELETE /provider-keys/:provider
  }

  class AttachmentsRouter <<Phase 5A>> {
    +POST /transaction/:id : upload receipt (attachmentRateLimiter 60/min)
    +GET /transaction/:id : list attachments
    +GET /:id/download : stream attachment (RFC 5987 filename, ADR-036)
    +DELETE /:id : delete attachment + file
  }

  class TagsRouter <<ADR-052>> {
    +GET / : list tags (?is_active)
    +POST / : find-or-create by slug
    +PATCH /:id : update tag (color, is_active)
    +DELETE /:id : soft-delete
  }
}

note right of InvestmentsRouter
  Compatibility for custom-provider latest/history
  fields + metals view updates is applied by
  migration 0017_investment_custom_provider_history.
end note

package "Repositories" {
  class "TransactionRepository" as TR
  class "CategoryRepository" as CR
  class "CategoryHierarchyRepository" as CHR
  class "RecipientRepository" as RR
  class "PlannedTransactionRepository" as PTR
  class "InvestmentRepository" as IR
  class "PortfolioTransactionRepository" as PTR2
  class "PortfolioExposureRepository" as PER
  class "WatchlistRepository" as WR
  class "SavedChartsRepository" as SCR
  class "SplitRepository" as SR
  class "SettingsRepository" as SR2
  class "RecipientBankAccountRepository" as RBAR
  class "InfoRepository" as IFR
  class "AccountRepository" as AR
  class "TagRepository" as TGR
  class "AttachmentRepository" as ATR
  class "ImportBatchRepository" as IBR
  class "ImportCommitRepository" as ICR
  class "PortfolioImportBatchRepository" as PIBR
}

package "Database" {
  class Connection {
    +checkConnection(): Promise<boolean>
    +getTableCount(): Promise<number>
  }
}

package "Services" {
  class TaxOverviewService
  class TaxDashboardService
  class SharedBelgianTaxEngine
  class "ImportPipeline <<services/importPipeline>>" as ImportPipeline
  class "StreamImport <<lib/importProgress.ts>>" as StreamImport
  class ImportBatchService
  class DataImportService
  class PortfolioImportPipelineService <<ADR-078>>
  class PortfolioImportBatchService <<ADR-078>>
  class PortfolioImportCommitService
  class PortfolioImportReconciliationService
  class PortfolioExposureService <<ADR-150>>
  class AuditVerificationService <<ADR-157>>
  class AuditRetentionService <<ADR-162>>
  class AuditBridgeService <<ADR-157>>
  class LoanRepaymentService
  class CurrencyConversionService
  class PriceProviderService
  class MaterializedViewService
  class RecurringDetectionService
  class RecurrenceService
  class DeduplicationService
  class TextNormalization
  class BankAdapters
}

