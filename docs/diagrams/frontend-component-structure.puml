@startuml Frontend Component Architecture
title Frontend Component Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Root" {
  class App {
    +QueryClient: QueryClient
    +render(): ReactElement
  }
}

package "UI Components (Radix + Tailwind)" {
  class Button
  class Dialog
  class Select
  class Input
  class Checkbox
  class RadioGroup
  class Toggle
  class Switch
  class Table
  class Calendar
  class Tooltip
  class DropdownMenu
  class Command
  class Sidebar
  class Skeleton
  class Badge
  class Separator
  class Collapsible
  class Textarea
  class Tabs
  class Progress
  class Slider
  class Sheet
  class AlertDialog
  class Accordion
  class Popover
  class ContextMenu
  class Alert
  class ScrollArea
  class Card
  class Label
  class Sonner
  class SegmentedControl
  class Disclosure
  class Inspector
  class List
  class FieldError
  class ShimmerLayer
}

package "Layout Components" {
  class AppLayout {
    +liquid-canvas: CSS atmosphere layer
    +ShaderAurora: WebGL (effective enhanced tier only)
    +Topbar: scroll-linked + title collapse
    +Sidebar: AppSidebar
    +CommandPalette: ⌘K palette
    +ShortcutsOverlay: ? key
    +PageTransition: enter-only spring
    +Content: Outlet
  }

  class AppSidebar <<ADR-180>> {
    +Sections: top / Money / Wealth / Research / Admin
    +Hide/Show per section (localStorage)
    +Collapsible: labels or icon rail (remembered)
    +Settings row: update dot
    +RoutePreload: hover prefetch
  }

  class NavItemBadge <<ADR-180>> {
    +needs-category / planned-due
    +insights / monitors counts
  }

  class PageTransition {
    +spring: enter-only
    +pathname: key
    +reducedMotion: instant
  }

  class CommandPalette {
    +trigger: ⌘K / Ctrl+K
    +pages: Money / Wealth / Research groups
    +theme modes: Light, Dark, System, Schedule
    +recents: localStorage
    +recipientSearch: debounced
  }

  class ShaderAurora {
    +webgl: raw (no deps)
    +fbm: 4-octave noise
    +resolution: 0.25x
    +gate: effective visualEffects tier
  }

  class ShortcutsOverlay {
    +trigger: ? key
    +dialog: glass
  }
}

package "Shared Components" {
  class ErrorBoundary {
    +Error Fallback UI
  }

  class CategoryCombobox {
    +category selection
  }

  class RecipientCombobox {
    +recipient selection
  }

  class VirtualDataTable {
    +virtualized rows
    +server-side sort
    +server-side search
    +column resize
    +column filters
    +sourceIndex row mapping
    +inline editing
    +cancelEditingRef
    +rowContextMenu (Radix ContextMenu, modal=false)
    +onRowOpen (Enter key)
    +onRowQuickLook (Space key)
    +↑/↓ keyboard row navigation
  }

  class ColumnFilter {
    +shared column-filter popover
    +multi-value filtering UI
  }

  class ExclusionToggle {
    +exclude categories/recipients
  }

  class WidgetVisibilityDialog {
    +manage widget visibility
  }

  class RollingNumber {
    +odometer digit reels
    +keyed from right
    +reducedMotion: plain span
  }

  class Money {
    +formatToParts micro-typography
    +raised symbol
    +de-emphasized decimals
  }

  class DeltaPill {
    +tinted change chip
    +invert prop
  }
}

package "Feature Components - Dashboard" {
  class StatCard
  class NetSummaryCard {
    +sparkline scrub (V9)
    +activeIndex: pointer-driven
    +RollingNumber hero
  }
  class MonthlyTrendsChart
  class CategoryPieChart
  class BankBalancesWidget
  class CashFlowForecastChart
  class MonthToDateHero {
    +useMonthToDate (average-vs-current)
    +usePlannedTotals (planned-transactions/totals)
  }
  class NeedsAttentionList
  class NetWorthCard
  class UpcomingPaymentsList {
    +useUpcomingPlannedPayments
  }
  class AccountsList
  class RecentTransactionsList
}

package "Feature Components - Forms" {
  class AddTransactionSheet {
    +Expense / Income / Transfer
    +silent useCreateTransaction
    +useCreateTransfer (two legs)
  }
  class AddCategoryDialog
  class AddRecipientDialog
  class AddInvestmentDialog
  class AddPortfolioTxnDialog
  class AddInvestmentFromMarketDialog
  class AddToWatchlistDialog
  class PlannedPaymentForm
}

package "Feature Components - Categories" {
  class CategoriesPage
  class CategoryNodeDialog
}

package "Feature Components - Portfolio" {
  class PortfolioPage
  class PortfolioExposureCard <<ADR-150>>
  class PortfolioTaxAdjustmentsDialog
  class PortfolioNewsFeed
  class InvestmentDetailDialog <<ADR-091>> {
    ' Shows "Holdings by Account" card (byAccount from useAccountPositions)
  }
  class WatchlistChartDialog
  class BrokerTransferDialog {
    ' re-tags lots to a broker account
  }
  class CloseAccountDialog <<ADR-091>> {
    ' Lists account holdings, transfers in-specie, then archives account
  }
  class assetPageParts <<ADR-187>> {
    ' Figure, FactRow, AssetPageActions (Add + ••• Export PDF / Import history)
    ' HoldingActionsMenu (row •••: Details, Add transaction, Archive, Delete)
  }
  class useHoldingActions <<ADR-187>> {
    ' controlled detail and add-transaction dialogs, confirmed archive and delete
    ' shared by Stocks, Crypto, Metals, Real estate and Savings pages
  }
}

useHoldingActions --> assetPageParts : renderMenu
useHoldingActions --> InvestmentDetailDialog : controlled open
useHoldingActions --> AddPortfolioTxnDialog : controlled open

PortfolioPage --> PortfolioExposureCard : issuer, sector, country views

package "Feature Components - Statistics" {
  class RecipientInsightsTab
  class CustomChart
}

package "Feature Components - Planning" {
  class RecurringDetectionPanel
  class PlannedPaymentsTable {
    +memoized VirtualDataTable columns
    +prop-driven row actions
  }
  class PlannedDueBadge {
    +shared local-calendar due state
  }
}

package "Feature Components - Recipients" {
  class MergeRecipientsDialog
  class SplitTransactionDialog
}

package "Feature Components - Transactions" {
  class TransactionsToolbar {
    +filter chips
    +View menu (optional columns)
  }
  class TransactionInspector {
    +docked aside >= 1024px
    +sheet below
    +footer row actions
  }
  class TransactionQuickLook {
    +read-only glance dialog
    +Space to open/close
    +returns focus to source row
  }
}

package "Feature Components - Settings" {
  class DashboardSettingsDialog {
    +URL section selection
    +keyboard tabs
    +lazy panel loader
  }
  class GeneralSection
  class AppearanceSection
  class StatisticsSection
  class BehaviorSection
  class AiSection
  class BackupSection
  class AboutSection
  class VirtualRecipientExclusions {
    +bounded viewport
    +roving checkbox focus
  }
  AppLayout ..> DashboardSettingsDialog : first-open lazy import
  DashboardSettingsDialog ..> GeneralSection : lazy
  DashboardSettingsDialog ..> AppearanceSection : lazy
  DashboardSettingsDialog ..> StatisticsSection : lazy
  DashboardSettingsDialog ..> BehaviorSection : lazy
  DashboardSettingsDialog ..> AiSection : lazy
  DashboardSettingsDialog ..> BackupSection : lazy
  DashboardSettingsDialog ..> AboutSection : lazy
  StatisticsSection --> VirtualRecipientExclusions
}

package "Feature Components - Tax" {
  class TaxProfileDialog
  class SuggestedDeductionsCard
}

package "Feature Components - Import" {
  class ImportPage
  class PortfolioImportPage
  class PortfolioImportSession <<ADR-177>> {
    +source/account detection per statement
    +global/per-batch policy and counterpart
    +Kinesis zero yield-basis policy
    +current ready review + atomic commit
  }
  class "portfolioImportDetection.ts" as PortfolioImportDetection
  class "lib/api/portfolioImports.ts" as PortfolioImportsApi
}
PortfolioImportPage --> PortfolioImportSession
PortfolioImportSession --> PortfolioImportDetection : read complete supported file
PortfolioImportSession --> PortfolioImportsApi : stage / preview / commit


package "Feature Components - Notifications" {
  class UpcomingPaymentsNotification {
    +stands down on / when suggestions widget visible
    +dock badge (non-dismissed count)
    +useUpcomingPlannedPayments
  }
}

package "Hooks - Sidebar and Updates" {
  class useSidebarPreferences <<ADR-180>> {
    +vision.sidebar.hiddenSections
    +vision.sidebar.collapsed
  }
  class useUpdateStatus <<ADR-180>> {
    +queryKey: "update-status"
    +poll: 5 min while visible
  }
  class AboutSection
}

package "Hooks - Upcoming Payments" {
  class useUpcomingPlannedPayments {
    +queryKey: "upcomingPlannedPayments"
    +module-level dismissed Set
    +useSyncExternalStore
    +persists: DISMISSED_UPCOMING_PAYMENTS
  }
}

package "Feature Components - Onboarding" {
  class OnboardingWizard
}

package "Feature Components - Research" {
  class AnalysisMonitorsPage {
    +rule editor and observation history
    +server-owned in-app inbox
  }
  class useMonitors {
    +paged rules, observations, and inbox
    +local rule mutations
  }
  class ResearchDossiersPage {
    +local versioned editor
    +evidence and link provenance
  }
  class useDossiers {
    +list and detail queries
    +save, restore, delete mutations
  }
}

' Relationships
App --> AppLayout
App --> QueryClientProvider
App --> ThemeProvider
App --> SettingsProvider
App --> ErrorBoundary

AppLayout --> AppSidebar
AppLayout --> CommandPalette
AppLayout --> ShortcutsOverlay
AppLayout --> PageTransition
AppLayout --> ShaderAurora
ResearchDossiersPage --> useDossiers
AnalysisMonitorsPage --> useMonitors
NavItemBadge --> useMonitors : unread monitor count
NavItemBadge --> useUpcomingPlannedPayments : planned due count
AppSidebar --> NavItemBadge
AppSidebar --> useSidebarPreferences : hidden sections
AppSidebar --> useUpdateStatus : update dot
AboutSection --> useUpdateStatus : version, notes, install

AddTransactionSheet --> CategoryCombobox
CategoriesPage --> CategoryNodeDialog
AddTransactionSheet --> RecipientCombobox
VirtualDataTable --> ColumnFilter
VirtualDataTable --> TransactionQuickLook : onRowQuickLook (Space)
VirtualDataTable --> TransactionInspector : onRowSelect (via TransactionsPage)
TransactionInspector --> SplitTransactionDialog : footer Split
UpcomingPaymentsList --> useUpcomingPlannedPayments
UpcomingPaymentsNotification --> useUpcomingPlannedPayments

note right of ImportPage
  Import wizard integrated
  in ImportPage component
end note

package "Analysis Workbench (ADR-175)" {
  class AnalysisWorkspacePage
  class AnalysisChartPanel
  class AnalysisPivotPanel
  class AnalysisWorkbenchPanel
  class AnalysisInterchangePanel
}
AnalysisWorkspacePage --> AnalysisChartPanel : persisted multiple series
AnalysisWorkspacePage --> AnalysisPivotPanel : complete-source totals and drill
AnalysisWorkspacePage --> AnalysisWorkbenchPanel : formulas, preparation and scenarios
AnalysisWorkspacePage --> AnalysisInterchangePanel : typed snapshot values

@enduml
