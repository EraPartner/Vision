@startuml Price Provider Flow
title Price Provider Flow

!theme plain
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50

actor "User" as User

package "Frontend" {
  class PortfolioPage
  class usePortfolio
  class InvestmentCard
}

package "Backend Services" {
  class PriceProviderService {
    +fetchPrice(provider, symbol): Promise<PriceData>
    +updateInvestmentPrices(): Promise<UpdateResult>
    +fetchLivePrices(investments): Promise<PriceMap>
    +fetchHistoricalPrices(investment): Promise<HistoryPoint[]>
  }

  class InvestmentsRouter {
    +POST /refresh-prices : bulk refresh prices
    +GET /:id/price-history : provider-backed history
  }

  class InvestmentRepository {
    +getAll(opts): Promise<Investment[]>
    +update(id, fields): Promise<Investment>
  }
}

cloud "Price Providers" as Providers {
  class Binance <<Crypto Prices>>
  class YahooFinance <<Stock Prices>>
  class Kinesis <<Metals/Commodities>>
  class CustomJSON <<Latest + History>>
  class Manual <<User Entry>>
}

database "PostgreSQL" as DB {
  table "investments"
  table "asset_price_history"
}

package "Manual Flow" {
  User --> PortfolioPage : View Portfolio
  PortfolioPage --> usePortfolio : Load investments
  usePortfolio --> InvestmentRepository : GET /investments
  InvestmentRepository --> DB : SELECT
  DB --> InvestmentRepository : investments
  InvestmentRepository --> PortfolioPage : display

  User --> InvestmentCard : Update Price
  InvestmentCard --> InvestmentsRouter : PATCH /investments/:id
  InvestmentsRouter --> InvestmentRepository : update(price)
  InvestmentRepository --> DB : UPDATE current_price
  DB --> InvestmentRepository : updated
  InvestmentRepository --> InvestmentsRouter : updated
  InvestmentsRouter --> InvestmentCard : confirmation
}

package "Bulk Refresh Flow" {
  User --> PortfolioPage : Click "Refresh Prices"
  PortfolioPage --> InvestmentsRouter : POST /refresh-prices
  InvestmentsRouter --> PriceProviderService : fetchLivePrices(investments)
  PriceProviderService --> DB : SELECT investments WHERE price_provider != manual
  DB --> PriceProviderService : investments

  loop For each investment
    alt provider == 'binance'
      PriceProviderService --> Binance : GET /ticker/price
    else provider == 'yahoo'
      PriceProviderService --> YahooFinance : GET /quote
    else provider == 'kinesis'
      PriceProviderService --> Kinesis : GET trendline
    else provider == 'custom'
      PriceProviderService --> CustomJSON : GET latest_url
      alt latest path missing/unresolved
        PriceProviderService --> CustomJSON : derive latest from history path
      end
    end
   
    Providers --> PriceProviderService : price data
    PriceProviderService --> InvestmentRepository : UPDATE prices
    InvestmentRepository --> DB : UPDATE current_price, price_updated_at
  end
}

package "On-demand History Flow" {
  User --> PortfolioPage : Open performance chart
  PortfolioPage --> InvestmentsRouter : GET /investments/:id/price-history
  InvestmentsRouter --> PriceProviderService : fetchHistoricalPrices(investment)
  PriceProviderService --> DB : SELECT asset_price_history (range)
  alt DB coverage incomplete
    PriceProviderService --> CustomJSON : GET history_url (custom)
    PriceProviderService --> YahooFinance : GET /chart (yahoo)
    Providers --> PriceProviderService : history JSON
    PriceProviderService --> DB : UPSERT asset_price_history
  end
  PriceProviderService --> InvestmentsRouter : [{timestampMs, price}]
  InvestmentsRouter --> PortfolioPage : history points
}

package "Startup Backfill" {
  PriceProviderService --> DB : SELECT held investments + first_tx_date
  loop For each held unit-based investment
    PriceProviderService --> PriceProviderService : fetchHistoricalPrices(from first_tx_date)
  end
}

note right of PriceProviderService
  Supported providers:
  - binance: Crypto
  - yahoo: Stocks/ETFs
  - kinesis: Metals/commodities
  - custom: JSON latest + history
  - manual: User entry

  Custom provider config:
  - price_provider_latest_url / path
  - price_provider_history_url / path
  - timestamp path + price path

  History is fetched on demand
  and persisted with read-through
  cache behavior in asset_price_history.

  Historical migration dependency:
  0017_investment_custom_provider_history
  kept the retired compatibility view/trigger aligned.
  Migration 0087 converted it to the flat table.
end note

@enduml
