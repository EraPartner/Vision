@startuml Backend Domain Model
title Backend Domain Model

!theme plain
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 80

package "Core Entities" {
  class Transaction {
    +id: integer
    +date: date
    +amount: numeric(15,2)
    +currency: varchar(3)
    +balance: numeric(15,2)
    +memo: text
    +comment: text
    +account_id: integer <<FK>>
    +recipient_id: integer <<FK>>
    +recipient_bank_account_id: integer <<FK>>
    +category_id: integer <<FK>>
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class Account {
    +id: integer
    +name: text
    +display_name: text
    +currency: varchar(3)
    +is_active: boolean
    +closed_at: timestamptz
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class Recipient {
    +id: integer
    +name: text
    +normalized_name: text
    +default_category_id: integer <<FK>>
    +primary_recipient_id: integer <<FK>>
    +notes: text
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class Category {
    +id: integer
    +parent_id: integer <<FK Category>>
    +name: text
    +path_name: text
    +general: text
    +detail: text
    +hierarchy_only: boolean
    +legacy_compatible: boolean
    +description: text
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class RecipientBankAccount {
    +id: integer
    +recipient_id: integer
    +account_number: varchar(34)
    +bank_name: text
    +account_label: text
    +address: text
    +is_primary: boolean
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class PlannedTransaction {
    +id: integer
    +planned_date: date
    +amount: numeric(15,2)
    +currency: varchar(3)
    +memo: text
    +comment: text
    +url: text
    +account_id: integer <<FK>>
    +recipient_id: integer <<FK>>
    +category_id: integer <<FK>>
    +is_recurring: boolean
    +recurrence_pattern: text
    +is_loan: boolean
    +loan_type: text
    +loan_principal: numeric(15,2)
    +loan_annual_interest_rate: numeric(8,4)
    +loan_term_months: integer
    +loan_start_date: date
    +loan_payment_day: integer
    +loan_regular_payment_amount: numeric(15,2)
    +loan_first_payment_date: date
    +is_executed: boolean
    +last_executed_date: date
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class PlannedTransactionExecution {
    +id: integer
    +planned_transaction_id: integer <<FK>>
    +executed_transaction_id: integer <<FK>>
    +execution_date: date
    +created_at: timestamptz
  }

  class PlannedTransactionLoanSchedule {
    +id: integer
    +planned_transaction_id: integer <<FK>>
    +installment_number: integer
    +due_date: date
    +payment_amount: numeric(15,2)
    +principal_amount: numeric(15,2)
    +interest_amount: numeric(15,2)
    +remaining_principal: numeric(15,2)
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class Tag {
    +id: integer
    +slug: varchar(255) <<UNIQUE>>
    +color: varchar(7)
    +is_active: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class TransactionTag {
    +transaction_id: integer <<FK, PK>>
    +tag_id: integer <<FK, PK>>
  }

  class PlannedTransactionTag {
    +planned_transaction_id: integer <<FK, PK>>
    +tag_id: integer <<FK, PK>>
  }
}

package "Split Entities" {
  class TransactionSplit {
    +id: integer
    +transaction_id: integer <<FK>>
    +recipient_id: integer <<FK>>
    +amount: numeric(15,2)
    +note: text
    +is_settled: boolean
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class SplitPayment {
    +id: integer
    +split_id: integer <<FK>>
    +amount: numeric(15,2)
    +paid_at: date
    +note: text
    +created_at: timestamptz
  }
}

package "Investment & Portfolio" {
  class Investment {
    +id: integer
    +name: varchar(200)
    +symbol: varchar(20)
    +asset_class: asset_class
    +currency: varchar(10)
    +current_price: numeric(18,6)
    +interest_rate: numeric(8,4)
    +maturity_date: date
    +location: varchar(300)
    +municipality: varchar(200)
    +cadastral_income: numeric(12,2)
    +municipality_tax_rate: numeric(8,4)
    +notes: text
    +is_active: boolean
    +price_provider: price_provider
    +price_provider_id: varchar(200)
    +price_provider_url: varchar(500)
    +price_updated_at: timestamptz
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class PortfolioTransaction {
    +id: integer
    +investment_id: integer <<FK>>
    +type: portfolio_txn_type
    +date: date
    +amount: numeric(18,4)
    +units: numeric(18,8)
    +price_per_unit: numeric(18,6)
    +fees: numeric(18,4)
    +taxes: numeric(18,4)
    +currency: varchar(10)
    +note: text
    +is_recurring: boolean
    +recurrence_interval: recurrence_interval
    +recurrence_end_date: date
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class PortfolioAssetTransfer <<ADR-177>> {
    +id: bigint (shared trade sequence)
    +investment_id: integer <<FK>>
    +source_account_id: integer <<FK>>
    +destination_account_id: integer <<FK>>
    +date: date
    +units: numeric(18,8) (gross)
    +fee_units: numeric(18,8)
    +fee_basis_allocations: jsonb
    +import_batch_id: bigint <<FK>>
    +staging_row_id: bigint <<FK, UQ>>
    +source_record_hash: char(64)
    +dedup_fingerprint: char(64)
  }
  class PortfolioAssetAdjustment <<ADR-177>> {
    +id: bigint (shared trade sequence)
    +investment_id / account_id: integer <<FK RESTRICT>>
    +date: date
    +units: numeric(18,8) (removed)
    +adjustment_kind: yield_reversal | asset_fee
    +basis_policy: zero_yield_only | carried
    +eligible_source_record_hashes: text[]
    +basis_allocations: jsonb (original lots / purchase FX)
    +import_batch_id / staging_row_id: bigint <<FK RESTRICT>>
    +source_record_hash / dedup_fingerprint: char(64)
  }
  class PortfolioAssetAdjustmentSource <<ADR-177>> {
    +adjustment_id: bigint <<PK, FK CASCADE>>
    +staging_row_id: bigint <<PK, FK RESTRICT>>
    +source_record_hash: char(64)
  }
  class PortfolioImportReconciliationJournal <<ADR-177>> {
    +id: bigint
    +batch_id: bigint <<FK>>
    +staging_row_id: bigint <<FK>>
    +transaction_id: integer (retained ID)
    +action: adopt | restore
    +policy: exact | preserve_existing | prefer_source
    +previous_entry_id: bigint <<FK, UQ>>
    +before_data: jsonb
    +after_data: jsonb
  }
  class PortfolioImportDuplicateRepairJournal <<ADR-177>> {
    +id: bigint
    +batch_id: bigint <<FK>>
    +staging_row_id: bigint <<FK>>
    +original_import_batch_id: bigint <<FK>>
    +legacy_transaction_id: integer (retained)
    +imported_transaction_id: integer (removed copy)
    +action: repair | restore
    +policy: preserve_existing | prefer_source
    +before_data / after_data: jsonb (both rows + source state)
    +previous_entry_id: bigint <<FK, UQ>>
  }
  class PortfolioImportBatch {
    +id: bigint
    +account_id: integer
    +custom_config: jsonb
    +status: text
  }
  class PortfolioImportStagingRow {
    +id: bigint
    +batch_id: bigint <<FK>>
    +route: portfolio | cash | asset_transfer | account_internal
    +asset_transfer_details: json
    +status: text
  }

  class Watchlist {
    +id: integer
    +name: varchar(200)
    +symbol: varchar(20)
    +asset_class: asset_class
    +target_price: numeric(18,6)
    +currency: varchar(10)
    +notes: text
    +price_provider_id: varchar(200)
    +created_at: timestamptz
    +updated_at: timestamptz
  }
}

package "Supporting Entities" {
  class ExchangeRate {
    +id: integer
    +currency_code: varchar(3)
    +rate_to_eur: numeric(20,10)
    +rate_date: date
    +is_latest: boolean
    +fetched_at: timestamptz
    +updated_at: timestamptz
  }

  class UserSetting {
    +key: text
    +value: jsonb
    +updated_at: timestamptz
  }

  class SavedChart {
    +id: integer
    +name: text
    +chart_type: text
    +chart_variant: text
    +time_bucket: text
    +category_ids: integer[]
    +recipient_ids: integer[]
    +tag_ids: integer[]
    +all_categories: boolean
    +all_recipients: boolean
    +all_tags: boolean
    +date_range_start: date
    +date_range_end: date
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class TransactionRawReference {
    +id: integer
    +transaction_id: integer <<FK>>
    +raw_source_type: varchar(20)
    +raw_source_id: integer
    +created_at: timestamptz
  }

  class TransactionSourceRecord {
    +id: bigint
    +source_type: text
    +legacy_source_id: bigint
    +native_payload: jsonb
    +migration_status: text
  }

  class TransactionSourceLink {
    +id: bigint
    +source_record_id: bigint <<FK>>
    +transaction_id: integer <<FK>>
    +legacy_transaction_id: integer
    +link_status: text
  }

  class ManualTransactionDedupClaim {
    +deduplication_hash: char(64)
    +transaction_id: integer <<FK>>
  }
}

package "Storage & Observability (May 2026)" {
  class Attachment {
    +id: bigint
    +transaction_id: integer <<FK>>
    +stored_path: text
    +mime_type: text
    +size_bytes: bigint
    +original_filename: text
    +created_at: timestamptz
  }

  class AiConversation {
    +id: uuid
    +title: text
    +messages: jsonb
    +tool_transcripts: jsonb
    +created_at: timestamptz
    +updated_at: timestamptz
  }

  class AiInvestigationJob {
    +id: uuid
    +state: text
    +scope_json: jsonb
    +checkpoint_json: jsonb
    +result_json: jsonb
  }

  class AiReferenceScope <<ADR-151>> {
    +id: uuid
    +job_id: uuid <<FK, UNIQUE>>
    +expires_at: timestamptz
    +claimed_at: timestamptz
  }

  class AiReferenceEntry <<ADR-151>> {
    +scope_id: uuid <<FK, PK>>
    +token: text <<PK, UNIQUE>>
    +reference_type: text
    +ciphertext: bytea
    +nonce: bytea
    +auth_tag: bytea
  }

  class ProviderHealth {
    +id: bigint
    +provider: text
    +ok: boolean
    +latency_ms: integer
    +status_code: integer
    +error: text
    +observed_at: timestamptz
  }

  class ImportBatch {
    +id: integer
    +adapter: text
    +status: text
    +rows_total: integer
    +rows_committed: integer
    +meta: jsonb
    +created_at: timestamptz
  }

  class ImportRow {
    +id: bigint
    +batch_id: integer <<FK>>
    +row_index: integer
    +raw: jsonb
    +resolved_recipient_id: integer <<FK>>
    +user_override_recipient_id: integer <<FK>>
    +status: text
  }

  class CashflowForecastMc {
    +id: uuid
    +params_hash: text
    +paths: jsonb
    +computed_at: timestamptz
    +ttl_seconds: integer
  }

  class AggRecipientTotals {
    +recipient_id: integer
    +total_eur: numeric
    +count: integer
    +updated_at: timestamptz
  }
}

' Relationships (using UML standard notation)
Category "0..1" <-- "*" Category : parent_id
Recipient "1" --> "0..1" Recipient : primary_recipient_id
Recipient "1" --> "0..1" Category : default_category_id
Recipient "1" o-- "*" RecipientBankAccount : has
Recipient "1" o-- "*" Transaction : has

Transaction "*" --> "1" Category : belongs to
PlannedTransaction "*" --> "1" Category : belongs to
Category "1" <-- "*" Recipient : default_category

Transaction "1" --> "0..1" RecipientBankAccount : uses
Transaction "*" --> "0..1" Account : owned by
PlannedTransaction "*" --> "0..1" Account : owned by

Transaction "*" o-- "*" Tag : has (via TransactionTag)
PlannedTransaction "*" o-- "*" Tag : has (via PlannedTransactionTag)
TransactionTag "1" --> "1" Transaction : for
TransactionTag "1" --> "1" Tag : is
PlannedTransactionTag "1" --> "1" PlannedTransaction : for
PlannedTransactionTag "1" --> "1" Tag : is

PlannedTransaction "1" --> "0..1" Recipient : for
PlannedTransaction "1" --> "0..1" Category : for
PlannedTransaction "1" o-- "*" PlannedTransactionExecution : tracks
PlannedTransaction "1" o-- "*" PlannedTransactionLoanSchedule : has
PlannedTransactionExecution "1" --> "0..1" Transaction : executes

Investment "1" o-- "*" PortfolioTransaction : records
Investment "1" -- "*" PortfolioAssetTransfer : dated custody
Investment "1" -- "*" PortfolioAssetAdjustment : dated unit removal
Account "1" -- "*" PortfolioAssetAdjustment : original lots
PortfolioImportBatch "1" -- "*" PortfolioAssetAdjustment : retained source
PortfolioImportStagingRow "1" -- "0..1" PortfolioAssetAdjustment : source event
PortfolioAssetAdjustment "1" -- "*" PortfolioAssetAdjustmentSource : parent rollback cascade
PortfolioImportStagingRow "1" -- "*" PortfolioAssetAdjustmentSource : original yield evidence RESTRICT
Account "1" -- "*" PortfolioAssetTransfer : source / destination
PortfolioImportBatch "1" -- "*" PortfolioImportStagingRow : source provenance
PortfolioImportBatch "1" -- "*" PortfolioImportReconciliationJournal : retained receipt
PortfolioImportStagingRow "1" -- "*" PortfolioImportReconciliationJournal : adoption / restore
PortfolioImportStagingRow "1" -- "0..1" PortfolioAssetTransfer : source event
PortfolioImportReconciliationJournal ..> PortfolioTransaction : retained ID + CAS images; no FK
PortfolioImportReconciliationJournal --> PortfolioImportReconciliationJournal : previous adoption
PortfolioImportBatch "1" -- "*" PortfolioImportDuplicateRepairJournal : new / original source
PortfolioImportStagingRow "1" -- "*" PortfolioImportDuplicateRepairJournal : repair / restore
PortfolioImportDuplicateRepairJournal ..> PortfolioTransaction : retained / removed IDs; no FKs

Transaction "1" o-- "*" TransactionSplit : has
TransactionSplit "1" --> "1" Recipient : owed to
TransactionSplit "1" o-- "*" SplitPayment : payments

Transaction "1" --> "0..1" TransactionRawReference : references
TransactionSourceRecord "1" o-- "*" TransactionSourceLink : preserves
Transaction "0..1" <-- "*" TransactionSourceLink : links
Transaction "0..1" <-- "0..1" ManualTransactionDedupClaim : claimed by

Transaction "1" o-- "*" Attachment : "has receipts"
AiInvestigationJob "1" o-- "0..1" AiReferenceScope : one-job claim
AiReferenceScope "1" o-- "*" AiReferenceEntry : encrypted map
ImportBatch "1" o-- "*" ImportRow : contains
ImportRow "*" --> "0..1" Recipient : resolved / overridden recipient
ImportRow "*" --> "0..1" RecipientBankAccount : resolved bank account
Recipient "1" --> "0..1" AggRecipientTotals : "trigger-maintained"

@enduml
