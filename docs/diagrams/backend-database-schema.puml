@startuml Database Schema - ERD
title Database Schema - Entity Relationship Diagram

!theme plain
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
hide circle

' Core Tables
entity "categories" as categories {
  * id : serial <<PK>>
  * general : text
  * detail : text
  description : text
  * is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
  ---
  UNIQUE(general, detail)
}

entity "recipients" as recipients {
  * id : serial <<PK>>
  * name : text
  * normalized_name : text <<UQ>>
  default_category_id : integer <<FK>>
  primary_recipient_id : integer <<FK>>
  notes : text
  * is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "recipient_bank_accounts" as recipient_bank_accounts {
  * id : serial <<PK>>
  * recipient_id : integer
  * account_number : varchar(34) <<UQ>>
  bank_name : text
  account_label : text
  address : text
  is_primary : boolean
  is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "transactions" as transactions {
  * id : serial <<PK>>
  * date : date
  * amount : numeric(15,2)
  currency : varchar(3)
  balance : numeric(15,2)
  memo : text
  comment : text
  bank_account : text
  * recipient_id : integer <<FK>>
  recipient_bank_account_id : integer <<FK>>
  category_id : integer <<FK>>
  is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "planned_transactions" as planned_transactions {
  * id : serial <<PK>>
  * planned_date : date
  * amount : numeric(15,2)
  currency : varchar(3)
  memo : text
  comment : text
  url : text
  bank_account : text
  recipient_id : integer <<FK>>
  category_id : integer <<FK>>
  is_recurring : boolean
  recurrence_pattern : text
  is_loan : boolean
  loan_type : text
  loan_principal : numeric(15,2)
  loan_annual_interest_rate : numeric(8,4)
  loan_term_months : integer
  loan_start_date : date
  loan_payment_day : integer
  loan_regular_payment_amount : numeric(15,2)
  loan_first_payment_date : date
  is_executed : boolean
  last_executed_date : date
  is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "planned_transaction_executions" as pte {
  * id : serial <<PK>>
  * planned_transaction_id : integer <<FK>>
  * executed_transaction_id : integer <<FK>>
  * execution_date : date
  created_at : timestamptz
}

entity "planned_transaction_loan_schedule" as ptls {
  * id : serial <<PK>>
  * planned_transaction_id : integer <<FK>>
  * installment_number : integer
  * due_date : date
  * payment_amount : numeric(15,2)
  * principal_amount : numeric(15,2)
  * interest_amount : numeric(15,2)
  * remaining_principal : numeric(15,2)
  created_at : timestamptz
  updated_at : timestamptz
}

' Split Tables
entity "transaction_splits" as transaction_splits {
  * id : serial <<PK>>
  * transaction_id : integer <<FK>>
  * recipient_id : integer <<FK>>
  * amount : numeric(15,2)
  note : text
  * is_settled : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "split_payments" as split_payments {
  * id : serial <<PK>>
  * split_id : integer <<FK>>
  * amount : numeric(15,2)
  * paid_at : date
  note : text
  created_at : timestamptz
}

' Investment Tables (PostgreSQL inheritance)
entity "investments_base" as investments_base {
  * id : serial <<PK>>
  * name : varchar(200)
  * currency : varchar(10)
  notes : text
  is_active : boolean
  * price_provider : price_provider
  price_provider_id : varchar(200)
  price_provider_url : varchar(500)
  price_provider_latest_url : varchar(500)
  price_provider_latest_path : varchar(300)
  price_provider_history_url : varchar(500)
  price_provider_history_path : varchar(300)
  price_provider_history_ts_path : varchar(300)
  price_provider_history_price_path : varchar(300)
  price_updated_at : timestamptz
  created_at : timestamptz
  updated_at : timestamptz
}

entity "stock_investments" as stock_investments {
  * id : integer <<PK>>
  symbol : varchar(20)
  current_price : numeric(18,6)
}

entity "etf_investments" as etf_investments {
  * id : integer <<PK>>
  symbol : varchar(20)
  current_price : numeric(18,6)
}

entity "crypto_investments" as crypto_investments {
  * id : integer <<PK>>
  symbol : varchar(50)
  current_price : numeric(18,6)
}

entity "metals_investments" as metals_investments {
  * id : integer <<PK>>
  symbol : varchar(20)
  current_price : numeric(18,6)
}

entity "real_estate_investments" as real_estate_investments {
  * id : integer <<PK>>
  current_price : numeric(18,6)
  location : varchar(300)
  municipality : varchar(200)
  cadastral_income : numeric(12,2)
  municipality_tax_rate : numeric(8,4)
}

entity "savings_investments" as savings_investments {
  * id : integer <<PK>>
  current_price : numeric(18,6)
  interest_rate : numeric(8,4)
}

entity "bond_investments" as bond_investments {
  * id : integer <<PK>>
  current_price : numeric(18,6)
  interest_rate : numeric(8,4)
  maturity_date : date
}

entity "portfolio_transactions_base" as portfolio_transactions_base {
  * id : serial <<PK>>
  * investment_id : integer
  * type : portfolio_txn_type
  * date : date
  * amount : numeric(18,4)
  fees : numeric(18,4)
  taxes : numeric(18,4)
  * currency : varchar(10)
  fx_rate_to_eur : numeric(20,10)
  note : text
  * is_recurring : boolean
  recurrence_interval : recurrence_interval
  recurrence_end_date : date
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "stock_transactions" as stock_transactions {
  * id : integer <<PK>>
  * investment_id : integer
  units : numeric(18,8)
  price_per_unit : numeric(18,6)
}

entity "etf_transactions" as etf_transactions {
  * id : integer <<PK>>
  * investment_id : integer
  units : numeric(18,8)
  price_per_unit : numeric(18,6)
}

entity "crypto_transactions" as crypto_transactions {
  * id : integer <<PK>>
  * investment_id : integer
  units : numeric(18,8)
  price_per_unit : numeric(18,6)
}

entity "metals_transactions" as metals_transactions {
  * id : integer <<PK>>
  * investment_id : integer
  units : numeric(18,8)
  price_per_unit : numeric(18,6)
}

entity "real_estate_transactions" as real_estate_transactions {
  * id : integer <<PK>>
  * investment_id : integer
}

entity "savings_transactions" as savings_transactions {
  * id : integer <<PK>>
  * investment_id : integer
}

entity "bond_transactions" as bond_transactions {
  * id : integer <<PK>>
  * investment_id : integer
}

entity "watchlist" as watchlist {
  * id : serial <<PK>>
  * name : varchar(200)
  symbol : varchar(20)
  * asset_class : asset_class
  * target_price : numeric(18,6)
  * currency : varchar(10)
  notes : text
  price_provider_id : varchar(200)
  * created_at : timestamptz
  * updated_at : timestamptz
}

' Supporting Tables
entity "exchange_rates" as exchange_rates {
  * id : serial <<PK>>
  * currency_code : varchar(3)
  * rate_to_eur : numeric(20,10)
  * rate_date : date
  is_latest : boolean
  fetched_at : timestamptz
  updated_at : timestamptz
  ---
  UNIQUE(currency_code, rate_date)
}

entity "asset_price_history" as asset_price_history {
  * id : serial <<PK>>
  investment_id : integer
  * price_date : date
  * close_price : numeric(18,6)
  source : varchar(50)
  fetched_at : timestamptz
  updated_at : timestamptz
  ---
  UNIQUE(investment_id, price_date)
}

entity "portfolio_performance_snapshots" as portfolio_performance_snapshots {
  * id : serial <<PK>>
  * snapshot_date : date <<UQ>>
  * invested : numeric(18,6)
  * value : numeric(18,6)
  stocks_etfs_value : numeric(18,6)
  crypto_value : numeric(18,6)
  metals_value : numeric(18,6)
  cash_value : numeric(18,6)
  gain_loss : numeric(18,6)
  return_pct : numeric(10,4)
  inflation_adjusted_value : numeric(18,6)
  cumulative_inflation : numeric(10,4)
  real_return_pct : numeric(10,4)
  * currency : varchar(3)
  computed_at : timestamptz
  stocks_etfs_invested : numeric(18,6)
  crypto_invested : numeric(18,6)
  metals_invested : numeric(18,6)
  ---
  INDEX(snapshot_date)
  INDEX(currency)
}

entity "belgian_inflation_rates" as belgian_inflation_rates {
  * id : serial <<PK>>
  * month_date : date <<UQ>>
  * monthly_rate : numeric(10,8)
  source : varchar(50)
  fetched_at : timestamptz
  updated_at : timestamptz
}

entity "user_settings" as user_settings {
  * key : text <<PK>>
  * value : jsonb
  updated_at : timestamptz
}

entity "saved_charts" as saved_charts {
  * id : serial <<PK>>
  * name : text
  * chart_type : text
  * chart_variant : text
  * time_bucket : text
  * category_ids : integer[]
  * recipient_ids : integer[]
  * tag_ids : integer[]
  * all_categories : boolean
  * all_recipients : boolean
  * all_tags : boolean
  date_range_start : date
  date_range_end : date
  * created_at : timestamptz
  * updated_at : timestamptz
}

' Raw Import Tables
entity "transaction_raw_references" as transaction_raw_references {
  * id : serial <<PK>>
  * transaction_id : integer <<FK>>
  * raw_source_type : varchar(20)
  * raw_source_id : integer
  created_at : timestamptz
}

entity "belfius_raw_transactions" as belfius_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "revolut_raw_transactions" as revolut_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "kbc_raw_transactions" as kbc_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "sabb_raw_transactions" as sabb_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "wise_raw_transactions" as wise_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "vision_raw_transactions" as vision_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  * raw_data : jsonb
  created_at : timestamptz
}

entity "manual_raw_transactions" as manual_raw_transactions {
  * id : serial <<PK>>
  * deduplication_hash : varchar(64)
  created_at : timestamptz
  transaction_id : integer
  * date : date
  bank_account : varchar(100)
  recipient_id : integer
  * amount : numeric(15,2)
  memo : text
  currency : varchar(3)
  category_id : integer
  comment : text
  * raw_csv_line : text
  raw_metadata : jsonb
}
note right of manual_raw_transactions
  Stores manually entered
  transactions for deduplication
  (before creating real transaction)
end note

' Relationships (using standard UML crow's foot notation)
' One-to-One / One-to-Many relationships
categories ||--o{ recipients : default_category_id
recipients ||--o| recipients : primary_recipient_id
recipient_bank_accounts }o--|| recipients
transactions }o--|| recipients
transactions }o--|| recipient_bank_accounts
transactions }o--|| categories

planned_transactions }o--|| recipients
planned_transactions }o--|| categories

pte }o--|| planned_transactions
pte }o--|| transactions
ptls }o--|| planned_transactions

investments_base ||--|| stock_investments : inherits
investments_base ||--|| etf_investments : inherits
investments_base ||--|| crypto_investments : inherits
investments_base ||--|| metals_investments : inherits
investments_base ||--|| real_estate_investments : inherits
investments_base ||--|| savings_investments : inherits
investments_base ||--|| bond_investments : inherits

portfolio_transactions_base ||--|| stock_transactions : inherits
portfolio_transactions_base ||--|| etf_transactions : inherits
portfolio_transactions_base ||--|| crypto_transactions : inherits
portfolio_transactions_base ||--|| metals_transactions : inherits
portfolio_transactions_base ||--|| real_estate_transactions : inherits
portfolio_transactions_base ||--|| savings_transactions : inherits
portfolio_transactions_base ||--|| bond_transactions : inherits

stock_investments ||--o{ stock_transactions
etf_investments ||--o{ etf_transactions
crypto_investments ||--o{ crypto_transactions
metals_investments ||--o{ metals_transactions
real_estate_investments ||--o{ real_estate_transactions
savings_investments ||--o{ savings_transactions
bond_investments ||--o{ bond_transactions

asset_price_history }o--|| investments_base : investment_id

transaction_splits }o--|| transactions
transaction_splits }o--|| recipients
split_payments }o--|| transaction_splits

transaction_raw_references }o--|| transactions

' ───────────────────────────────────────────────────────────────
' Additions (May 2026)
' ───────────────────────────────────────────────────────────────

entity "tags" as tags {
  * id : serial <<PK>>
  * slug : text <<UNIQUE>>
  * name : text
  color : text
  is_active : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "transaction_tags" as transaction_tags {
  * transaction_id : integer <<FK>>
  * tag_id : integer <<FK>>
  created_at : timestamptz
  ---
  PRIMARY KEY (transaction_id, tag_id)
}

entity "attachments" as attachments {
  * id : bigserial <<PK>>
  * transaction_id : integer <<FK ON DELETE CASCADE>>
  * stored_path : text
  * mime_type : text
  * size_bytes : bigint
  original_filename : text
  created_at : timestamptz
}

entity "ai_conversations" as ai_conversations {
  * id : uuid <<PK>>
  title : text
  messages : jsonb
  tool_transcripts : jsonb
  created_at : timestamptz
  updated_at : timestamptz
}

entity "provider_health" as provider_health {
  * id : bigserial <<PK>>
  * provider : text
  * ok : boolean
  latency_ms : integer
  status_code : integer
  error : text
  observed_at : timestamptz
}

entity "import_batches" as import_batches {
  * id : serial <<PK>>
  * adapter : text
  status : text
  rows_total : integer
  rows_committed : integer
  meta : jsonb
  created_at : timestamptz
}

entity "import_staging_rows" as import_staging_rows {
  * id : bigserial <<PK>>
  * batch_id : bigint <<FK>>
  * row_index : integer
  raw_data : text
  resolved_recipient_id : integer <<FK>>
  resolved_bank_account_id : integer <<FK>>
  user_override_recipient_id : integer <<FK>>
  status : text
}

entity "custom_parser_configs" as custom_parser_configs {
  * id : serial <<PK>>
  * name : text
  * kind : text DEFAULT 'transaction'
  * config_json : jsonb
  created_at : timestamptz
  updated_at : timestamptz
  ---
  UNIQUE (name, kind)
}

entity "portfolio_import_batches" as portfolio_import_batches {
  * id : bigserial <<PK>>
  * adapter_name : text
  source_filename : text
  source_size_bytes : bigint
  custom_config : jsonb
  default_asset_class : text
  default_type : text DEFAULT 'buy'
  * status : text DEFAULT 'pending'
  rows_total : integer
  rows_imported : integer
  rows_duplicate : integer
  rows_error : integer
  error_summary : text
  started_at : timestamptz
  completed_at : timestamptz
}

entity "portfolio_import_staging_rows" as portfolio_import_staging_rows {
  * id : bigserial <<PK>>
  * batch_id : bigint <<FK>>
  * row_index : integer
  raw_date : text
  type : text
  symbol : text
  name : text
  units : numeric
  price : numeric
  amount : numeric
  fees : numeric
  taxes : numeric
  currency : varchar(3)
  fx_rate : numeric
  note : text
  resolved_investment_id : integer <<FK>>
  user_override_investment_id : integer <<FK>>
  match_source : text
  * status : text DEFAULT 'pending'
  error_detail : text
  committed_txn_id : integer <<FK>>
}

entity "exchange_rate_cache" as exchange_rate_cache {
  * id : serial <<PK>>
  * base : text
  * quote : text
  * rate : numeric
  * as_of : date
  source : text
  ---
  UNIQUE (base, quote, as_of)
}

entity "cashflow_forecast_mc" as cashflow_forecast_mc {
  * id : uuid <<PK>>
  params_hash : text
  paths : jsonb
  computed_at : timestamptz
  ttl_seconds : integer
}

entity "cashflow_forecast_mc_rolling" as cashflow_forecast_mc_rolling {
  * id : uuid <<PK>>
  params_hash : text
  paths : jsonb
  computed_at : timestamptz
}

entity "cashflow_forecast_accuracy" as cashflow_forecast_accuracy {
  * id : bigserial <<PK>>
  snapshot_id : uuid <<FK>>
  metrics : jsonb
  observed_at : timestamptz
}

entity "agg_recipient_totals" as agg_recipient_totals {
  * recipient_id : integer <<PK>>
  total_eur : numeric
  count : integer
  updated_at : timestamptz
  ---
  trigger-maintained (Phase 1)
}

entity "agg_split_outstanding" as agg_split_outstanding {
  * recipient_id : integer <<PK>>
  outstanding_eur : numeric
  updated_at : timestamptz
  ---
  trigger-maintained (Phase 1)
}

entity "ing_raw_transactions" as ing_raw_transactions {
  * id : serial <<PK>>
  * file_hash : text
  raw_record : jsonb
  imported_at : timestamptz
}

entity "db_editor_audit" as db_editor_audit {
  * id : bigserial <<PK>>
  * table_name : text
  * op : text
  pk_json : jsonb
  before_json : jsonb
  after_json : jsonb
  * statement : text
  * created_at : timestamptz
}

note bottom of provider_health
  Rolling-window admin observability hub (ADR-034).
  See providerHealthRepository.js for query patterns.
end note

note bottom of tags
  Orthogonal labelling dimension (ADR-052).
  Slug-based, soft-delete via is_active.
end note

note bottom of import_batches
  Drives the staging / validate / match / commit pipeline
  in services/importPipeline.
end note

note bottom of custom_parser_configs
  Saved named custom CSV parser configs (ADR-066, ADR-078).
  kind='transaction' — budgeting import; kind='portfolio' — portfolio import.
  name doubles as bank_account/source label on imported transactions.
  UNIQUE (name, kind) added by migration 0041.
end note

note bottom of portfolio_import_batches
  Portfolio CSV import batches (ADR-078, migration 0040).
  Mirrors import_batches but portfolio-shaped.
  Included in BACKUP_COVERED_TABLES.
end note

note bottom of db_editor_audit
  Committed-SQL audit trail for the admin DB data editor (ADR-101, migration 0059).
  One row per committed statement; written inside the same transaction as the change.
  Indexed on (table_name, created_at DESC).
end note

' Materialized views (read-only projections — listed for reference)
note as MV_NOTE
  Materialized views (refreshed by materializedViewService):
   - mv_monthly_summary
   - mv_category_totals
   - mv_cashflow_daily
   - mv_bank_balances
   - mv_recipient_monthly
end note

attachments }o--|| transactions
transaction_tags }o--|| transactions
transaction_tags }o--|| tags
provider_health ..> "external\nproviders" : observes
import_staging_rows }o--|| import_batches
import_staging_rows }o--o| recipients : resolved_recipient_id
import_staging_rows }o--o| recipients : user_override_recipient_id
import_staging_rows }o--o| recipient_bank_accounts : resolved_bank_account_id
portfolio_import_staging_rows }o--|| portfolio_import_batches
portfolio_import_staging_rows }o--o| investments : resolved_investment_id
portfolio_import_staging_rows }o--o| investments : user_override_investment_id
cashflow_forecast_accuracy }o--|| cashflow_forecast_mc
agg_recipient_totals }o--|| recipients
agg_split_outstanding }o--|| recipients

@enduml
