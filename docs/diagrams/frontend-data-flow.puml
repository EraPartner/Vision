@startuml Frontend Data Flow & API Layer
title Frontend Data Flow & API Layer

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Frontend" {
  class Pages <<React Component>>
  class PortfolioImportSession <<ADR-177>>
  class PortfolioSummaries
  class PortfolioSummaryQuery
  class PortfolioImportDetection
  class PortfolioHistoryQueries
  class DashboardVisibleQueries
  class ImportReviewEditQueue
  class WidgetSaveQueue
  class PortfolioImportsApi
  class "tab sessionStorage" as ImportSessionStorage
  
  class Hooks {
    useTransactions
    useCategories
    useCategoryTree
    useRecipients
    usePlannedPayments
    usePortfolio
    useStatistics
    useDossiers
    useMonitors
  }
  
  package "API Client" {
    class ApiClient {
      -baseUrl: string
      -request<T>(config): Promise<T>
      -retry(maxAttempts): Promise<T>
      -cancelAll(): void
    }
    
    class API_BASE_URL
    
    class DEFAULT_TIMEOUT_MS
    class MAX_RETRIES
    class RETRYABLE_STATUS_CODES
  }
  
  package "Types" {
    class Transaction
    class Category
    class Recipient
    class PlannedTransaction
    class Investment
    class PortfolioTransaction
    class ExchangeRate
    class Watchlist
    class SavedChart
    class Split
    
    class TransactionCreate
    class TransactionUpdate
    class CategoryCreate
    class CategoryUpdate
    class RecipientCreate
    class RecipientUpdate
    class PlannedTransactionCreate
    class InvestmentCreate
    class InvestmentUpdate
    class PortfolioTransactionCreate
  }
  
  package "Utilities" {
    class formatCurrency
    class numberFormatToLocale
    class categoryColors
  }
  
  package "i18n" {
    class "en (English)" as en
    class "nl (Dutch)" as nl
  }
}

package "Backend (Node.js)" {
  class "POST /api/belgian-tax/compute" as BelgianTaxCompute
  class "GET /api/belgian-tax/overview" as BelgianTaxOverview
  class RESTEndpoints
  class ExpressRoutes
  class Repositories
  class Services
  class "Database (PostgreSQL)" as Database
}

package "Shared TypeScript" {
  class "PIT / household engine" as SharedBelgianTax
}
class "API client" as TaxApiClient

package "External Services" {
  class "ECB (Exchange Rates)" as ECB
  class "Binance (Crypto Prices)" as Binance
  class "YahooFinance (Stock Prices)" as YahooFinance
  class "Kinesis (US Stock Prices)" as Kinesis
  class "Statbel (Belgian Inflation)" as Statbel
}

TaxApiClient --> BelgianTaxOverview : selected year / frozen sources
BelgianTaxOverview --> Repositories : one settings snapshot; no writes
BelgianTaxOverview --> SharedBelgianTax : shared hydration; compute only unfrozen values
TaxApiClient --> BelgianTaxCompute : typed household / Decimal results
BelgianTaxCompute --> SharedBelgianTax : stateless preview
Pages --> TaxApiClient : tax store hydration (overview) / debounced compute (ADR-217)

' Relationships
Pages --> PortfolioImportSession
PortfolioImportSession --> PortfolioImportDetection : complete CSV / Saxo XLSX detection
PortfolioImportSession --> PortfolioImportsApi : sequential SSE; optional asset scope; bounded zero policy; retained source scope; preview/commit hash
PortfolioImportSession --> ImportSessionStorage : staged batch metadata only
PortfolioImportsApi --> ApiClient : strict JSON reconciliation / multipart upload
PortfolioImportSession --> QueryClient : invalidate confirmed committed scope
Hooks --> PortfolioSummaries : metadata + CRUD transactions
PortfolioSummaries --> PortfolioSummaryQuery : active holdings / loading / errors
PortfolioSummaryQuery --> ApiClient : GET /api/info/portfolio-summary?currency
Hooks --> ApiClient
ApiClient --> RESTEndpoints

Types --> ApiClient
ApiClient --> Types

formatCurrency --> locale

Pages --> Hooks
Pages --> Components

RESTEndpoints --> Repositories
Repositories --> Database
Pages --> useDossiers : dossier library and editor
useDossiers --> ApiClient : /api/research-dossiers
Pages --> useMonitors : rule editor and inbox
useMonitors --> ApiClient : /api/analysis/monitors

CurrencyConversionService --> ECB
PriceProviderService --> Binance
PriceProviderService --> YahooFinance
PriceProviderService --> Kinesis
BelgianInflationService --> Statbel

package "PDF reports" {
  class "taxReportContext.ts\nfrozen or server-computed figures" as OriginalReportContext
  class "POST /api/reports/{type}\napplication/pdf" as BinaryReportAPI
}
Pages --> OriginalReportContext : ExportDialog tax context
Pages --> BinaryReportAPI : ExportDialog submission
BinaryReportAPI --> Repositories : existing PDF source data

Pages --> DashboardVisibleQueries : hydrated visible widgets only
DashboardVisibleQueries --> ApiClient : selected filtered / unfiltered inputs
Hooks --> PortfolioHistoryQueries : explicit recent or complete consumer
PortfolioHistoryQueries --> ApiClient : bulk windows or paged history; errors propagate
Pages --> ImportReviewEditQueue : recipient/category edits then commit
ImportReviewEditQueue --> ApiClient : serialized edits; failed edit blocks commit
Hooks --> WidgetSaveQueue : module-owned debounce survives navigation
WidgetSaveQueue --> ApiClient : serialized setting writes

@enduml
