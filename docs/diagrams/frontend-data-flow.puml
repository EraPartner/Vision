@startuml Frontend Data Flow & API Layer
title Frontend Data Flow & API Layer

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Frontend" {
  class Pages <<React Component>>
  
  class Hooks {
    useTransactions
    useCategories
    useCategoryTree
    useRecipients
    usePlannedPayments
    usePortfolio
    useStatistics
    useDossiers
    useMonitors
  }
  
  package "API Client" {
    class ApiClient {
      -baseUrl: string
      -request<T>(config): Promise<T>
      -retry(maxAttempts): Promise<T>
      -cancelAll(): void
    }
    
    class API_BASE_URL
    
    class DEFAULT_TIMEOUT_MS
    class MAX_RETRIES
    class RETRYABLE_STATUS_CODES
  }
  
  package "Types" {
    class Transaction
    class Category
    class Recipient
    class PlannedTransaction
    class Investment
    class PortfolioTransaction
    class ExchangeRate
    class Watchlist
    class SavedChart
    class Split
    
    class TransactionCreate
    class TransactionUpdate
    class CategoryCreate
    class CategoryUpdate
    class RecipientCreate
    class RecipientUpdate
    class PlannedTransactionCreate
    class InvestmentCreate
    class InvestmentUpdate
    class PortfolioTransactionCreate
  }
  
  package "Utilities" {
    class formatCurrency
    class numberFormatToLocale
    class categoryColors
  }
  
  package "i18n" {
    class "en (English)" as en
    class "nl (Dutch)" as nl
  }
}

package "Backend (Node.js)" {
  class RESTEndpoints
  class ExpressRoutes
  class Repositories
  class Services
  class "Database (PostgreSQL)" as Database
}

package "External Services" {
  class "ECB (Exchange Rates)" as ECB
  class "Binance (Crypto Prices)" as Binance
  class "YahooFinance (Stock Prices)" as YahooFinance
  class "Kinesis (US Stock Prices)" as Kinesis
  class "Statbel (Belgian Inflation)" as Statbel
}

' Relationships
Hooks --> ApiClient
ApiClient --> RESTEndpoints

Types --> ApiClient
ApiClient --> Types

formatCurrency --> locale

Pages --> Hooks
Pages --> Components

RESTEndpoints --> Repositories
Repositories --> Database
Pages --> useDossiers : dossier library and editor
useDossiers --> ApiClient : /api/research-dossiers
Pages --> useMonitors : rule editor and inbox
useMonitors --> ApiClient : /api/analysis/monitors

CurrencyConversionService --> ECB
PriceProviderService --> Binance
PriceProviderService --> YahooFinance
PriceProviderService --> Kinesis
BelgianInflationService --> Statbel

@enduml
