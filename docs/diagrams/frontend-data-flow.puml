}
class "Native TaxComputationService" as NativeTax

package "External Services" {
  class "ECB (Exchange Rates)" as ECB
  class "Binance (Crypto Prices)" as Binance
  class "YahooFinance (Stock Prices)" as YahooFinance
  class "Kinesis (US Stock Prices)" as Kinesis
  class "Statbel (Belgian Inflation)" as Statbel
}

NativeTax --> BelgianTaxOverview : selected year / frozen sources
BelgianTaxOverview --> Repositories : one settings snapshot; no writes
BelgianTaxOverview --> SharedBelgianTax : shared hydration; compute only unfrozen values
NativeTax --> BelgianTaxCompute : typed household / Decimal results
BelgianTaxCompute --> SharedBelgianTax : stateless preview
Pages --> SharedBelgianTax : existing lazy-loaded web tax store

' Relationships
Pages --> PortfolioImportSession
PortfolioImportSession --> PortfolioImportDetection : complete CSV / Saxo XLSX detection
PortfolioImportSession --> PortfolioImportsApi : sequential SSE; optional asset scope; bounded zero policy; retained source scope; preview/commit hash
PortfolioImportSession --> ImportSessionStorage : staged batch metadata only
PortfolioImportsApi --> ApiClient : strict JSON reconciliation / multipart upload
PortfolioImportSession --> QueryClient : invalidate confirmed committed scope
Hooks --> PortfolioSummaries : metadata + CRUD transactions
PortfolioSummaries --> PortfolioSummaryQuery : active holdings / loading / errors
PortfolioSummaryQuery --> ApiClient : GET /api/info/portfolio-summary?currency
Hooks --> ApiClient
ApiClient --> RESTEndpoints

Types --> ApiClient
ApiClient --> Types

formatCurrency --> locale

Pages --> Hooks
Pages --> Components

RESTEndpoints --> Repositories
Repositories --> Database
Pages --> useDossiers : dossier library and editor
useDossiers --> ApiClient : /api/research-dossiers
Pages --> useMonitors : rule editor and inbox
useMonitors --> ApiClient : /api/analysis/monitors

CurrencyConversionService --> ECB
PriceProviderService --> Binance
PriceProviderService --> YahooFinance
PriceProviderService --> Kinesis
BelgianInflationService --> Statbel

package "Native Settings single writer (phase 3o)" {
  class NativeSettingsWindow
  class NativeSettingsModel
  class NativeSettingsPersistence
  class NativeSessionAPITransport
  class NativeDataSession
  class "nativeSettings.ts" as NativeSettingsMirror
  class "shell:settings-change" as NativeSettingsDelta
  class "GET /api/settings\nPUT /api/settings/:key {value, expected}" as NativeSettingsAPI
}
NativeSettingsWindow --> NativeSettingsModel : source control edit
NativeSettingsModel --> NativeSettingsPersistence : 500 ms / per-key serialized write
NativeSettingsPersistence --> NativeSessionAPITransport : shared APIClient request
NativeSessionAPITransport --> NativeDataSession : mutation admission / completion / delivery guard
NativeSessionAPITransport --> NativeSettingsAPI : original raw CAS expected token
NativeSettingsAPI --> Repositories : existing validation / conditional replacement
NativeSettingsModel --> NativeSettingsMirror : draft then acknowledged receipt
NativeSettingsMirror --> Pages : retained route / immediate display mirror
Pages --> NativeSettingsDelta : supported app / dashboard / theme field deltas
NativeSettingsDelta --> NativeSettingsModel : restricted native-only bridge
note right of NativeSettingsMirror
  Native mode disables three competing web hydration writers.
  Drafts do not advance server baselines.
  Existing widget/other-key writers are unchanged.
end note

note right of NativeDataSession
  Confirmed restore pauses new mutations and drains accepted transports.
  Paused reads refuse admission; earlier read epochs stay invalid on failure.
  Failure resumes the same session; success retires old delivery.
  Main pending drafts/baselines have a separate lifecycle fence.
  UUID-owned SDK restore serves Settings and retained onboarding.
  Fresh graph rebuild is shared by native reload and renderer-ready.
  Portable transport cases pass; SDK/macOS verification remains pending.
end note


package "Native reports and loaded-page print (phase 3p)" {
  class NativeReportSheet
  class NativeReportModel
  class NativeTaxReportContextService
  class "taxReportContext.ts\nfresh five-key snapshot / source engine" as OriginalReportContext
  class "POST /api/reports/{type}\napplication/pdf" as BinaryReportAPI
  class "Loaded Tax / Statistics / Net worth snapshots" as NativePagePrintSnapshots
  class "Inert Tax / Statistics / Net worth documents" as NativePagePrintDocuments
  class "ShellController current-page print" as NativePagePrintDispatch
  class NativePagePrintPagesView
  class NativePagePrintTableBlock
}
NativeReportSheet --> NativeReportModel : source form / same-page draft
NativeReportModel --> NativeTaxReportContextService : requested fiscal year
NativeTaxReportContextService --> OriginalReportContext : fixed callback / extreme-year fallback
NativeReportModel --> NativeDataSession : one attempt / 900s binary client
NativeDataSession --> BinaryReportAPI : existing route / raw Decimal body
BinaryReportAPI --> Repositories : existing PDF source data
NativePagePrintDispatch --> NativePagePrintSnapshots : capture active route / loaded figures / visible state
NativeTax --> NativePagePrintSnapshots : selected year / visible widgets / disclosures
NativePagePrintSnapshots --> NativePagePrintDocuments : immutable presentation / no reads or fiscal math
NativePagePrintDocuments --> NativePagePrintPagesView : ordinary frozen sections / actual content width
NativePagePrintDocuments --> NativePagePrintTableBlock : header / ordered rows / final footer / stable columns
NativePagePrintTableBlock --> NativePagePrintPagesView : measured rows / repeated continuation headers
NativePagePrintPagesView --> NativePagePrintDispatch : remeasured paper bounds / NSPrintOperation

class NativeRendererReadiness
NativeSettingsWindow --> NativeRendererReadiness : await actual document commit before ready startup

@enduml
