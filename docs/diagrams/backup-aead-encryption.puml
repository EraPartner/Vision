@startuml Backup AEAD Encryption (v2)
title Backup AEAD Encryption (v2 — AES-256-GCM)

!theme plain
skinparam participantSpacing 10
skinparam ranksep 50

actor "User" as User

participant "BackupTab\n(settings)" as UI
participant "useBackup" as Hook
participant "Electron main\n(packaging/electron/main.ts)" as Main
participant "backup service\n(backup/restore.ts)" as Backup
database  "PostgreSQL" as DB
participant "Attachments\n($ATTACHMENTS_DIR)" as Files
participant "localStorage\n(frontend-state)" as LS

group Create backup
  User -> UI : click "Create backup"\n(+ optional passphrase)
  UI -> Hook : useBackup.create({ passphrase? })
  Hook -> Main : ipc invoke 'backup:run'
  Main -> Main : acquire maintenance guard; pause watchdog
  Main -> Main : drain/pause audit closure; stop backend writer
  Main -> DB   : pg_dump >> bundle/db.sql (PostgreSQL remains running)
  Main -> Files: copy $ATTACHMENTS_DIR/* >> bundle/attachments/
  Main -> Main : finally restart backend; await detailed readiness; resume closure
  Main -> Main : release maintenance guard; resume watchdog
  Main -> LS   : snapshot (theme, preferences) >> bundle/frontend-state.json
  Main -> Backup: encryptBundle(bundle, passphrase)
  Backup -> Backup : v2 header (magic + version + salt)\n+ scrypt(passphrase, salt, N=2^15)\n+ AES-256-GCM(plaintext, key, iv, aad=email)
  Backup -> Main : { ciphertext, iv, tag, salt }
  Main -> Files : write .visionbak.enc
  Main -> UI    : { ok, sha256, bytes, path }
  UI -> User    : toast (checksum + size)
end

group Restore backup
  User -> UI    : select .visionbak.enc
  UI -> Main    : ipc invoke 'backup:restore'
  Main -> Backup: detect magic header
  alt encrypted, no passphrase yet
    Backup -> Main : PASSPHRASE_REQUIRED
    Main -> UI     : prompt
    User -> UI     : passphrase
    UI -> Main     : retry with passphrase
  end
  alt retired v1 magic (VISIONBAK1 / VISIONENC1)
    Backup -> Main : refuse before decryption (ADR-219)
    Main -> UI     : "retired v1 encryption format,\nVision no longer restores it"
  end
  Main -> Backup : decryptBundle(file, passphrase)
  Backup -> Backup : AES-256-GCM verify auth tag\n(detects tampering)
  alt schema check
    Backup -> Main : BUNDLE_SCHEMA_NEWER
    Main -> UI     : "upgrade Vision first"
  end
  Main -> DB    : restore into staged database; retain previous database
  Main -> Main  : persist attachment switch intent before renames
  Main -> Files : activate staged attachment tree; retain previous tree
  Main -> Main  : require readiness and audit verification before finalization
  alt verification succeeds
    Main -> DB : finalize database journal
    Main -> Files : finalize attachment journal
  else activation or verification fails
    Main -> Files : restore previous attachment tree
    Main -> DB : roll back database switch
  end
  Main -> LS    : hydrate frontend-state.json
  Main -> UI    : { ok }
  UI -> User    : reload window
end

note right of Backup
  v2 upgrade (ADR-040):
  - AES-256-GCM AEAD (was CBC + manual mac)
  - per-backup random salt (was static)
  - scrypt N=2^15 (was 2^14)
  - v1 (CBC) files are refused by magic
    header since 2026-10-19 (ADR-219).
end note

note right of Main
  Coverage: declared user-data tables,
  attachment tree and frontend state.
  Next startup resolves interrupted switch journals
  before ordinary database setup.
  CI enforces coverage on every migration.
end note

@enduml
