@startuml Recipient Merge Sequence Diagram
title Recipient Merge Sequence Diagram

!theme plain
skinparam participantSpacing 10
skinparam ranksep 45
skinparam linetype ortho

actor "User" as User

participant "RecipientsPage" as Page
participant "useRecipients" as Hook
participant "ApiClient" as API
participant "RecipientsRouter" as Router
participant "RecipientMergeService" as Service
participant "Repositories" as Repos
participant "PostgreSQL" as DB

group View aliases
  User -> Page : View Recipient Details
  Page -> Hook : getRecipients({search})
  Hook -> API : GET /api/recipients
  API -> Router : /recipients
  Router -> Repos : getAll()
  Repos -> DB : SELECT recipients
  DB -> Repos : recipients with aliases
  Repos -> Router : list
  Router -> API : JSON
  API -> Hook : RecipientsResponse
  Hook -> Page : display list
end

group Merge action
  User -> Page : Select Aliases + Click "Merge Selected"
  Page -> Hook : mergeRecipients(primaryId, aliasIds)
  Hook -> API : POST /api/recipients/:id/merge

  API -> Router : POST /recipients/:id/merge { alias_ids: [...] }
  Router -> Service : mergeRecipients(primaryId, aliasIds)

  Service -> Repos : lock primary + repoint foreign keys
  Repos -> DB : UPDATE dependent rows
  DB -> Repos : updated counts

  Service -> Repos : flagAliasesOf() + repointGrandchildAliases()
  Repos -> DB : UPDATE recipient alias relationships
  DB -> Repos : merged alias ids

  Repos -> Service : merge results
  Service -> Router : {mergedAliasIds, reassigned}
  Router -> Router : fetch primary/aliases + build patternSuggestion
  Router -> API : JSON
  API -> Hook : { primary, merged_ids, reassigned, aliases, patternSuggestion }
  Hook -> Hook : invalidate useRecipients cache
  Hook -> Page : refresh
  Page -> User : Show Success Message
end

group Unmerge action
  User -> Page : Click "Unmerge"
  Page -> Hook : unmergeRecipient(aliasId)
  Hook -> API : POST /api/recipients/:aliasId/unmerge

  API -> Router : POST /recipients/:aliasId/unmerge
  Router -> Repos : unmergeRecipient(aliasId)

  Repos -> DB : UPDATE recipients SET primary_recipient_id = NULL WHERE id = aliasId
  DB -> Repos : updated

  Repos -> Router : unmerged recipient
  Router -> API : JSON
  API -> Hook : Recipient
  Hook -> Page : refresh list
end

note over Page
  Merge: Aliases -> Primary
  Unmerge: Alias becomes independent
end note

@enduml
