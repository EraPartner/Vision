@startuml Frontend State Management
title Frontend State Management

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Frontend State Providers and Hooks" {
  class ThemeHydration {
    +theme: "light" | "dark" | "system" | "schedule"
    +scheduleStartTime: string
    +scheduleEndTime: string
    +effectiveTheme: "light" | "dark"
    +setTheme(theme): void
    +setScheduleTimes(start, end): void
    +toggleTheme(): void
  }

  class SettingsPreloadContext {
    +preloadedSettings: Settings | null
    +isPreloaded: boolean
  }

  class SettingsHydration {
    +settings: UserSettings
    +updateSettings(updates): Promise<void>
    +isLoading: boolean
  }

  class AppSettingsHydration {
    +appSettings: AppSettings
    +updateAppSettings(updates): Promise<void>
    +language: Language
    +setLanguage(lang): void
  }

  class BelgianTaxProfileContext {
    +taxProfile: TaxProfile
    +taxYear: number
    +calculations: TaxCalculations
    +updateProfile(updates): Promise<void>
    +setTaxYear(year): void
    +isLoading: boolean
  }

  class WorkspaceHook {
    +workspace: "budgeting" | "portfolio"
    +setWorkspace(ws): void
    --
    Note: Route-derived for /portfolio/*,
    sessionStorage-persisted for /admin/*,
    defaults to budgeting for all others
  }
}

package "React Query (Server State)" {
  class QueryClient {
    +defaultOptions: QueryOptions
    +staleTime: 30000ms
    +gcTime: 5min
  }

  class QueryKeys {
    +TRANSACTIONS: ["transactions"]
    +CATEGORIES: ["categories"]
    +RECIPIENTS: ["recipients"]
    +PLANNED_PAYMENTS: ["planned-payments"]
    +INVESTMENTS: ["investments"]
    +PORTFOLIO: ["portfolio"]
    +STATISTICS: ["statistics"]
    +SETTINGS: ["settings"]
    +WATCHLIST: ["watchlist"]
  }
}

package "Custom Hooks (Business Logic)" {
  class useTransactions {
    +transactions: Transaction[]
    +isLoading: boolean
    +create(data): Promise<Transaction>
    +update(id, data): Promise<Transaction>
    +delete(id): Promise<void>
    +refetch(): void
  }

  class useCategories {
    +categories: Category[]
    +create(data): Promise<Category>
    +update(id, data): Promise<Category>
    +delete(id): Promise<void>
  }

  class useRecipients {
    +recipients: Recipient[]
    +create(data): Promise<Recipient>
    +update(id, data): Promise<Recipient>
    +delete(id): Promise<void>
    +merge(primaryId, aliasIds): Promise<void>
    +unmerge(aliasId): Promise<void>
  }

  class usePlannedPayments {
    +plannedPayments: PlannedTransaction[]
    +create(data): Promise<PlannedTransaction>
    +update(id, data): Promise<PlannedTransaction>
    +execute(id, transactionId): Promise<void>
    +delete(id): Promise<void>
  }

  class usePortfolio {
    +investments: Investment[]
    +portfolioTransactions: PortfolioTransaction[]
    +createInvestment(data): Promise<Investment>
    +updateInvestment(id, data): Promise<Investment>
    +deleteInvestment(id): Promise<void>
    +createPortfolioTransaction(data): Promise<PortfolioTransaction>
  }

  class usePortfolioSummaryQuery {
    +canonical active holdings / custody / gains
    +loading / error / refetch
  }

  class useAccountPositions <<ADR-091, ADR-100>> {
    ' hooks/portfolio/useAccountPositions.ts
    +byAccount: AccountPositionRow[]
    ' AccountPositionRow: { account_id, currentValue, totalInvested, gainLoss }
    +isLoading: boolean
  }

  class useAccountNetWorth <<ADR-093, ADR-100>> {
    ' hooks/portfolio/useAccountNetWorth.ts
    +rows: AccountNetWorthRow[]
    ' AccountNetWorthRow: { account, cash, holdings, total }
    +isLoading: boolean
  }

  class useStatistics {
    +data: StatisticsData
    +unfilteredData: StatisticsData
    +getGraphData(key): StatisticsData
    +graphExclusions: GraphExclusions
    +toggleGraphExclusion(key): void
    +exclusionsApply: boolean
    +isLoading: boolean
    +isError: boolean
    +error: Error | null
  }

  class useOwedSummary {
    +summary: OwedSummary[]
    +isLoading: boolean
  }

  class useOwedByRecipient {
    +owedData: OwedData
    +recipientId: number
  }

  class useSplitsByTransaction {
    +splits: Split[]
    +transactionId: number
  }

  class useCreateSplits {
    +create(transactionId, splits): Promise<Split[]>
  }

  class useRecordPayment {
    +addPayment(splitId, amount, note): Promise<Payment>
  }

  class useSettleSplit {
    +settle(id): Promise<Split>
  }

  class useSettleAllSplitsByRecipient {
    +settleAllByRecipient(recipientId): Promise<{ settled_count: number }>
  }

  class useDeleteSplit {
    +delete(id): Promise<void>
  }

  class useSavedCharts {
    +charts: SavedChart[]
    +create(data): Promise<SavedChart>
    +update(id, data): Promise<SavedChart>
    +delete(id): Promise<void>
  }

  class useMonitors <<ADR-154>> {
    +paged rules and observations
    +inbox and unread count
    +create, edit, check, read, delete
    note bottom: PostgreSQL owns due times, history,
    episodes, and read state; React Query caches views only.
  }

  class usePortfolioTaxAdjustments {
    +adjustments: TaxAdjustment[]
    +byYear(year): TaxAdjustment[]
    +setManyForYear(year, adjustments): Promise<void>
    +saveManyForYear(year, adjustments): Promise<void>
    +create(data): Promise<TaxAdjustment>
    +delete(id): Promise<void>
  }

  class useFilteredDashboardStats {
    +filteredStats: StatisticsData
    +isLoading: boolean
  }
}

package "Utility Hooks" {
  class useDebounce
  class useToast
  class useWidgetVisibility
  class useIsMobile
  class useConfirmDialog
  class useTabParam <<Aug 2026>> {
    ' hooks/useTabParam.ts
    +[activeTab, setActiveTab]
    ' binds Tabs value/onValueChange to ?tab= (allow-list validated, replace-writes)
  }
  class useTaxYearParam <<Aug 2026>> {
    ' hooks/useTaxYearParam.ts
    ' mirrors BelgianTaxProfileContext.viewedYear <-> ?year=
    ' mounted on /tax and /portfolio/tax only (route-scoped)
  }
}

' Provider Hierarchy (React Context nesting)
package "Portfolio Import Session State (ADR-177)" {
  class PortfolioImportSession {
    +statements + optional File objects
    +global/per-statement adoption policy
    +XML policy/result/blockers + explicit original import ID
    +effective managed clone/supplemental scope
    +scopeKey + reviewed planFingerprint
    +operation state + blockers
  }
  class "tab sessionStorage" as ImportSessionStorage {
    +staged metadata / batch IDs only
    +no file bytes or commit authority
  }
  class "server staging + history" as ImportSessionServerState
}
PortfolioImportSession --> ImportSessionStorage : resume staged scope
PortfolioImportSession --> ImportSessionServerState : preview then fingerprint-pinned commit
PortfolioImportSession ..> QueryClient : invalidate only confirmed success

package "Provider Stack" {
  class QueryClientProvider
  class ThemeHydration
  class SettingsPreloadContext
  class SettingsHydration
  class AppSettingsHydration
  class BelgianTaxProfileContext
  class LanguageHydration
}

' Hooks consume Query Client (dependency relationship)
useTransactions ..> QueryClient : uses
useCategories ..> QueryClient : uses
useRecipients ..> QueryClient : uses
usePlannedPayments ..> QueryClient : uses
usePortfolio ..> QueryClient : metadata + CRUD
usePortfolio --> usePortfolioSummaryQuery : authoritative active summaries
usePortfolioSummaryQuery ..> QueryClient : shared server state
useStatistics ..> QueryClient : uses
useOwedSummary ..> QueryClient : uses
useOwedByRecipient ..> QueryClient : uses
useSplitsByTransaction ..> QueryClient : uses
useCreateSplits ..> QueryClient : uses
useRecordPayment ..> QueryClient : uses
useSettleSplit ..> QueryClient : uses
useSettleAllSplitsByRecipient ..> QueryClient : uses
useDeleteSplit ..> QueryClient : uses
useSavedCharts ..> QueryClient : uses
useMonitors ..> QueryClient : caches server-owned monitoring state
usePortfolioTaxAdjustments ..> QueryClient : uses
useFilteredDashboardStats ..> QueryClient : uses

' Some hooks consume Settings Context
useStatistics ..> SettingsHydration : uses
useFilteredDashboardStats ..> SettingsHydration : uses

' WorkspaceHook consumes router
WorkspaceHook ..> BrowserRouter : uses

' Aug 2026: URL-state utility hooks
useTabParam ..> BrowserRouter : uses (useSearchParams)
useTaxYearParam ..> BrowserRouter : uses (useSearchParams)
useTaxYearParam ..> BelgianTaxProfileContext : reads/writes viewedYear

package "Retained Zustand settings" {
  class useSettingsStore {
    +appSettings / dashboardSettings / theme state
    +migrated editable values
  }
}
package "Native Settings and retained WK state (phase 3o)" {
  class "ShellController" as NativeSettingsHost {
    +ShellController UUID-owned restore / generation reload
  }
  class NativeDataSession <<actor>> {
    +suspendAndDrain(): async
    +resumeAfterFailedRestore()
    +retireForReload()
    +paused reads refused / read epochs invalidated
  }
  class NativeSettingsModel {
    +migrated app/dashboard editable envelopes
    +unknown fields and optional absence preserved
    +500 ms per-key debounce
    +draft callbacks / acknowledged receipts
  }
  class "NativeSettingsPersistence" as NativeSettingsPersistence {
    +raw first-read CAS baselines
    +serialized per-key writes
    +sticky rejected / uncertain lane
  }
  class "nativeSettings.ts" as NativeSettingsMirror {
    +apply drafts without echo
    +forward supported field deltas
    +advance baseline only from checked receipt
  }
  class NativeSettingsPatch {
    +app_settings / dashboard_settings / theme_settings
    +restricted fields and optional removals
  }
  class NativeNoticeCenter {
    +app-lifetime notices / captured actions
    +six eight-second Undo owners
    +source typing guard / one-slot shortcut
  }
}
NativeSettingsHost --> NativeSettingsModel : suspend drafts / failure resume / success retire
NativeSettingsHost --> NativeDataSession : drain / resume / retire shared + fresh-completion transports
NativeSettingsPersistence ..> NativeDataSession : shared APIClient transport admission
NativeSettingsModel --> NativeSettingsPersistence : existing conditional settings API
NativeSettingsModel --> NativeSettingsMirror : draft then receipt
NativeSettingsMirror --> NativeSettingsPatch : native-only shell:settings-change
NativeSettingsPatch --> NativeSettingsModel : same writer
NativeSettingsMirror --> useSettingsStore : mirror three preference slices
NativeSettingsMirror ..> ThemeHydration : skip competing persistence in native mode
NativeSettingsMirror ..> AppSettingsHydration : skip competing persistence in native mode
NativeSettingsMirror ..> SettingsHydration : skip competing persistence in native mode
NativeSettingsModel ..> NativeNoticeCenter : existing save feedback


package "Native shell overlays and reports (phase 3p)" {
  class NativeCommandPaletteModel
  class NativeShellNotificationsModel
  class NativeOnboardingModel
  class NativeReportModel
  class "Tax / Statistics / Net worth print snapshots" as NativePagePrintSnapshots
  class "Fixed retained TypeScript callbacks" as NativeSourceCallbacks
}
NativeSettingsHost --> NativeCommandPaletteModel : native graph / generation
NativeSettingsHost --> NativeShellNotificationsModel : app-lifetime reminders
NativeSettingsHost --> NativeOnboardingModel : seven-step draft owner
NativeSettingsHost --> NativeReportModel : same-path draft / page-leave reset
NativeCommandPaletteModel --> NativeSourceCallbacks : source answers
NativeReportModel --> NativeSourceCallbacks : original fiscal projection / extreme context
NativeReportModel --> NativeDataSession : binary request / restore fence
NativeOnboardingModel --> NativeSettingsModel : completion writer
NativeSettingsHost --> NativePagePrintSnapshots : active route / immutable visible state / no queries

class NativeRendererReadiness
NativeSettingsHost --> NativeRendererReadiness : actual document commit / checked ready token
class NativeOverlayFocusReturn
NativeSettingsHost --> NativeOverlayFocusReturn : route-window opener / final sheet dismissal
note right of NativeOverlayFocusReturn
  Weak control/field-editor owner and selection.
  Reject stale graph, route, window or restore/reload state.
end note

package "Staged phase 4 (SDK takeover disabled)" {
  class NativeNavigationHistory <<opt-in>>
  class NativeNavigationLocation
  class NativeNavigationStartup <<unwired policy>>
  class NativeRawStateStore <<dormant actor>>
}
NativeNavigationHistory --> NativeNavigationLocation : exact raw query / decoded route
NativeNavigationStartup ..> NativeNavigationHistory : raw seed or document replacement / admission deferred
note right of NativeNavigationLocation
  Raw location and matched parameters stay separate.
  Native-only consumers avoid repeated decoding.
  Numeric-coercion parity remains an activation gate.
end note
note right of NativeRawStateStore
  Explicit origin + website-store identity + complete capture.
  Atomic raw local strings; session map stays in memory.
  Existing host admission and TypeScript helpers remain required.
end note

@enduml
