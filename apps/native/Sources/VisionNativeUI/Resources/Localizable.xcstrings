    "portfolioImport.session.cashFundingHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trade cash and confirmed funding are excluded from income and expenses; a separately quoted funding withdrawal fee remains an expense. Card payments include their quoted fee as spending. Only the recorded broker leg is imported; no opposite bank transaction is created."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handelsbedragen en bevestigde financiering worden uitgesloten van inkomsten en uitgaven; een afzonderlijk vermelde opnamekost blijft een uitgave. Kaartbetalingen bevatten hun vermelde kost als uitgave. Alleen de vastgelegde brokerzijde wordt geïmporteerd; er wordt geen tegenovergestelde banktransactie aangemaakt."
          }
        }
      }
    },
