    "portfolioImport.ibkrFundingParser": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR funding history"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR-financieringsgeschiedenis"
          }
        }
      }
    },
    "portfolioImport.ibkrFundingParserHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the original Excel export from IBKR Transaction Status & History, with Deposit and Withdrawal sheets. Native amounts, currencies, account and reference numbers are read automatically. Choose Correct existing financial values to reconcile funding already imported from Transaction History. Each correction requires an exact match and keeps its existing transaction ID."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de oorspronkelijke Excel-export uit IBKR Transaction Status & History, met de bladen Deposit en Withdrawal. Bedragen, valuta, rekening- en referentienummers worden automatisch gelezen. Kies Bestaande financiële waarden corrigeren om financiering uit de transactiegeschiedenis te reconciliëren. Elke correctie vereist een exacte overeenkomst en behoudt het bestaande transactie-ID."
          }
        }
      }
    },
    "portfolioImport.ibkrParser": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR transaction history"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR-transactiegeschiedenis"
          }
        }
      }
    },
    "portfolioImport.ibkrParserHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In IBKR, export Transaction History as a CSV for trades, income and charges. Its funding amounts use the statement base currency. Also export deposits and withdrawals from Transaction Status & History as an Excel workbook to verify their original amounts and currencies. Select the broker account that receives these events. Forex principal is not a portfolio trade; explicit charges remain cash fees."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer in IBKR de transactiegeschiedenis als CSV voor transacties, inkomsten en kosten. Financieringsbedragen gebruiken de basisvaluta van het afschrift. Exporteer ook stortingen en opnames uit Transaction Status & History als Excel-werkmap om hun oorspronkelijke bedragen en valuta te bewijzen. Selecteer de brokerrekening voor deze gebeurtenissen. Valutaconversies zijn geen portefeuilletransacties; expliciete kosten blijven kaskosten."
          }
        }
      }
    },
