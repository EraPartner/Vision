    "tax.cgtEstimateDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Belgian capital gains tax on financial assets in force since 1 January 2026. The yearly exemption of €10,000 (single) or €20,000 (married) applies. Bond-fund gains fall under the Reynders tax instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Belgische meerwaardebelasting op financiële activa, van kracht sinds 1 januari 2026. De jaarlijkse vrijstelling van €10.000 (alleenstaand) of €20.000 (gehuwd) geldt. Winsten op obligatiefondsen vallen onder de Reynders-taks."
          }
        }
      }
    },
