    "portfolioImport.session.correctReviewed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply reviewed corrections"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerde correcties toepassen"
          }
        }
      }
    },
    "portfolioImport.session.correctionAtomic": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the proven corrections together. Quantities, types, notes and transaction IDs stay unchanged. Dates change only to the broker payment date for a proven complete yield group; its financial values stay unchanged. Ordinary financial corrections retain their dates. No new transactions, duplicate repairs, cash movements or custody transfers are included. Pending events stay queued. A stale preview is rejected."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de bewezen correcties samen toe. Hoeveelheden, types, notities en transactie-ID's blijven ongewijzigd. Datums veranderen alleen naar de betaaldatum van de broker voor een bewezen volledige yield-groep; de financiële waarden blijven ongewijzigd. Gewone financiële correcties behouden hun datums. Er worden geen nieuwe transacties, duplicatenherstellingen, geldbewegingen of bewaarnemingsoverdrachten opgenomen. Resterende gebeurtenissen blijven klaarstaan. Een verouderde controle wordt geweigerd."
          }
        }
      }
    },
    "portfolioImport.session.correctionCounts": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 new transactions; {adopted} existing records to correct; {pending} events remain pending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nieuwe transacties; {adopted} bestaande records om te corrigeren; {pending} gebeurtenissen blijven in afwachting."
          }
        }
      }
    },
    "portfolioImport.session.correctionHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this scope for native IBKR funding exports or complete Kinesis statements. Correct proven financial differences using the original broker records and retained source evidence. IBKR funding corrections keep the existing records and use their original amounts and currencies. Kinesis can also correct proven yield payment dates; new acquisitions and income remain pending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies deze scope voor oorspronkelijke IBKR-financieringsexports of volledige Kinesis-afschriften. Corrigeer bewezen financiële verschillen met de oorspronkelijke brokergegevens en bewaard bronbewijs. IBKR-financieringscorrecties behouden de bestaande records en gebruiken de oorspronkelijke bedragen en valuta. Kinesis kan ook bewezen betaaldatums van opbrengsten corrigeren; nieuwe verwervingen en inkomsten blijven openstaan."
          }
        }
      }
    },
    "portfolioImport.session.correctionPolicyHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use proven source values while keeping quantities, types, notes and transaction IDs. Ordinary financial corrections retain dates; only a proven complete yield group can use its broker payment date. Review every proposed correction below."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik bewezen bronwaarden en behoud hoeveelheden, types, notities en transactie-ID's. Gewone financiële correcties behouden datums; alleen een bewezen volledige yield-groep kan de betaaldatum van de broker gebruiken. Controleer hieronder elke voorgestelde correctie."
          }
        }
      }
    },
    "portfolioImport.session.correctionUnavailable": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing corrections require only complete Kinesis statements and using proven source facts. Remove asset filters or conflicting statement policies, or choose full history."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande records corrigeren vereist uitsluitend volledige Kinesis-overzichten en het gebruik van bewezen brongegevens. Verwijder filters voor beleggingen of tegenstrijdig beleid per bestand, of kies de volledige historiek."
          }
        }
      }
    },
