    "portfolioImport.session.incomeAtomic": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the reviewed paired income together. Existing units, acquisitions, values and notes stay unchanged. Literal income is kept separately and does not add to gains again. No duplicate repairs, cash movements or custody transfers are included. Other events stay queued if incomplete. A stale preview is rejected."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg de gecontroleerde bijbehorende inkomsten samen vast. Bestaande eenheden, verwervingen, waarden en notities blijven ongewijzigd. Letterlijke inkomsten worden afzonderlijk bewaard en niet opnieuw bij de winst opgeteld. Er worden geen duplicatenherstellingen, geldbewegingen of bewaarnemingsoverdrachten opgenomen. Andere gebeurtenissen blijven klaarstaan als de sessie onvolledig is. Een verouderde controle wordt geweigerd."
          }
        }
      }
    },
    "portfolioImport.session.incomeCounts": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 new acquisitions; {recorded} income records to record; {pending} events remain pending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nieuwe verwervingen; {recorded} inkomstenrecords om vast te leggen; {pending} gebeurtenissen blijven in afwachting."
          }
        }
      }
    },
    "portfolioImport.session.incomeHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this scope before staging complete Kinesis statements. Record literal income only when its paired zero-basis acquisition is already proved in existing history. No new units, acquisitions or cash movements are created. Other events remain pending. The original statement and acquisition receipts provide the evidence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies deze scope voordat je volledige Kinesis-afschriften klaarzet. Leg letterlijke inkomsten alleen vast als de bijbehorende verwerving met nulbasis al in de bestaande historie is bewezen. Er ontstaan geen nieuwe eenheden, verwervingen of kasbewegingen. Andere gebeurtenissen blijven openstaan. Het oorspronkelijke afschrift en de verwervingsbewijzen leveren het bewijs."
          }
        }
      }
    },
    "portfolioImport.session.incomePartialSuccess": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded {recordedIncome} proven income records; 0 new acquisitions; {pending} events remain pending. Statements stay queued for a fresh review."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{recordedIncome} bewezen inkomstenrecords vastgelegd; 0 nieuwe verwervingen; {pending} gebeurtenissen blijven in afwachting. Overzichten blijven klaarstaan voor een nieuwe controle."
          }
        }
      }
    },
    "portfolioImport.session.incomePolicyHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve existing acquisitions and record only their proven paired income. The income amount is retained separately because its value is already represented by the units."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud bestaande verwervingen en leg alleen hun bewezen bijbehorende inkomsten vast. Het inkomstenbedrag wordt afzonderlijk bewaard omdat de waarde al in de eenheden zit."
          }
        }
      }
    },
    "portfolioImport.session.incomeSuccess": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded {recordedIncome} proven income records; 0 new acquisitions. Existing units stay unchanged."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{recordedIncome} bewezen inkomstenrecords vastgelegd; 0 nieuwe verwervingen. Bestaande eenheden blijven ongewijzigd."
          }
        }
      }
    },
    "portfolioImport.session.incomeUnavailable": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-kind income requires only complete Kinesis statements and preserving proved existing units. Remove asset filters or conflicting statement policies, or choose full history."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten in natura vereisen alleen volledige Kinesis-overzichten en het behoud van bewezen bestaande eenheden. Verwijder actiefilters of tegenstrijdig overzichtsbeleid, of kies de volledige historiek."
          }
        }
      }
    },
    "portfolioImport.session.more": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show more rows"
          }
        },
        "nl": {
