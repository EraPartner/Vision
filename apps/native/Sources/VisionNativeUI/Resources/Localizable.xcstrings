      }
    },
    "admin.audit.transferExplanation": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a new Mac, export a password-protected audit transfer on the old Mac. Import it on the new Mac before restoring the matching backup. Keep the password separate from the file."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer op de oude Mac een met een wachtwoord beveiligde auditoverdracht. Importeer die op de nieuwe Mac voordat je de bijbehorende back-up herstelt. Bewaar het wachtwoord apart van het bestand."
          }
        }
      }
    },
    "admin.audit.transferExport": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export protected transfer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiligde overdracht exporteren"
          }
        }
      }
    },
    "admin.audit.transferFailed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
