    "portfolioImport.session.attachmentAtomic": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach the reviewed source records together. Recorded dates and financial values stay unchanged, including grouped yield matches; broker payment dates remain source evidence. No new transactions or duplicate repairs are included. Remaining events and the reference stay queued if the session is incomplete. A stale preview is rejected."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel de gecontroleerde bronrecords samen. Vastgelegde datums en financiële waarden blijven ongewijzigd, ook bij gegroepeerde yield-koppelingen; betaaldatums van de broker blijven bronbewijs. Er worden geen nieuwe transacties of duplicatenherstellingen opgenomen. Resterende gebeurtenissen blijven klaarstaan als de sessie onvolledig is. Een verouderde controle wordt geweigerd."
          }
        }
      }
    },
    "portfolioImport.session.attachmentCounts": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 new transactions; {adopted} existing records to attach; {pending} events remain pending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nieuwe transacties; {adopted} bestaande records om te koppelen; {pending} gebeurtenissen blijven in afwachting."
          }
        }
      }
    },
    "portfolioImport.session.attachmentHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this scope before staging complete Kinesis statements. Attach only proven existing records while preserving their dates and financial values, including the recorded zero basis of existing yield-unit receipts. Records without enough broker evidence, new acquisitions and income remain pending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies deze scope voordat je volledige Kinesis-afschriften klaarzet. Koppel alleen bewezen bestaande records en behoud hun datums en financiële waarden, inclusief de vastgelegde nulbasis van bestaande opbrengsteenheden. Records zonder voldoende brokerbewijs, nieuwe verwervingen en inkomsten blijven openstaan."
          }
        }
      }
    },
