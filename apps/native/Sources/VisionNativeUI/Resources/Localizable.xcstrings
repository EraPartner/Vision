    "admin.audit.exportLimit": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export includes the complete retained history of at most 500 entries and 2 MB. The file is not independently protected evidence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De export bevat de volledige bewaarde geschiedenis van maximaal 500 vermeldingen en 2 MB. Het bestand is geen onafhankelijk beschermd bewijs."
          }
        }
      }
    },
    "admin.audit.exportSuccess": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
