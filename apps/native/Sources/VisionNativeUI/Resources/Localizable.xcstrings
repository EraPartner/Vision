    "admin.audit.description": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified against this installation's local receipt. Older records and a pending tail need separate review."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerd met het lokale ontvangstbewijs van deze installatie. Oudere records en een nog niet verankerd einde vereisen afzonderlijke controle."
          }
        }
      }
    },
