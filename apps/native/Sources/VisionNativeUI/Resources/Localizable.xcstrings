    "stocks.howItWorks": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average cost is the weighted average of all your buys. Unrealized gains compare the current market value with that cost. Realized gains are locked in when you sell. Fees and taxes are tracked per transaction for tax reporting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemiddelde kostprijs is het gewogen gemiddelde van al je aankopen. Ongerealiseerde winsten vergelijken de huidige marktwaarde met die kostprijs. Gerealiseerde winsten worden vastgezet bij verkoop. Kosten en belastingen worden per transactie bijgehouden voor je belastingaangifte."
          }
        }
      }
    },
