    "portfolioImport.session.fullHistoryHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review all selected history together. Reconcile proven existing records and import proven missing acquisitions, sales, paired income, transfers and unit adjustments. New Kinesis cash requires the cash-only confirmation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel de volledige geselecteerde geschiedenis samen. Koppel bewezen bestaande transacties en importeer bewezen ontbrekende verwervingen, verkopen, gekoppelde inkomsten, overdrachten en aanpassingen van eenheden. Nieuwe Kinesis-kasmutaties vereisen de bevestiging voor de kasimport."
          }
        }
      }
    },
    "portfolioImport.session.grossDebit": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
