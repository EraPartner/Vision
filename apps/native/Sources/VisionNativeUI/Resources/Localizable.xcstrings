      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Box V, A.1.c: other jointly taxable pensions, codes 1211 and 1316 (partner 2211 and 2316)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vak V, A.1.c: andere gezamenlijk belastbare pensioenen, codes 1211 en 1316 (partner 2211 en 2316)."
