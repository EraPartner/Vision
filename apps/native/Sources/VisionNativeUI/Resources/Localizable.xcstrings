    "tax.subjectToReynders.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct bond gains are exempt pre-2026; from IY 2026 they fall under the 10% CGT. Bond / mixed-bond funds pay 30% on the interest portion (remainder routed to CGT in 2026)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerwaarden op directe obligaties zijn vóór 2026 vrijgesteld; vanaf IY 2026 vallen ze onder de 10% meerwaardebelasting. Obligatie- en gemengde obligatiefondsen betalen 30% op de rentecomponent (saldo naar CGT vanaf 2026)."
          }
        }
      }
    },
    "tax.subjectToReynders.no": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, direct bond holding"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee, directe obligatie"
          }
        }
      }
    },
    "tax.subjectToReynders.yes": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
