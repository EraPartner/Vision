    "admin.audit.anchor": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchored"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verankerd"
          }
        }
      }
    },
    "admin.audit.changed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit history changed. Refresh to read from the beginning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auditgeschiedenis is gewijzigd. Vernieuw om opnieuw bij het begin te lezen."
          }
        }
      }
    },
    "admin.audit.description": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified against this installation's local receipt. Older records and a pending tail need separate review."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerd met het lokale ontvangstbewijs van deze installatie. Oudere records en een nog niet verankerd einde vereisen afzonderlijke controle."
          }
        }
      }
    },
    "admin.audit.details": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry details"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Details van vermelding"
          }
        }
      }
    },
    "admin.audit.empty": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chained entries yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen gekoppelde vermeldingen."
          }
        }
      }
    },
    "admin.audit.enroll": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start audit protection"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditbescherming starten"
          }
        }
      }
    },
    "admin.audit.enrollExplanation": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create a protected starting point for this installation. Earlier history can be checked for internal consistency, but its past authenticity cannot be proven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt voor deze installatie een beschermd startpunt maken. Eerdere geschiedenis kan intern worden gecontroleerd, maar de echtheid ervan in het verleden kan niet worden bewezen."
          }
        }
      }
    },
    "admin.audit.enrollFailed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit protection could not be started. No history was marked as verified."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auditbescherming kon niet worden gestart. Geen geschiedenis is als geverifieerd gemarkeerd."
          }
        }
      }
    },
    "admin.audit.enrollmentBaseline": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted at enrollment"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanvaard bij aanmelding"
          }
        }
      }
    },
    "admin.audit.enrollmentCaveat": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry {sequence} is the enrollment baseline. Earlier entries were accepted as a starting point; their authenticity before enrollment cannot be proven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelding {sequence} is het startpunt van de aanmelding. Eerdere vermeldingen zijn als startpunt aanvaard; hun echtheid vóór de aanmelding kan niet worden bewezen."
          }
        }
      }
    },
    "admin.audit.export": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
