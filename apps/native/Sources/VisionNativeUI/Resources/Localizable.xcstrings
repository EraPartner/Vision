    "portfolioImport.session.cashFundingConfirmation": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm that this statement's cash deposits and withdrawals are transfers between my own accounts."
          }
