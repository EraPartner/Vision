    "tax.profile.section.ownHome.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regional credit on your primary-residence mortgage. Implemented for Flemish woonbonus (mortgages signed before 2020) and Walloon chèque habitat (mortgages signed 2016+). Brussels and post-2020 Flemish mortgages have no annual credit modeled."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewestelijk krediet op de hypotheek van je hoofdverblijfplaats. Geïmplementeerd voor Vlaamse woonbonus (vóór 2020) en Waalse chèque habitat (2016+). Brussel en post-2020 Vlaamse hypotheken hebben geen jaarlijks krediet in dit model."
          }
        }
      }
    },
    "tax.profile.section.ownHome.note": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplified estimate: the Walloon chèque habitat phases out with income and is halved from the eleventh year. Verify with your tax advisor for filing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereenvoudigde schatting: de Waalse chèque habitat daalt met het inkomen en wordt vanaf het elfde jaar gehalveerd. Verifieer bij je belastingadviseur."
          }
        }
      }
    },
