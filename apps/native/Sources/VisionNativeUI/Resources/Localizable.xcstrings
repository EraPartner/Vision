    "tax.cgtEstimate": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capital gains tax (10%, from 2026)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerwaardebelasting (10%, vanaf 2026)"
