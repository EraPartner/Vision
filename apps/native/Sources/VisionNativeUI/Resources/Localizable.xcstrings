    "tax.householdBreakdown.recorded.note": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded income comes from your income categories and is split by account owner: your accounts count for you, your partner's accounts for your partner, and joint accounts half each. Bank credits are usually net pay, so they can be lower than gross income."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geboekt inkomen komt uit je inkomenscategorieën en wordt verdeeld volgens de eigenaar van de rekening: jouw rekeningen tellen voor jou, de rekeningen van je partner voor je partner en gezamenlijke rekeningen voor de helft. Bijschrijvingen op de bank zijn meestal nettoloon en kunnen dus lager zijn dan het bruto-inkomen."
          }
        }
      }
    },
