    "admin.audit.retentionCaveat": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries through {sequence} were pruned under the one-year retention policy. The remaining chain is verified from that protected boundary."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeldingen tot en met {sequence} zijn volgens het bewaarbeleid van één jaar verwijderd. De resterende keten is vanaf die beschermde grens geverifieerd."
          }
        }
      }
    },
    "admin.audit.rotate": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate audit key"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditsleutel vernieuwen"
          }
        }
      }
    },
    "admin.audit.rotateExplanation": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace this Mac's audit key after checking the full history. Keep a recent protected transfer and backup until the new checkpoint verifies."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de auditsleutel van deze Mac na controle van de volledige geschiedenis. Bewaar een recente beveiligde overdracht en back-up totdat het nieuwe controlepunt is geverifieerd."
          }
        }
      }
    },
    "admin.audit.rotateFailed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit key rotation failed. Review audit status before trusting history."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vernieuwen van de auditsleutel is mislukt. Controleer de auditstatus voordat je de geschiedenis vertrouwt."
          }
        }
      }
    },
    "admin.audit.rotateSuccess": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit key rotated and history verified."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditsleutel vernieuwd en geschiedenis geverifieerd."
          }
        }
      }
    },
    "admin.audit.title": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
