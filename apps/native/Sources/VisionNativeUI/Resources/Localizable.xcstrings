    "accounts.reconcile.backdatedWarning": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading is dated {date}. Anything you spent or received after that date is already in the computed balance, so the difference below may just be later activity. Adding an adjustment for it would count it twice. Check what happened since first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit saldo heeft datum {date}. Alles wat je daarna hebt uitgegeven of ontvangen zit al in het berekende saldo, dus het verschil hieronder kan gewoon latere activiteit zijn. Een correctie toevoegen zou dat dubbel tellen. Bekijk eerst wat er sindsdien gebeurd is."
          }
        }
      }
    },
