    "tax.household.field.mortgageSharePartnerB": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner B's share of the home loan (%)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aandeel van partner B in de woninglening (%)"
          }
        }
      }
    },
    "tax.household.field.mortgageSharePartnerB.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill this in when both partners borrowed for the home: each then has their own woonbonus or chèque habitat limit. In Wallonia, enter partner B's ownership share. Leave it empty when one partner claims the whole credit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul dit in wanneer beide partners voor de woning leenden: elk heeft dan een eigen grens voor de woonbonus of de chèque habitat. Geef in Wallonië het eigendomsaandeel van partner B op. Laat het leeg wanneer één partner het hele voordeel aanvraagt."
          }
        }
      }
    },
    "tax.household.field.ownHomeClaimant": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home credit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woonkrediet"
          }
        }
      }
    },
    "tax.household.field.ownHomeClaimant.shareSet": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set by partner B's share of the home loan: 0% gives the credit to partner A, 100% to partner B, and any other share gives each partner their own part."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaald door het aandeel van partner B in de woninglening: bij 0% krijgt partner A het voordeel, bij 100% partner B, en bij elk ander aandeel krijgt elke partner een eigen deel."
          }
        }
      }
    },
    "tax.household.issue.csss_mixed_activity_base_unverified": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
