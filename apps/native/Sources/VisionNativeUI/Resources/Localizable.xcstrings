    "admin.audit.enroll": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start audit protection"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditbescherming starten"
          }
        }
      }
    },
    "admin.audit.enrollExplanation": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create a protected starting point for this installation. Earlier history can be checked for internal consistency, but its past authenticity cannot be proven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt voor deze installatie een beschermd startpunt maken. Eerdere geschiedenis kan intern worden gecontroleerd, maar de echtheid ervan in het verleden kan niet worden bewezen."
          }
        }
      }
    },
    "admin.audit.enrollFailed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit protection could not be started. No history was marked as verified."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auditbescherming kon niet worden gestart. Geen geschiedenis is als geverifieerd gemarkeerd."
          }
        }
      }
    },
    "admin.audit.enrollmentBaseline": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted at enrollment"
