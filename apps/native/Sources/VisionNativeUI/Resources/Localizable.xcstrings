        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het terugbetaalbaar belastingkrediet voor kinderen ten laste is niet opgenomen in deze raming."
          }
        }
      }
    },
    "tax.household.issue.relationship_dates_missing": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the date of your marriage or legal cohabitation so the assessment can be derived for each year. Until then a joint assessment is assumed."
