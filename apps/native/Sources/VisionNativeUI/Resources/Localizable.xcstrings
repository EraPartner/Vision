    "exchangeRates.fallbackCurrenciesDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror live rates after each fetch"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiëren live-koersen na elke ophaalactie"
          }
