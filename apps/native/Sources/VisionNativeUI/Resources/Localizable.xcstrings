    "tax.markFiled.description": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records a declaration you have submitted outside Vision. This does not submit anything to a tax authority. Review your profile and export the year first. Vision preserves the calculation; you can unfile or deliberately amend it later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert een aangifte die je buiten Vision hebt ingediend. Dit verstuurt niets naar de belastingdienst. Controleer eerst je profiel en exporteer het jaar. Vision bewaart de berekening; je kunt de registratie later verwijderen of bewust aanpassen."
          }
        }
      }
    },
    "tax.markFiled.prerequisite": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up and review the tax profile for this year first. For a historical year, choose \"Create profile\" in the year selector, then edit its inputs. Wait for settings to finish loading."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel eerst het belastingprofiel voor dit jaar in en controleer het. Kies voor een historisch jaar \"Profiel aanmaken\" in de jaarkeuze en pas daarna de gegevens aan. Wacht tot de instellingen geladen zijn."
          }
        }
      }
    },
