    "accounts.close.description": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing hides this account everywhere and removes it from net worth. Its transactions and history are kept, and you can reopen it later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluiten verbergt deze rekening overal en haalt haar uit het nettovermogen. De transacties en geschiedenis blijven bewaard en je kunt de rekening later heropenen."
          }
        }
      }
    },
