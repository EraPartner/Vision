    "tax.profile.field.serviceVoucherSpend.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you paid for service vouchers this year. Leave empty to use the number of vouchers from an older profile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je dit jaar voor dienstencheques betaalde. Laat leeg om het aantal cheques uit een ouder profiel te gebruiken."
          }
