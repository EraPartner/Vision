    "tax.subjectToReynders.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct bond gains are exempt pre-2026; from IY 2026 they fall under the 10% CGT. Bond / mixed-bond funds pay 30% on the interest portion (remainder routed to CGT in 2026)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerwaarden op directe obligaties zijn vóór 2026 vrijgesteld; vanaf IY 2026 vallen ze onder de 10% meerwaardebelasting. Obligatie- en gemengde obligatiefondsen betalen 30% op de rentecomponent (saldo naar CGT vanaf 2026)."
          }
        }
      }
    },
    "tax.subjectToReynders.no": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, direct bond holding"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee, directe obligatie"
          }
        }
      }
    },
    "tax.subjectToReynders.yes": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, bond or mixed-bond fund"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, obligatie- of gemengd obligatiefonds"
          }
        }
      }
    },
    "tax.suggestions.alimony.applied": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimony is treated as a partly deductible item from the taxable base (80% for 2024, 70% for 2025, 60% for 2026); estimated tax saving shown using your marginal rate (illustrative)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderhoudsgeld wordt als gedeeltelijk aftrekbaar van het belastbaar inkomen behandeld (80% voor 2024, 70% voor 2025, 60% voor 2026); geschatte belastingbesparing getoond op basis van je marginale tarief (indicatief)."
          }
        }
      }
    },
    "tax.suggestions.childcare.noAmount": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You marked childcare eligible but did not enter costs. The credit is 45% up to €16.90 per day (2025) per eligible child. Enter eligible days for a tighter cap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je markeerde kinderopvang als in aanmerking komend maar gaf geen kosten op. De vermindering is 45% tot €16,90 per dag (2025) per in aanmerking komend kind. Geef het aantal dagen op voor een nauwkeurigere limeet."
          }
        }
      }
    },
    "tax.suggestions.childcare.notMarked": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You entered childcare costs but did not mark them eligible. Mark to apply the 45% federal credit up to the daily cap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voerde kinderopvangkosten in maar markeerde ze niet als in aanmerking komend. Markeer ze om de 45% federale vermindering tot de daglimiet toe te passen."
          }
        }
      }
    },
    "tax.suggestions.childcare.suggest": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have dependents; childcare costs may qualify for a 45% credit. Example used: {days} eligible days."
          }
        },
        "nl": {
