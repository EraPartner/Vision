      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduced turns off the glass and aurora for maximum fluency. Enhanced adds a GPU shader aurora, plus window translucency in the desktop app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminderd schakelt het glas en de aurora uit voor maximale vloeiendheid. Verbeterd voegt een GPU-shader-aurora toe, plus vensterdoorschijnendheid in de desktopapp."
          }
        }
      }
    },
