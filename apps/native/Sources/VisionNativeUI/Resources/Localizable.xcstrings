    "tax.automation.automaticDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bracket math, social security (employee contribution plus the estimated special contribution), federal income tax, communal surcharge, the effect of dependents on the tax-free allowance, and monthly reserve guidance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijfberekening, sociale zekerheid (werknemersbijdrage plus de geschatte bijzondere bijdrage), federale personenbelasting, gemeentelijke opcentiemen, het effect van personen ten laste op de belastingvrije som, en begeleiding voor de maandelijkse reserve."
          }
        }
      }
    },
    "tax.automation.investmentDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annual portfolio taxes are now included in this overview as a single total. For details per investment and tax type, use the portfolio tax page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaarlijkse portefeuillebelastingen zijn nu als één totaal in dit overzicht opgenomen. Voor details per belegging en belastingtype gebruik je de portefeuillebelastingpagina."
          }
        }
      }
    },
