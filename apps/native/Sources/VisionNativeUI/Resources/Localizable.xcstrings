    },
    "tax.household.issue.loss_offset_not_modelled": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A loss from one activity is not offset against other income in this estimate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verlies uit een activiteit wordt in deze raming niet verrekend met andere inkomsten."
          }
        }
      }
    },
    "tax.household.issue.mortgage_region_not_used": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region recorded for the mortgage is not used. The home loan reduction follows the household's region of residence on 1 January of the assessment year."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gewest dat voor de hypotheek is ingevuld, wordt niet gebruikt. De vermindering voor de woninglening volgt het gewest waar het gezin op 1 januari van het aanslagjaar woont."
          }
        }
      }
    },
    "tax.household.issue.pension_exclusion_other_income_counted_as_activity": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity income is left out of this partner's pension reduction share, but income entered as Other professional income or Net professional amount counts as activity income. Enter sickness, unemployment or other replacement income as a Pension activity instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteitsinkomsten blijven buiten het aandeel van deze partner in de vermindering voor pensioenen, maar inkomsten die als Ander beroepsinkomen of Netto beroepsbedrag zijn ingevuld, tellen als activiteitsinkomsten. Vul ziekte-, werkloosheids- of andere vervangingsinkomsten in als activiteit Pensioen."
          }
        }
      }
    },
    "tax.household.issue.pension_quotient_partial_exclusion_unverified": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The marital quotient comes from a partner whose activity income is only partly left out of the pension reduction share. The guidance does not say how that part carries over to the receiving partner; this estimate carries it over in the same proportion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het huwelijksquotiënt komt van een partner van wie de activiteitsinkomsten maar gedeeltelijk buiten het aandeel in de vermindering voor pensioenen blijven. De administratieve richtlijnen zeggen niet hoe dat deel overgaat naar de ontvangende partner; deze raming neemt het in dezelfde verhouding over."
          }
        }
      }
    },
    "tax.household.issue.pension_reduction_activity_income_not_excluded": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This partner has both pensions and activity income, but the pension type is not entered. The reduction for pensions is split in proportion to all net income; choose the pension type so that activity income can be left out where the law allows it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze partner heeft zowel pensioenen als inkomsten uit een activiteit, maar de soort pensioen is niet ingevuld. De vermindering voor pensioenen wordt verdeeld in verhouding tot alle netto-inkomsten; kies de soort pensioen zodat de activiteitsinkomsten kunnen worden uitgesloten waar de wet dat toelaat."
          }
        }
      }
    },
    "tax.household.issue.refundable_child_credit_not_modelled": {
