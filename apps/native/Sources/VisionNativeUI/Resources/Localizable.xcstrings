    "portfolioImport.session.history.rollbackDescription": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore adopted records to their values before importing \"{file}\" and remove records created by this statement. The original source file can be staged again. Rollback is blocked if affected history has changed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel overgenomen records naar hun waarden vóór de import van \"{file}\" en verwijder records die door dit afschrift zijn aangemaakt. Het oorspronkelijke bronbestand kan opnieuw worden voorbereid. Terugdraaien wordt geblokkeerd als de betrokken geschiedenis is gewijzigd."
          }
        }
      }
    },
