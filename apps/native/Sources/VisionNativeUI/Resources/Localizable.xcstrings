    "tax.reyndersEstimateDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30% on realized gains from investments classified as bonds. Mixed ETFs and funds need manual entry, because fund composition is not tracked."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "30% op gerealiseerde winsten uit beleggingen geclassificeerd als obligatie. Gemengde ETF's en fondsen vereisen handmatige invoer, omdat de fondssamenstelling niet wordt bijgehouden."
          }
        }
      }
    },
    "tax.reyndersInterestPortion": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
