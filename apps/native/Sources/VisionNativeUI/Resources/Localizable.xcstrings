    "portfolioImport.session.groupDateCorrection": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole proven yield group is reviewed together. Changed dates use the broker payment date shown below; quantities and financial values stay unchanged."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele bewezen yield-groep wordt samen gecontroleerd. Gewijzigde datums gebruiken de hieronder getoonde betaaldatum van de broker; hoeveelheden en financiële waarden blijven ongewijzigd."
          }
        }
      }
    },
    "portfolioImport.session.history.rollback": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll back statement"
          }
        },
        "nl": {
          "stringUnit": {
