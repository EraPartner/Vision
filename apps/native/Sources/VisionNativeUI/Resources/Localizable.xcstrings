    "plannedForm.directionDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the amount without a sign. Expenses are stored as negative amounts so forecasts and automatic matching line up."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het bedrag zonder teken in. Uitgaven worden als negatief bedrag opgeslagen zodat prognoses en automatische koppeling kloppen."
          }
        }
      }
    },
    "plannedForm.directionLoanDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A loan repayment is always an expense; its amount comes from the generated repayment schedule."
          }
        },
        "nl": {
