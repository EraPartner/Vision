    "admin.audit.exportUnavailable": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete export is unavailable when history exceeds 500 entries."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volledige export is niet beschikbaar wanneer de geschiedenis meer dan 500 vermeldingen bevat."
