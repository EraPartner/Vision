    },
    "exchangeRates.fallbackDesc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when neither the ECB nor stored rates are available. Refreshed in memory after every successful ECB fetch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gebruikt wanneer noch de ECB noch opgeslagen koersen beschikbaar zijn. Na elke geslaagde ECB-ophaalactie in het geheugen ververst."
          }
        }
      }
    },
    "exchangeRates.fallbackNote": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallback rates are updated in-memory whenever a successful ECB fetch occurs and match the live rates above."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugvalkoersen worden in het geheugen bijgewerkt bij elke geslaagde ECB-ophaalactie en komen overeen met de live-koersen hierboven."
          }
        }
      }
    },
