    },
    "tax.profile.field.unionDues.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts as actual professional expenses (CIR-92 art. 49), so it only applies when you itemize actual expenses instead of the lump sum. Leave at 0 if already included in your actual expenses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt als werkelijke beroepskosten (WIB-92 art. 49), dus wordt enkel toegepast wanneer je werkelijke kosten bewijst in plaats van het kostenforfait. Laat op 0 als al inbegrepen in je werkelijke kosten."
          }
        }
      }
    },
    "tax.profile.field.woonbonusChildrenAtLoanStart": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependent children on 1 January after the loan year"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinderen ten laste op 1 januari na het jaar van de lening"
          }
        }
      }
    },
    "tax.profile.field.woonbonusChildrenAtLoanStart.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three or more add €80 to the woonbonus during its first ten years. Count a child with a disability twice; leave empty to use this year's dependent children."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie of meer verhogen de woonbonus met €80 tijdens de eerste tien jaar. Tel een kind met een handicap dubbel; laat leeg om de kinderen ten laste van dit jaar te gebruiken."
          }
        }
      }
    },
