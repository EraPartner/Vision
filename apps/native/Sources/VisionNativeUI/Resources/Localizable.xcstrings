    "tax.reyndersInterestPortion.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share of the realized gain taxed at 30% under Reynders. Pure accumulating bond funds: 100%. Mixed funds: lower. The rest is taxed at 10% capital gains tax from income year 2026."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aandeel van de gerealiseerde meerwaarde dat aan 30% wordt belast onder Reynders. Pure kapitaliserende obligatiefondsen: 100%. Gemengde fondsen: lager. De rest wordt belast aan 10% meerwaardebelasting vanaf inkomstenjaar 2026."
          }
        }
      }
    },
