    "portfolioImport.kinesisParserHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Kinesis Money, export a Transactions statement as CSV and select that file here. Select the Kinesis account that receives its trades and cash movements. Paired currency legs are combined. Asset withdrawals and negative unit adjustments that cannot be represented safely remain visible as review errors and require manual reconciliation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
