      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically switches to Reduced while the window is on a high-resolution external display such as a 4K TV, and back when it leaves. The built-in screen never counts as large."
          }
        },
        "nl": {
          "stringUnit": {
