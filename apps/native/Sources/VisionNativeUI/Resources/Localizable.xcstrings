      }
    },
    "admin.audit.failed": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit verification failed. Do not rely on this history until the cause is resolved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De auditverificatie is mislukt. Vertrouw niet op deze geschiedenis voordat de oorzaak is opgelost."
          }
        }
      }
    },
    "admin.audit.legacy": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
