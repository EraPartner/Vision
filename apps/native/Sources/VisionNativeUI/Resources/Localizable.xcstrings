    "portfolioImport.ibkrFundingParserHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Excel export (.xls or .xlsx) from IBKR Transaction Status & History, with its Deposit and Withdrawal sheets. Each completed deposit and withdrawal is recorded in its own currency. Movements already imported from the Transaction History CSV are corrected to that currency, not recorded twice. Pending, rejected and cancelled requests are skipped."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de Excel-export (.xls of .xlsx) uit IBKR Transaction Status & History, met de bladen Deposit en Withdrawal. Elke voltooide storting en opname wordt in de eigen valuta geboekt. Bewegingen die al uit de CSV met de transactiegeschiedenis zijn geïmporteerd, worden naar die valuta gecorrigeerd en niet dubbel geboekt. Openstaande, geweigerde en geannuleerde aanvragen worden overgeslagen."
          }
        }
      }
    },
    "portfolioImport.ibkrParser": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR transaction history"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "IBKR-transactiegeschiedenis"
          }
        }
      }
    },
    "portfolioImport.ibkrParserHint": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In IBKR, export Transaction History as a CSV for trades, income and charges. Its deposits and withdrawals use the statement base currency; also import the funding history workbook to record them in their own currency. Either order records each movement once. Select the broker account that receives these events. Forex principal is not a portfolio trade; explicit charges remain cash fees."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer in IBKR de transactiegeschiedenis als CSV voor transacties, inkomsten en kosten. Stortingen en opnames gebruiken de basisvaluta van het afschrift; importeer ook de werkmap met de financieringsgeschiedenis om ze in hun eigen valuta te boeken. In elke volgorde wordt elke beweging één keer geboekt. Selecteer de brokerrekening voor deze gebeurtenissen. Valutaconversies zijn geen portefeuilletransacties; expliciete kosten blijven kaskosten."
          }
        }
      }
    },
