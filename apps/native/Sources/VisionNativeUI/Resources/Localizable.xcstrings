      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"{name}\"? Payees linked to transactions, planned payments or accounts cannot be deleted. Reassign or merge them first. This cannot be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{name}\" verwijderen? Ontvangers die aan transacties, geplande betalingen of rekeningen zijn gekoppeld, kunnen niet worden verwijderd. Wijs ze eerst opnieuw toe of voeg ze samen. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
