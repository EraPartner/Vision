    "tax.household.activity.pensionKind.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the line of the tax return (part 1, box V) where this pension is declared. Income from work is left out when the pension reduction is shared out if you receive a survivor's pension or transition allowance, or a statutory pension from the legal pension age up to an indexed limit (partly up to an upper limit)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de lijn van de aangifte (deel 1, vak V) waarop dit pensioen staat. Inkomsten uit werk blijven buiten beschouwing bij de verdeling van de vermindering voor pensioenen als u een overlevingspensioen of overgangsuitkering ontvangt, of een wettelijk pensioen vanaf de wettelijke pensioenleeftijd tot een geïndexeerde grens (gedeeltelijk tot een bovengrens)."
          }
        }
      }
    },
