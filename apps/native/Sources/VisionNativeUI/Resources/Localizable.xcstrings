      }
    },
    "tax.profile.field.unionDues": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Union / professional dues (annual EUR)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakbond- / beroepsbijdragen (jaarlijks EUR)"
          }
