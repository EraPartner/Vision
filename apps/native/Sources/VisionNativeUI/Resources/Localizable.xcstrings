    "tax.household.field.hasPartner.desc": {
      "comment": "Generated from i18n/source by scripts/native-strings.ts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your spouse or partner to estimate both returns together. Turning this off removes the partner's income and deductions."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
