        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm these are movements between your own accounts. Record {firstId}: {firstAccount}, {firstDate}, {firstAmount} {firstCurrency}. Record {secondId}: {secondAccount}, {secondDate}, {secondAmount} {secondCurrency}. Both records will be excluded from income and spending; no new transaction will be created. Any separate fee remains an expense."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat dit bewegingen tussen je eigen rekeningen zijn. Record {firstId}: {firstAccount}, {firstDate}, {firstAmount} {firstCurrency}. Record {secondId}: {secondAccount}, {secondDate}, {secondAmount} {secondCurrency}. Beide records worden uitgesloten van inkomsten en uitgaven; er wordt geen nieuwe transactie aangemaakt. Een afzonderlijke kost blijft een uitgave."
          }
        }
      }
    },
