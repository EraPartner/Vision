{
  "name": "financial-transaction-manager-node",
  "version": "1.0.0",
  "description": "Node.js backend for Vision",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.js",
    "dev": "bun --watch src/main.js",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "db:migrate": "cd ../.. && alembic upgrade head",
    "db:migrate:down": "cd ../.. && alembic downgrade -1",
    "db:new-migration": "cd ../.. && alembic revision -m",
    "db:reset": "cd ../.. && alembic downgrade base && alembic upgrade head",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@vision/types": "workspace:*",
    "archiver": "^7.0.1",
    "csv-parse": "^5.5.6",
    "decimal.js": "^10.4.3",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.0",
    "puppeteer": "^24.42.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^3.25.76"
  }
}
