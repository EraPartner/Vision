{
  "name": "financial-transaction-manager-node",
  "version": "1.0.0",
  "description": "Node.js backend for Vision",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.js",
    "dev": "VISION_DEV=true bun --watch src/main.js",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "db:migrate": "cd ../.. && alembic upgrade head",
    "db:migrate:down": "cd ../.. && alembic downgrade -1",
    "db:new-migration": "cd ../.. && alembic revision -m",
    "db:reset": "cd ../.. && alembic downgrade base && alembic upgrade head",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@vision/shared-utils": "workspace:*",
    "@vision/types": "workspace:*",
    "csv-parse": "^6.2.1",
    "decimal.js": "^10.4.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "puppeteer": "^25.0.4",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.4.3"
  }
}
