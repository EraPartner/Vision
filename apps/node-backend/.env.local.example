# ============================================================
# Vision — Backend dev config (start.sh / local flow)
# ============================================================
# Copy to apps/node-backend/.env.local and edit as needed.
# This file is loaded by apps/node-backend/src/config/config.js
# when running locally via ./start.sh.
# It is NOT used by Docker — Docker reads the root .env instead.
#
# .env.local is git-ignored; never commit the real file.
# ============================================================

# --- Server ---
PORT=3002

# --- Database (local postgres started by start.sh on port 5433) ---
DATABASE_URL=postgresql://ftm_user@localhost:5433/financial_transactions

# --- CORS (Vite dev server on 8080, legacy fallback on 5174) ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5174

# --- Logging (verbose in dev) ---
LOG_LEVEL=debug
ENABLE_LOGGING=true
