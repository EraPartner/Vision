# ============================================================
# Vision — Backend dev config (start.sh / local flow)
# ============================================================
# Copy to apps/node-backend/.env.local and edit as needed.
# This file is loaded by apps/node-backend/src/config/config.js
# when running locally via ./start.sh.
# It is NOT used by Docker — Docker reads the root .env instead.
#
# .env.local is git-ignored; never commit the real file.
# ============================================================

# --- Server ---
PORT=3002

# --- Database (local postgres started by start.sh on port 5433) ---
DATABASE_URL=postgresql://ftm_user:ftm_password@localhost:5432/financial_transactions

# --- CORS (Vite dev server on 8080, legacy fallback on 5174) ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5174

# --- Logging (verbose in dev) ---
LOG_LEVEL=debug
ENABLE_LOGGING=true

# --- Research providers (ADR-079, all optional) ---
# Keys for the multi-provider research suite. Each is OPTIONAL: a provider with
# no key is dropped from the research capability chain (Yahoo needs no key).
# Uncomment and fill in the ones you want to enable.
# TWELVE_DATA_API_KEY=        # quotes/charts        — free tier 8/min, 800/day
# FINNHUB_API_KEY=            # news, US fundamentals — free tier 60/min
# FMP_API_KEY=                # fundamentals         — free tier 250/day
# ALPHA_VANTAGE_API_KEY=      # fallback quotes/fund. — free tier ~25/day
