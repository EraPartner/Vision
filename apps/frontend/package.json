        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "fast-check": "^4.9.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "msw": "^2.15.0",
        "postcss": "^8.5.23",
        "tailwindcss": "^4.2.4",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
