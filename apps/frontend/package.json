{
    "name": "vision-frontend",
    "version": "1.0.0",
    "private": true,
    "description": "React frontend for Vision",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && vite build",
        "build:dev": "vite build --mode development",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test e2e/smoke.spec.ts e2e/dialogs-edge.spec.ts e2e/critical-flows.spec.ts e2e/mutations-parity.spec.ts e2e/network-drift.spec.ts e2e/a11y.spec.ts",
        "test:e2e:visual": "playwright test --update-snapshots=missing e2e/visual.spec.ts",
        "test:e2e:update-snapshots": "playwright test --update-snapshots",
        "test:mutation": "stryker run"
    },
