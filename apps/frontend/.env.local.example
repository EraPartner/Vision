# ============================================================
# Vision — Frontend dev config (start.sh / local flow)
# ============================================================
# When running via ./start.sh, Vite uses config/vite.config.ts
# whose root is the workspace root. Place this file at the
# workspace root as .env.local (NOT inside apps/frontend/).
#
# When running directly inside apps/frontend/ (cd apps/frontend && vite),
# place this file as apps/frontend/.env.local instead.
#
# This file is NOT used by Docker — the frontend is pre-built
# in the Docker image and VITE_* vars are baked in at build time.
#
# .env.local is git-ignored; never commit the real file.
# ============================================================

# --- API base URL (Vite dev proxy handles /api so this is usually not needed) ---
# VITE_API_URL=http://localhost:3002

# --- Logging (verbose in dev; defaults to debug when VITE_LOG_LEVEL unset in dev) ---
VITE_LOG_LEVEL=debug
VITE_ENABLE_LOGGING=true

# --- Feature flags (all optional; defaults shown) ---
# Colorblind-safe gain/loss recoloring ("skin-v2"). Default OFF (classic gold/red).
# VITE_SKIN_V2=false
# Enable the in-app devtools panel in a non-dev build (docker-compose.dev.yml sets this).
# VITE_DEVTOOLS=false
