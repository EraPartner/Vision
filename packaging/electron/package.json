{
  "name": "vision-desktop",
  "version": "1.0.1",
  "description": "Vision desktop wrapper",
  "main": "main.js",
  "packageManager": "bun",
  "scripts": {
    "start": "node ../../scripts/generate-locales.js && electron .",
    "dist": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64",
    "dist:arm64": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "compress-commons": "^6.0.2",
    "readable-stream": "^4.5.2",
    "yauzl": "^3.3.0",
    "zip-stream": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vaultvoyager.vision",
    "productName": "Vision",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.icns"
    },
    "files": [
      "main.js",
      "preload.js",
      "backup/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "i18n",
        "to": "i18n"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "EraPartner",
      "repo": "Vision"
    }
  }
}
