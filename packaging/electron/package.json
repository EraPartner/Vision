{
  "name": "vision-desktop",
  "version": "1.0.0",
  "description": "Vision desktop wrapper",
  "main": "main.js",
  "packageManager": "bun",
  "scripts": {
    "start": "node ../../scripts/generate-locales.js && electron .",
    "dist": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64",
    "dist:arm64": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vaultvoyager.vision",
    "productName": "Vision",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance"
    },
    "files": [
      "main.js",
      "preload.js",
      "i18n/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "EraPartner",
      "repo": "Vision"
    }
  }
}
