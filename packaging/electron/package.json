{
  "name": "vision-desktop",
  "version": "0.1.0",
  "description": "Vision desktop wrapper",
  "main": "main.js",
  "packageManager": "bun",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:x64": "electron-builder --mac --x64",
    "dist:arm64": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vaultvoyager.vision",
    "productName": "Vision",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.finance"
    },
    "files": ["main.js", "resources/**/*"]
  }
}
