{
  "name": "vision-desktop",
  "version": "1.0.2",
  "description": "Vision desktop wrapper",
  "main": "main.js",
  "packageManager": "bun",
  "scripts": {
    "start": "node ../../scripts/generate-locales.js && electron .",
    "dist": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64",
    "dist:arm64": "GENERATE_LOCALES_AST=1 node ../../scripts/generate-locales.js && electron-builder --mac --arm64"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "brace-expansion@5.0.5": "5.0.6",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "tar": "^7.5.16",
    "undici": "^7.28.0"
  },
  "build": {
    "appId": "com.vaultvoyager.vision",
    "productName": "Vision",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "main.js",
      "preload.js",
      "backup/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "i18n",
        "to": "i18n"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "EraPartner",
      "repo": "Vision"
    }
  }
}
