{
  "name": "vision-desktop",
  "version": "1.0.2",
  "description": "Vision desktop wrapper",
  "main": "main.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "node ../../scripts/generate-locales.js && electron .",
    "prepare:postgres": "node scripts/prepare-postgres-runtime.js",
    "prepare:alembic": "node scripts/prepare-alembic-runtime.js",
    "prepare:chromium": "node scripts/prepare-chromium-runtime.js",
    "prepare:native": "node scripts/prepare-native-runtime.js",
    "dist": "node ../../scripts/generate-locales.js && node scripts/build-native-package.js",
    "dist:arm64": "node ../../scripts/generate-locales.js && node scripts/build-native-package.js",
    "dist:dir": "node ../../scripts/generate-locales.js && node scripts/build-native-package.js --dir",
    "dist:demo": "node ../../scripts/generate-locales.js && node scripts/build-native-package.js --demo"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "brace-expansion@5.0.5": "5.0.6",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "tar": "^7.5.16",
    "undici": "^7.28.0"
  },
  "build": {
    "extends": "./electron-builder-base.json",
    "appId": "com.vaultvoyager.vision",
    "productName": "Vision",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "publish": null
  }
}
