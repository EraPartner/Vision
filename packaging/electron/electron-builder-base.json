{
  "directories": {
    "buildResources": "build"
  },
  "mac": {
    "category": "public.app-category.finance",
    "icon": "build/icon.icns",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "files": [
    "main.js",
    "badge-image.js",
    "runtime/**/*",
    "updater.js",
    "native-update-installer.js",
    "preload.js",
    "backup/**/*",
    "assets/**/*",
    "!runtime/**/*.test.js",
    "!backup/**/*.test.js",
    "!backup/fixtures/**/*",
    "!node_modules/**/*.map",
    "!node_modules/bare-{fs,os,url}/prebuilds/!(darwin-arm64)/**/*"
  ],
  "extraResources": [{ "from": "i18n", "to": "i18n" }]
}
