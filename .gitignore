# Python
venv/
.venv-native-build/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/
*.tsbuildinfo
.npm/
.yarn/
.vision-cache/

# Environment
.env.local
.env.production
.env
# .env.example is intentionally tracked (template — no real secrets)

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Agent/Dev Tools
# Shareable coding-agent config is tracked so fresh clones receive it.
# Host-specific bits live in CLAUDE.local.md and AGENTS.local.md.
.obsidian/
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/rules/
!.claude/settings.json
.opencode/
AGENTS.local.md
CLAUDE.*
!CLAUDE.md
.playwright-mcp

# OS
.DS_Store
Thumbs.db

# Build
build/
!packaging/electron/build/
*.log
coverage/

# Data
postgres_data/
Backups/
*.csv
# SQLite artifacts only — a bare *.db* also swallowed tests named *.db.test.js
*.db
*.db-journal
*.db-shm
*.db-wal
htmlcov/
*.tmp

# Ignore Smart Environment folder
.smart-env
copilot/
opencode.json
# Only local, uncommitted override json — not a blanket *.json (which forced a
# growing list of negations just to keep tracked config files like package.json
# and tsconfig.json committable).
*.local.json
!packaging/electron/package-lock.json
!packages/*/package.json
!apps/node-backend/tsconfig*.json
!apps/node-backend/tests/golden/__fixtures__/**/*.json
!packaging/electron/electron-builder-demo.json

# Vision demo build output (install-demo.sh)
dist-demo/
packaging/electron/native-runtime/
packaging/electron/native-runtime.previous-*/
packaging/electron/demo-seed/
packaging/electron/demo-seed.previous-*/

# Local Bun executable-build scratch files
*.bun-build

# Golden harness fixtures generated by its self-tests
apps/node-backend/tests/golden/__fixtures__/__harness_self_test/
