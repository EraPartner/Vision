{
  "name": "@vision/types",
  "private": true,
  "version": "0.1.0",
  "description": "Shared type definitions and runtime constants used by the Vision backend and frontend.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./api": {
      "types": "./src/api.d.ts",
      "default": "./src/api.js"
    },
    "./errors": {
      "types": "./src/errors.d.ts",
      "default": "./src/errors.js"
    },
    "./assetClasses": {
      "types": "./src/assetClasses.d.ts",
      "default": "./src/assetClasses.js"
    },
    "./portfolioTxnTypes": {
      "types": "./src/portfolioTxnTypes.d.ts",
      "default": "./src/portfolioTxnTypes.js"
    },
    "./recurrence": {
      "types": "./src/recurrence.d.ts",
      "default": "./src/recurrence.js"
    },
    "./aiChat": {
      "types": "./src/aiChat.d.ts",
      "default": "./src/aiChat.js"
    },
    "./reportThemeDefaults": {
      "types": "./src/reportThemeDefaults.d.ts",
      "default": "./src/reportThemeDefaults.js"
    },
    "./chartRanges": {
      "types": "./src/chartRanges.d.ts",
      "default": "./src/chartRanges.js"
    },
    "./electron": {
      "types": "./src/electron.d.ts",
      "default": "./src/electron.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ]
}
