{
  "name": "@vision/shared-utils",
  "private": true,
  "version": "0.1.0",
  "description": "Shared cross-workspace financial calculations and utility helpers for the Vision backend and frontend.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./money": {
      "types": "./src/money.d.ts",
      "default": "./src/money.js"
    },
    "./portfolio": {
      "types": "./src/portfolio.d.ts",
      "default": "./src/portfolio.js"
    },
    "./assetClasses": {
      "types": "./src/assetClasses.d.ts",
      "default": "./src/assetClasses.js"
    },
    "./csv": {
      "types": "./src/csv.d.ts",
      "default": "./src/csv.js"
    },
    "./slugify": {
      "types": "./src/slugify.d.ts",
      "default": "./src/slugify.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "dependencies": {
    "@vision/types": "workspace:*",
    "decimal.js": "^10.6.0"
  }
}
