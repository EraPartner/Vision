# ============================================================
# Vision native/local environment (reference template)
# ============================================================
# The packaged macOS app keeps its SQLite database inside its application data
# directory and passes the path to the backend automatically. Local development
# normally uses apps/node-backend/.env.local for database and port overrides.
# The backend only listens on loopback (SERVER_HOST must be 127.0.0.1, ::1 or
# localhost).
#
# Copy this file to .env only when you need shared provider settings or run the
# backend directly against a database file you choose. The .env file is
# git-ignored; never commit real credentials.
# ============================================================

# --- Database (optional for a manually managed backend) ---
# SQLite database file (ADR-263). Required outside development; development
# defaults to ./data/vision.sqlite3 under apps/node-backend.
# VISION_DATABASE_PATH=/absolute/path/to/vision.sqlite3
# How long a write waits for the database writer before failing (ms).
# VISION_DB_LOCK_TIMEOUT_MS=60000

# --- Logging (optional, production defaults shown) ---
LOG_LEVEL=warn
ENABLE_LOGGING=true

# --- Local AI chat (optional) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# AI_CHAT_CONTEXT_BUDGET_CHARS=24000
# AI_CHAT_MAX_TOOL_RESULT_CHARS=6000

# --- AI research network access (off by default) ---
# AI_WEB_RESEARCH_ENABLED=false
# AI_WEB_RESEARCH_MAX_SEARCHES=3
# AI_WEB_RESEARCH_MAX_PAGES=5
# BRAVE_SEARCH_API_KEY=

# --- Research providers (ADR-079, all optional) ---
# The repository .env is the shared home for provider API keys. A provider with
# no key is omitted from the research capability chain (Yahoo needs no key).
# TWELVE_DATA_API_KEY=        # quotes/charts        — free tier 8/min, 800/day
# FINNHUB_API_KEY=            # news, US fundamentals — free tier 60/min
# FMP_API_KEY=                # fundamentals         — free tier 250/day
# ALPHA_VANTAGE_API_KEY=      # fallback quotes/fund. — free tier ~25/day
# FRED_API_KEY=               # macro series (ADR-082) — free tier
