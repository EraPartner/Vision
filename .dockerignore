# Dependencies
node_modules/
**/node_modules
apps/frontend/node_modules/
apps/node-backend/node_modules/
packages/*/node_modules/

# Local database (Docker uses its own volume)
postgres_data/

# Build artifacts (Stage 1 rebuilds these)
dist/

# Dev/cache files
cache/
*.log
# Secrets: keep all env files out of the build context, but allow the example
# template through so it can still be shipped if a Dockerfile ever needs it.
.env
.env.*
!.env.example
.env.local
.env.*.local

# macOS
.DS_Store

# Git
.git/
.gitignore

# Editor
.vscode/
*.idea/

# Python (legacy backend)
apps/backend/
__pycache__/
*.pyc
*.pyo
# Note: alembic/ and config/alembic.ini are needed for Docker entrypoint migrations

# Test artifacts
apps/node-backend/tests/
coverage/

# Large paths not needed by the image build (Dockerfile never COPYs these).
# Trims the ~1.2 GB build context sent to the daemon.
packaging/
docs/
