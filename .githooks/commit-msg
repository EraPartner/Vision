#!/usr/bin/env sh
#
# Vision commit-msg -- enforce Conventional Commits. .github/CONTRIBUTING.md documents the
# policy ("type(scope): subject"); this hook makes it real. Runs
# scripts/commitlint.ts, the in-repo copy of config-conventional's rules (ADR-245).
#
# Wiring:   git config core.hooksPath .githooks   (done by scripts/setup-git-hooks.ts)
# Bypass:   git commit --no-verify        or       SKIP_HOOKS=1 git commit ...
#
# Output is ASCII-only on purpose (see the note in pre-commit).

set -u

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "[commit-msg] SKIP_HOOKS=1 -- skipping."
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0

# Skip (don't fail) without Bun -- mirrors how pre-commit treats a missing
# gitleaks/eslint, so a fresh clone can still commit before installing Bun.
if ! command -v bun >/dev/null 2>&1; then
  echo "[commit-msg] bun not found -- skipping commit-message lint."
  exit 0
fi

bun "$REPO_ROOT/scripts/commitlint.ts" --edit "$1"
