#!/usr/bin/env sh
#
# Vision pre-push -- run the local CI suites before code leaves the machine.
#
# Bypass:        git push --no-verify     or     SKIP_HOOKS=1 git push
# Skip just one: SKIP_TESTS=1 / SKIP_TYPECHECK=1 / SKIP_DB_TESTS=1 git push
#
# Checks: lint, typechecks, repository policy checks, script tests, frontend
#         coverage/build/size, Electron tests, backend coverage, live API
#         contracts against disposable PostgreSQL 18.
#         Database runs fail closed when the native toolchain is unavailable.
#
# Output is ASCII-only on purpose (see the note in pre-commit).

set -u

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "[pre-push] SKIP_HOOKS=1 -- skipping all checks."
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$REPO_ROOT" || exit 1

# Don't run the gate for branch deletions (local sha is all zeros). Reading the
# ref list from stdin would block when the hook is invoked interactively, so only
# consume it when stdin is a pipe.
if [ ! -t 0 ]; then
  pushing=0
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    case "${local_sha:-}" in
      "" ) ;;                 # no local ref
      *[!0]* )                # a real (non-zero) sha -> actual content to push
        pushing=1
        ;;
    esac
  done
  [ "$pushing" -eq 1 ] || { echo "[pre-push] only deletions -- nothing to check."; exit 0; }
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "[pre-push] bun not found -- cannot run typecheck/tests. Install bun, or push with --no-verify."
  exit 1
fi

fail=0
run() { # <label> <command...>
  _label="$1"; shift
  echo "[pre-push] > ${_label}..."
  if "$@"; then
    echo "[pre-push]   OK: ${_label}"
  else
    echo "[pre-push]   FAIL: ${_label}"
    fail=1
  fi
}

if [ "${SKIP_TYPECHECK:-}" != "1" ]; then
  run "typecheck (frontend)" bun run --filter vision-frontend typecheck
  run "typecheck (backend)" bun run --filter financial-transaction-manager-node typecheck
  # noImplicitAny ratchet over src/ with an explicit existing-debt baseline.
  run "typecheck (backend ratchet)" sh -c 'cd apps/node-backend && bun scripts/checkjs-ratchet.js'
fi

run "lint (frontend)" bun run lint
run "lint (backend)" bun run lint:backend
run "endpoint matrix" node scripts/check-endpoint-matrix.js
run "validate locales" node scripts/validate-locales.js
run "legacy inventory" bun run check-legacy-inventory
run "test-only exports" bun run check-test-only-exports
run "package boundaries" bun run check:package-boundaries
run "workflow supply chain" bun run check:workflow-supply-chain
run "TODO ledger" bun run todo:check
run "destructive migration policy" bun run db:check-destructive
if [ "${SKIP_TESTS:-}" != "1" ]; then
  build_tmp_base=${TMPDIR:-/tmp}
  build_tmp_base=${build_tmp_base%/}
  build_dir=$(mktemp -d "$build_tmp_base/vision-pre-push-build.XXXXXX") || exit 1
  cleanup_build() {
    case "$build_dir" in
      "$build_tmp_base"/vision-pre-push-build.*) rm -rf -- "$build_dir" ;;
    esac
  }
  trap cleanup_build EXIT
  run "repository script tests" bun run test:scripts
  run "frontend tests with coverage" bun run --filter vision-frontend test:coverage \
    --coverage.reportsDirectory "$build_dir/frontend-coverage"
  echo "[pre-push] > frontend production build..."
  build_ok=0
  if env CI=1 bun run --filter vision-frontend build --outDir "$build_dir"; then
    echo "[pre-push]   OK: frontend production build"
    build_ok=1
    run "frontend bundle size" env VISION_DIST_DIR="$build_dir" bun run --filter vision-frontend size:check
  else
    echo "[pre-push]   FAIL: frontend production build"
    fail=1
  fi
  run "Electron and native-runtime tests" bun run test:electron
  if [ "${SKIP_DB_TESTS:-}" = "1" ]; then
    echo "[pre-push] INCOMPLETE: SKIP_DB_TESTS=1 omits database-backed and live API cases."
    run "backend tests without database" bun run test
  else
    # The wrappers must never run destructive setup against caller databases.
    run "backend tests with disposable PostgreSQL" env \
      -u DATABASE_URL -u TEST_DATABASE_URL -u DATABASE_URL_MIGRATIONS -u DATABASE_URL_ANALYSIS -u UPDATE_GOLDENS \
      VISION_TEST_DB_TASK=tests VISION_TEST_DB_CHECK_ONLY=0 \
      VISION_RUN_PERFORMANCE_PROBES=1 VISION_RUN_AUDIT_PERFORMANCE=1 \
      bun run test:db --coverage \
      --coverage.reportsDirectory "$build_dir/backend-coverage"
    for db_task in migration-fidelity legacy-retirements adr090-retirement adr088-contract statement-contract; do
      run "database lifecycle: $db_task" env \
        -u DATABASE_URL -u TEST_DATABASE_URL -u DATABASE_URL_MIGRATIONS -u DATABASE_URL_ANALYSIS \
        VISION_TEST_DB_TASK="$db_task" VISION_TEST_DB_CHECK_ONLY=0 \
        bun run test:db
    done
    if [ "$build_ok" = 1 ]; then
      run "live API contracts with disposable PostgreSQL" env \
        -u DATABASE_URL -u TEST_DATABASE_URL -u DATABASE_URL_MIGRATIONS -u DATABASE_URL_ANALYSIS \
        LIVE_API_BASE=http://127.0.0.1:3002 \
        VISION_CI_PORT=3002 \
        VISION_DIST_DIR="$build_dir" \
        VISION_NATIVE_COMMAND_DIR=apps/frontend \
        bash .github/scripts/with-native-stack.sh \
        bun run vitest run src/test/live-contracts/live-contracts.test.ts
    else
      echo "[pre-push]   SKIPPED: live API contracts require a successful frontend build."
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "[pre-push] FAIL: gate failed -- fix the issues above, or bypass with: git push --no-verify"
  echo "[pre-push]   (skip individual steps with SKIP_TESTS=1 / SKIP_TYPECHECK=1 / SKIP_DB_TESTS=1)"
  exit 1
fi
echo "[pre-push] OK: all checks passed."
exit 0
