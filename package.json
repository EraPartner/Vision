{
  "name": "vision",
  "private": true,
  "version": "0.1.0",
  "description": "Financial transaction management application",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/frontend",
    "apps/node-backend",
    "packages/*"
  ],
  "scripts": {
    "install:all": "bun install",
    "dev": "concurrently --names \"backend,frontend\" -c \"blue,green\" \"bun run --filter 'financial-transaction-manager-node' dev\" \"bun run --filter 'vision-frontend' dev\"",
    "build": "npm run generate-locales-if-not-ci && bun run --filter 'vision-frontend' build",
    "generate-locales": "node scripts/generate-locales.js",
    "sanitize-locales": "node scripts/generate-locales.js --sanitize-only",
    "sync-nl": "node scripts/sync-nl-with-en.js",
    "generate-locales-if-not-ci": "sh -c 'if [ -z \"$CI\" ]; then node scripts/generate-locales.js; else echo \"Skipping locales generation in CI\"; fi'",
    "validate-locales": "node scripts/validate-locales.js",
    "dist": "npm run build && cd packaging/electron && npm run dist",
    "build:dev": "bun run --filter 'vision-frontend' build:dev",
    "preview": "bun run --filter 'vision-frontend' preview",
    "lint": "bun run --filter 'vision-frontend' lint",
    "lint:backend": "bun run --filter 'financial-transaction-manager-node' lint",
    "backend": "bun run --filter 'financial-transaction-manager-node' start",
    "test": "bun run --filter 'financial-transaction-manager-node' test",
    "test:frontend": "bun run --filter 'vision-frontend' test",
    "test:all": "concurrently --names \"backend,frontend\" -c \"blue,green\" \"bun run --filter 'financial-transaction-manager-node' test\" \"bun run --filter 'vision-frontend' test\"",
    "test:coverage": "bun run --filter 'vision-frontend' test:coverage",
    "test:watch": "bun run --filter 'financial-transaction-manager-node' test:watch",
    "db:upgrade": "venv/bin/alembic -c config/alembic.ini upgrade head",
    "db:downgrade": "venv/bin/alembic -c config/alembic.ini downgrade -1",
    "db:current": "venv/bin/alembic -c config/alembic.ini current",
    "db:history": "venv/bin/alembic -c config/alembic.ini history",
    "db:stamp": "venv/bin/alembic -c config/alembic.ini stamp head",
    "db:revision": "venv/bin/alembic -c config/alembic.ini revision --autogenerate -m",
    "docker:dev": "npm run generate-locales-if-not-ci && docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:rebuild": "npm run generate-locales-if-not-ci && docker compose -f docker-compose.yml -f docker-compose.dev.yml down && docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:clean": "npm run generate-locales-if-not-ci && docker compose -f docker-compose.yml -f docker-compose.clean.yml up --build",
    "docker:clean:down": "docker compose -f docker-compose.yml -f docker-compose.clean.yml down",
    "docker:clean:reset": "npm run generate-locales-if-not-ci && docker compose -f docker-compose.yml -f docker-compose.clean.yml down -v && docker compose -f docker-compose.yml -f docker-compose.clean.yml up --build",
    "electron:dev": "npm run generate-locales-if-not-ci && VISION_COMPOSE_OVERRIDE=docker-compose.dev.yml packaging/electron/node_modules/.bin/electron packaging/electron/main.js",
    "electron:prod": "npm run generate-locales-if-not-ci && packaging/electron/node_modules/.bin/electron packaging/electron/main.js",
    "electron:clean": "npm run generate-locales-if-not-ci && VISION_COMPOSE_OVERRIDE=docker-compose.clean.yml packaging/electron/node_modules/.bin/electron packaging/electron/main.js",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f app",
    "update": "bun update",
    "generate:types": "openapi-typescript openapi.yaml -o apps/frontend/src/types/generated.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "openapi-typescript": "^7.13.0"
  },
  "overrides": {
    "rollup": ">=4.59.0",
    "vite": "8.0.8",
    "picomatch": "4.0.4",
    "path-to-regexp": "^8.2.0",
    "brace-expansion": "1.1.13",
    "flatted": "3.4.2",
    "lodash": "4.18.1"
  },
  "resolutions": {
    "rollup": "4.59.0",
    "vite": "8.0.8",
    "picomatch": "4.0.4",
    "path-to-regexp": "^8.2.0",
    "brace-expansion": "1.1.13",
    "flatted": "3.4.2",
    "lodash": "4.18.1"
  }
}
