{
  "name": "vision",
  "private": true,
  "version": "1.0.0",
  "description": "Financial transaction management application",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/frontend",
    "apps/node-backend"
  ],
  "scripts": {
    "install:all": "bun install",
    "dev": "concurrently --names \"backend,frontend\" -c \"blue,green\" \"bun run --filter 'financial-transaction-manager-node' dev\" \"bun run --filter 'vision-frontend' dev\"",
    "build": "bun run --filter 'vision-frontend' build",
    "build:dev": "bun run --filter 'vision-frontend' build:dev",
    "preview": "bun run --filter 'vision-frontend' preview",
    "lint": "bun run --filter 'vision-frontend' lint",
    "backend": "bun run --filter 'financial-transaction-manager-node' start",
    "test": "bun run --filter 'financial-transaction-manager-node' test",
    "test:watch": "bun run --filter 'financial-transaction-manager-node' test:watch",
    "db:setup": "bash scripts/db/setup_postgres.sh",
    "db:upgrade": "venv/bin/alembic -c config/alembic.ini upgrade head",
    "db:downgrade": "venv/bin/alembic -c config/alembic.ini downgrade -1",
    "db:current": "venv/bin/alembic -c config/alembic.ini current",
    "db:history": "venv/bin/alembic -c config/alembic.ini history",
    "db:stamp": "venv/bin/alembic -c config/alembic.ini stamp head",
    "db:revision": "venv/bin/alembic -c config/alembic.ini revision --autogenerate -m",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:rebuild": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "update": "bun update"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "rollup": ">=4.59.0"
  },
  "resolutions": {
    "rollup": "4.59.0"
  }
}