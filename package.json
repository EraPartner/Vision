{
  "name": "vision",
  "private": true,
  "version": "1.0.2",
  "description": "Financial transaction management application",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/frontend",
    "apps/node-backend",
    "packages/*"
  ],
  "scripts": {
    "install:all": "bun install",
    "prepare": "bun scripts/setup-git-hooks.ts && sh -c 'if [ -n \"$CI\" ]; then echo \"[prepare] CI -- skipping packaging/electron install (workflows install it explicitly).\"; elif [ ! -d packaging/electron ]; then echo \"[prepare] no packaging/electron directory -- skipping (container build context or partial checkout).\"; elif command -v bun >/dev/null 2>&1; then echo \"[prepare] installing packaging/electron deps (needed by the backend backup tests)...\"; bun install --frozen-lockfile --cwd packaging/electron; else echo \"[prepare] bun not found -- skipping. Backend backup tests will fail until you run: bun install --cwd packaging/electron\"; fi'",
    "hooks:setup": "bun scripts/setup-git-hooks.ts",
    "install:electron": "bun install --frozen-lockfile --cwd packaging/electron",
    "dev": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-development.js",
    "build": "bun run --filter 'vision-frontend' build",
    "generate-locales": "bun scripts/generate-locales.ts",
    "sanitize-locales": "bun scripts/generate-locales.ts --sanitize-only",
    "sync-nl": "bun scripts/sync-nl-with-en.ts",
    "generate-locales-if-not-ci": "sh -c 'if [ -z \"$CI\" ]; then bun scripts/generate-locales.ts; else echo \"Skipping locales generation in CI\"; fi'",
    "validate-locales": "bun scripts/validate-locales.ts",
    "dist": "npm run build && cd packaging/electron && npm run dist",
    "build:dev": "bun run --filter 'vision-frontend' build:dev",
    "preview": "bun run --filter 'vision-frontend' preview",
    "lint": "bun run --filter 'vision-frontend' lint",
    "lint:backend": "bun run --filter 'financial-transaction-manager-node' lint",
    "typecheck": "bun run --filter 'vision-frontend' typecheck",
    "typecheck:backend": "bun run --filter 'financial-transaction-manager-node' typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck:electron": "tsc -p packaging/electron/tsconfig.json --noEmit && tsc -p packaging/electron/tsconfig.preload.json --noEmit",
    "typecheck:packages": "tsc -p packages/types/tsconfig.json && tsc -p packages/shared-utils/tsconfig.json",
    "typecheck:python": "python3 -m mypy --config-file config/mypy.ini",
    "backend": "bun run --filter 'financial-transaction-manager-node' start",
    "test": "bun run --filter 'financial-transaction-manager-node' test",
    "test:frontend": "bash scripts/run-frontend-tests.sh",
    "test:electron": "bun packaging/electron/build.ts && node --test 'packaging/electron/out/**/*.test.js'",
    "test:scripts": "bun test scripts/tests",
    "test:all": "concurrently --names \"backend,frontend\" -c \"blue,green\" \"bun run --filter 'financial-transaction-manager-node' test\" \"bun run test:frontend\"",
    "test:coverage": "bun run --filter 'vision-frontend' test:coverage",
    "test:watch": "VISION_RUN_PERFORMANCE_PROBES=${VISION_RUN_PERFORMANCE_PROBES:-1} VISION_RUN_AUDIT_PERFORMANCE=${VISION_RUN_AUDIT_PERFORMANCE:-1} VISION_TEST_DB_WATCH=1 scripts/with-test-db.sh",
    "test:db": "scripts/with-test-db.sh",
    "db:migrate": "bun run apps/node-backend/scripts/db-migrate.ts",
    "db:upgrade": "bun run apps/node-backend/scripts/db-migrate.ts upgrade",
    "db:downgrade": "bun run apps/node-backend/scripts/db-migrate.ts downgrade",
    "db:current": "bun apps/node-backend/scripts/alembic-command.ts current",
    "db:history": "bun apps/node-backend/scripts/alembic-command.ts history",
    "db:stamp": "bun run apps/node-backend/scripts/db-migrate.ts stamp",
    "db:revision": "bun apps/node-backend/scripts/alembic-command.ts revision --autogenerate -m",
    "db:index-stats": "bun run apps/node-backend/scripts/index-stats.ts",
    "db:legacy-status": "bun run apps/node-backend/scripts/legacy-retirement-status.ts",
    "db:check-destructive": "python3 scripts/check-destructive-migrations.py",
    "db:check-heads": "python3 scripts/check-alembic-heads.py",
    "db:check": "bun run db:check-heads && VISION_TEST_DB_TASK=migration-fidelity scripts/with-test-db.sh",
    "db:backup-before-baseline": "bun scripts/backup-before-baseline-upgrade.ts",
    "db:bridge-baseline": "bun scripts/bridge-squashed-baseline.ts",
    "db:convert-legacy-baseline": "bun scripts/convert-legacy-baseline.ts",
    "db:rollback-legacy-baseline": "bun scripts/rollback-legacy-baseline.ts",
    "quotes:densify": "bun run apps/node-backend/scripts/densify-asset-history.ts",
    "calibrate:category-outliers": "bun scripts/category-outlier-calibration.ts",
    "evaluate:local-ai": "bun apps/node-backend/scripts/evaluate-local-ai.ts",
    "evaluate:cloud-privacy": "bun apps/node-backend/scripts/evaluate-cloud-privacy.ts",
    "evaluate:cloud-seatbelt-smoke": "bun apps/node-backend/scripts/smoke-openai-seatbelt.ts",
    "evaluate:codex-seatbelt-smoke": "bun apps/node-backend/scripts/smoke-codex-seatbelt.ts",
    "evaluate:codex-subscription": "bun apps/node-backend/scripts/evaluate-codex-subscription.ts",
    "electron:dev": "npm run generate-locales-if-not-ci && bun packaging/electron/build.ts && VISION_RUNTIME_MODE=native VISION_DEVELOPMENT_PROFILE=true packaging/electron/node_modules/.bin/electron packaging/electron",
    "electron:prod": "npm run generate-locales-if-not-ci && bun packaging/electron/build.ts && packaging/electron/node_modules/.bin/electron packaging/electron",
    "native:prepare": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/prepare-development-runtime.js",
    "native:smoke": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-smoke.js",
    "native:db-smoke": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-db-smoke.js",
    "native:isolated-smoke": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-isolated-smoke.js",
    "native:generate": "bun run native:generate-api && bun run native:generate-tokens && bun run native:generate-strings && bun run native:generate-navigation",
    "native:generate-api": "bun scripts/native-openapi.ts",
    "native:generate-tokens": "bun scripts/native-design-tokens.ts",
    "native:generate-strings": "bun scripts/native-strings.ts",
    "native:generate-navigation": "bun scripts/native-navigation.ts",
    "demo:reset-native": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-demo-cli.js reset --execute",
    "demo:reset-vision-native": "bun packaging/electron/build.ts && node packaging/electron/out/scripts/native-demo-cli.js reset --execute --target vision-native-demo",
    "update": "bun update",
    "version:bump": "bun scripts/version-bump.ts",
    "generate:types": "openapi-typescript openapi.yaml -o apps/frontend/src/types/generated.ts",
    "check-endpoint-matrix": "bun scripts/check-endpoint-matrix.ts",
    "check-legacy-inventory": "bun scripts/check-legacy-inventory.ts",
    "check-test-only-exports": "bun scripts/check-test-only-exports.ts",
    "check:package-boundaries": "bun scripts/check-package-boundaries.ts",
    "check:workflow-supply-chain": "python3 scripts/check-workflow-supply-chain.py && python3 scripts/tests/workflow-supply-chain.test.py",
    "todo:list": "python3 scripts/todo-report.py",
    "todo:check": "python3 scripts/todo-report.py --check",
    "check-todo-stamps": "python3 scripts/check-todo-stamps.py",
    "check": "bun run lint && bun run lint:backend && bun run typecheck && bun run typecheck:backend && bun run typecheck:packages && bun run typecheck:scripts && bun run typecheck:electron && bun run typecheck:python && bun run validate-locales && bun run check-endpoint-matrix && bun run check-legacy-inventory && bun run check-test-only-exports && bun run check:package-boundaries && bun run check:workflow-supply-chain && bun run todo:check && bun run db:check-destructive && bun run test:scripts && bun run test && bun run test:frontend && bun run test:electron"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "vite": "8.0.16",
    "picomatch": "4.0.4",
    "path-to-regexp": "^8.2.0",
    "minimatch": "^9.0.0",
    "flatted": "3.4.2",
    "ip-address": "^10.4.0",
    "qs": ">=6.15.2",
    "ws": ">=8.21.0",
    "typescript": "^6.0.3",
    "brace-expansion": "^2.1.5",
    "nanoid": "^3.3.17",
    "js-yaml": "^4.3.2",
    "shell-quote": "^1.11.0",
    "undici": "^7.29.1",
    "fast-uri": "^3.1.6",
    "browserslist": "^4.28.7",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  },
  "resolutions": {
    "vite": "8.0.16",
    "picomatch": "4.0.4",
    "path-to-regexp": "^8.2.0",
    "minimatch": "^9.0.0",
    "flatted": "3.4.2",
    "ip-address": "^10.4.0",
    "qs": ">=6.15.2",
    "ws": ">=8.21.0",
    "typescript": "^6.0.3",
    "brace-expansion": "^2.1.5",
    "nanoid": "^3.3.17",
    "js-yaml": "^4.3.2",
    "shell-quote": "^1.11.0",
    "undici": "^7.29.1",
    "fast-uri": "^3.1.6",
    "browserslist": "^4.28.7",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  }
}
